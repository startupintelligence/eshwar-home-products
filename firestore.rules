rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isClientEditor() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'products-contact';
    }

    function validProductData(productId, expectedStatus) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'name', 'categoryId', 'description', 'available', 'status', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'categoryId', 'description', 'available', 'status', 'updatedAt',
          'price', 'imagePath'
        ])
        && data.id == productId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.categoryId in ['grains', 'oils', 'pantry']
        && data.description is string
        && data.description.size() <= 500
        && data.available is bool
        && data.status == expectedStatus
        && data.updatedAt == request.time
        && (!data.keys().hasAny(['price'])
          || (data.price is number && data.price >= 0 && data.price <= 10000000))
        && (!data.keys().hasAny(['imagePath'])
          || (data.imagePath is string && data.imagePath.size() <= 500));
    }

    function validChangeHistoryEntry() {
      return request.resource.data.keys().hasAll(['actorUid', 'action', 'entityType', 'entityId', 'summary', 'createdAt'])
        && request.resource.data.keys().hasOnly(['actorUid', 'action', 'entityType', 'entityId', 'summary', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in ['create', 'update', 'delete', 'publish', 'settings_update']
        && request.resource.data.entityType in ['product', 'site_settings']
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 280
        && request.resource.data.createdAt == request.time;
    }

    match /admin_users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isClientEditor();
      allow create, update: if isClientEditor() && validProductData(productId, 'published');
      allow delete: if isClientEditor();
    }
    match /product_drafts/{draftId} {
      allow read: if isClientEditor();
      allow create, update: if isClientEditor() && validProductData(draftId, 'draft');
      allow delete: if isClientEditor();
    }
    match /categories/{categoryId} {
      allow read: if resource.data.published == true || isClientEditor();
      allow create, update, delete: if isClientEditor();
    }
    match /site_settings/{documentId} {
      allow read: if documentId == 'public' || isClientEditor();
      allow create, update, delete: if isClientEditor();
    }
    match /site_settings_drafts/{documentId} {
      allow read, create, update, delete: if isClientEditor();
    }
    match /change_history/{changeId} {
      allow read: if isClientEditor();
      allow create: if isClientEditor() && validChangeHistoryEntry();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
