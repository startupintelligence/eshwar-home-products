---
import { siteConfig } from "../app/config/site";

const emailComposeUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(siteConfig.email)}`;
---

<div class="contact-fab" data-contact-fab data-phone={siteConfig.phoneDisplay}>
  <div class="contact-fab-menu" id="contact-fab-menu" hidden>
    <a class="contact-fab-option" href={emailComposeUrl} target="_blank" rel="noopener noreferrer" aria-label="Compose an email to Eshwar Home Products">
      <span>Email</span>
    </a>
    <a class="contact-fab-option" href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Eshwar Home Products">
      <span>WhatsApp</span>
    </a>
    <a class="contact-fab-option contact-fab-call" href={`tel:${siteConfig.phoneLink}`} aria-label={`Call Eshwar Home Products at ${siteConfig.phoneDisplay}`}>
      <span>Call Store</span>
      <small>{siteConfig.phoneDisplay}</small>
    </a>
    <button class="contact-fab-option contact-fab-copy" type="button" data-copy-phone>
      <span>Copy phone number</span>
    </button>
    <p class="contact-fab-status" data-contact-status role="status" aria-live="polite"></p>
  </div>
  <button class="contact-fab-toggle" type="button" aria-label="Open contact options" aria-expanded="false" aria-controls="contact-fab-menu" data-contact-toggle>
    Contact
  </button>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-contact-fab]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const toggle = root.querySelector('[data-contact-toggle]');
    const menu = root.querySelector('#contact-fab-menu');
    const copyPhone = root.querySelector('[data-copy-phone]');
    const status = root.querySelector('[data-contact-status]');
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    const setOpen = (open) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close contact options' : 'Open contact options');
      root.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !root.contains(event.target)) setOpen(false);
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    copyPhone?.addEventListener('click', async () => {
      const phone = root.dataset.phone || '';
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(phone);
        } else {
          const field = document.createElement('textarea');
          field.value = phone;
          field.setAttribute('readonly', '');
          field.style.position = 'fixed';
          field.style.opacity = '0';
          document.body.appendChild(field);
          field.select();
          const copied = document.execCommand('copy');
          field.remove();
          if (!copied) throw new Error('Copy unavailable');
        }
        if (status) status.textContent = 'Phone number copied.';
      } catch {
        if (status) status.textContent = 'Please copy the number shown under Call Store.';
      }
    });
    const footer = document.querySelector('.site-footer');
    if ('IntersectionObserver' in window && footer) {
      const observer = new IntersectionObserver(([entry]) => {
        if (!entry) return;
        const overlapsFabArea = entry.isIntersecting && entry.boundingClientRect.top < window.innerHeight - 72;
        if (overlapsFabArea) setOpen(false);
        root.hidden = overlapsFabArea;
      }, { threshold: 0 });
      observer.observe(footer);
    }
  })();
</script>

<style is:global>
  .contact-fab { position:fixed; right:max(22px,env(safe-area-inset-right,0px)); bottom:max(22px,env(safe-area-inset-bottom,0px)); z-index:90; display:grid; justify-items:end; gap:12px; pointer-events:none; }
  .contact-fab > * { pointer-events:auto; }
  .contact-fab-toggle { display:inline-grid; width:64px; height:64px; place-items:center; padding:0; border:1.5px solid rgba(226,183,91,.8); border-radius:50%; background:var(--accent-green,#183828); color:#fff; font:700 .82rem/1 var(--sans,"Plus Jakarta Sans",sans-serif); cursor:pointer; box-shadow:0 10px 26px rgba(23,29,24,.24); transition:transform 180ms ease,background-color 180ms ease,box-shadow 180ms ease; }
  .contact-fab-toggle:hover { transform:translateY(-2px); background:var(--accent-green-hover,#24513B); box-shadow:0 14px 30px rgba(23,29,24,.3); }
  .contact-fab-toggle:focus-visible,.contact-fab-option:focus-visible { outline:3px solid var(--accent-gold,#E2B75B); outline-offset:3px; }
  .contact-fab-menu { display:grid; min-width:196px; gap:7px; padding:9px; border:1px solid var(--border-light,#DED8CC); border-radius:12px; background:var(--bg-card,#FAF9F6); box-shadow:0 12px 30px rgba(23,29,24,.18); }
  .contact-fab-menu[hidden] { display:none; }
  .contact-fab-option { display:flex; width:100%; min-height:44px; align-items:center; justify-content:space-between; gap:12px; padding:9px 13px; border:1px solid transparent; border-radius:8px; background:transparent; color:var(--text-main,#171D18); font:600 .86rem/1.3 var(--sans,"Plus Jakarta Sans",sans-serif); text-align:left; text-decoration:none; cursor:pointer; transition:background-color 150ms ease,border-color 150ms ease,color 150ms ease; }
  .contact-fab-option small { color:var(--text-muted,#68665F); font-size:.72rem; white-space:nowrap; }
  .contact-fab-option:hover { border-color:var(--border-light,#DED8CC); background:var(--bg-subtle,#F2F0EA); color:var(--accent-green,#183828); }
  .contact-fab-status { min-height:1em; margin:0; padding:0 4px; color:var(--accent-green,#183828); font-size:.72rem; }
  @media(max-width:768px) { .contact-fab { right:max(16px,env(safe-area-inset-right,0px)); bottom:calc(86px + env(safe-area-inset-bottom,0px)); } .contact-fab-toggle { width:58px; height:58px; } .contact-fab-menu { min-width:188px; } }
  @media(prefers-reduced-motion:reduce) { .contact-fab-toggle,.contact-fab-option { transition:none; } }
  @media print { .contact-fab { display:none !important; } }
</style>
