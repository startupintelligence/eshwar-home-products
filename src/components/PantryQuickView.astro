---
const productsUrl = `${import.meta.env.BASE_URL}products/`;
---
<dialog class="pantry-quickview" id="pantry-quickview" aria-labelledby="pantry-quickview-title" aria-describedby="pantry-quickview-description">
  <div class="pantry-quickview-heading">
    <p class="eyebrow">Eshwar Home Products · Perambur</p>
    <button class="pantry-quickview-close" type="button" aria-label="Close product details" autofocus>×</button>
  </div>
  <h2 id="pantry-quickview-title"></h2>
  <p id="pantry-quickview-description" class="pantry-quickview-description"></p>
  <ul id="pantry-quickview-items" class="pantry-quickview-items" aria-label="Items in this shelf"></ul>
  <div class="pantry-quickview-store-note">
    <p><strong>Store hours</strong><br />Mon–Sat: 9:00 AM – 9:00 PM · Sun: Closed</p>
    <p><strong>Visit us</strong><br />119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011</p>
  </div>
  <div class="pantry-quickview-actions">
    <a class="pantry-quickview-whatsapp" id="pantry-quickview-whatsapp" href="https://wa.me/919941209953" target="_blank" rel="noopener noreferrer">Ask on WhatsApp ↗</a>
    <a class="pantry-quickview-products" href={productsUrl}>View Full Pantry →</a>
  </div>
</dialog>
<script is:inline>
  (() => {
    const dialog = document.getElementById('pantry-quickview');
    if (!(dialog instanceof HTMLDialogElement) || typeof dialog.showModal !== 'function') return;
    const title = document.getElementById('pantry-quickview-title');
    const description = document.getElementById('pantry-quickview-description');
    const itemsList = document.getElementById('pantry-quickview-items');
    const whatsapp = document.getElementById('pantry-quickview-whatsapp');
    const closeButton = dialog.querySelector('.pantry-quickview-close');
    document.addEventListener('click', (event) => {
      const trigger = event.target instanceof Element ? event.target.closest('[data-quickview-trigger]') : null;
      if (!(trigger instanceof HTMLButtonElement)) return;
      title.textContent = trigger.dataset.quickviewTitle || 'Pantry details';
      description.textContent = trigger.dataset.quickviewDescription || 'Ask the store about current varieties and availability.';
      let items = [];
      try { items = JSON.parse(trigger.dataset.quickviewItems || '[]'); } catch { items = []; }
      itemsList.replaceChildren(...items.map((item) => {
        const listItem = document.createElement('li');
        listItem.textContent = item;
        return listItem;
      }));
      const message = `Hello Eshwar Home Products, please help me check today's availability for ${title.textContent}.`;
      whatsapp.href = `https://wa.me/919941209953?text=${encodeURIComponent(message)}`;
      if (!dialog.open) dialog.showModal();
    });
    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();
</script>
