---
import { storeConfig } from "../data/store";

interface Props {
  current?: "home" | "about" | "products" | "contact" | "blog" | "kitchen-guides";
}

const { current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class={`site-header ehp-site-header${current === "contact" ? " is-contact-page" : ""}`} data-base-url={base}>
  <div class="container header-inner">
    <a class="wordmark" href={base} aria-label={`${storeConfig.name} home`}>
      <img
        class="wordmark-logo"
        src={base + "images/brand/eshwar-home-products-logo-96.webp"}
        alt=""
        width="36"
        height="36"
        decoding="async"
      />
      <span class="wordmark-name">{storeConfig.name}</span>
    </a>

    <nav class="main-nav" id="primary-navigation" aria-label="Main navigation">
      <div class="mobile-nav-header">
        <span class="mobile-nav-title">Navigation</span>
        <button class="mobile-nav-close" type="button" aria-label="Close navigation menu">
          <span>Close</span>
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <a href={base} aria-current={current === "home" ? "page" : undefined}>Home</a>
      <a href={base + "products/"} aria-current={current === "products" ? "page" : undefined}>The Pantry</a>
      <a href={base + "about/"} aria-current={current === "about" ? "page" : undefined}>Our Story</a>
      <a href={base + "kitchen-guides/"} aria-current={current === "blog" || current === "kitchen-guides" ? "page" : undefined}>Kitchen Guides</a>
      <a href={base + "contact/"} aria-current={current === "contact" ? "page" : undefined}>Visit Us</a>
      <div class="mobile-nav-actions" aria-label="Quick store actions">
        <a class="mobile-nav-action-primary" href={storeConfig.mapsUrl} target="_blank" rel="noopener noreferrer">
          <span>Visit Store &amp; Directions</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="mobile-nav-contact" href={storeConfig.whatsappUrl} data-ehp-dialog="enquiry" aria-haspopup="dialog">
          <span>WhatsApp Enquiry</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a class="mobile-nav-action-secondary" href={storeConfig.phoneHref}>
          <span>Call Store · {storeConfig.phoneDisplay}</span>
        </a>
      </div>
    </nav>
    <div class="mobile-nav-backdrop" id="mobile-nav-backdrop" aria-hidden="true"></div>

    <form
      id="header-search-form"
      class="header-search"
      role="search"
      aria-label="Search product range"
      data-ehp-header-search
    >
      <label class="sr-only" for="ehp-header-search-input">Search products</label>
      <input
        id="ehp-header-search-input"
        class="header-search-input"
        type="search"
        name="q"
        placeholder="Search pantry..."
        autocomplete="off"
      />
      <button class="header-search-btn" type="submit" aria-label="Search products">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="9" r="6" />
          <path d="m14 14 4 4" />
        </svg>
      </button>
    </form>

    <div class="header-actions">
      <button
        class="mobile-search-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="header-search-form"
        aria-label="Open product search"
      >
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="9" r="6" />
          <path d="m14 14 4 4" />
        </svg>
      </button>
      <a class="header-contact" href={storeConfig.whatsappUrl} data-ehp-dialog="enquiry" aria-haspopup="dialog">WhatsApp Enquiry ↗</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation menu">
        <span class="menu-toggle-lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".ehp-site-header");
  const baseUrl = header?.dataset.baseUrl || "/";
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#primary-navigation");
  const navClose = document.querySelector<HTMLButtonElement>(".mobile-nav-close");
  const navBackdrop = document.querySelector<HTMLElement>("#mobile-nav-backdrop");
  const searchForm = document.querySelector<HTMLFormElement>("[data-ehp-header-search]");
  const searchInput = document.querySelector<HTMLInputElement>("#ehp-header-search-input");
  const mobileSearchToggle = document.querySelector<HTMLButtonElement>(".mobile-search-toggle");

  const getHeaderOffset = () => (header ? header.getBoundingClientRect().height + 12 : 84);

  const smoothScrollToY = (targetY: number, onComplete?: () => void) => {
    const clampedTarget = Math.max(0, Math.round(targetY));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion) {
      window.scrollTo(0, clampedTarget);
      onComplete?.();
      return;
    }

    const startY = window.scrollY;
    const distance = clampedTarget - startY;
    if (Math.abs(distance) < 2) {
      onComplete?.();
      return;
    }

    const duration = Math.min(680, Math.max(320, Math.abs(distance) * 0.45));
    let startTime: number | null = null;
    const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const step = (now: number) => {
      if (startTime === null) startTime = now;
      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / duration);
      window.scrollTo(0, startY + distance * easeInOutCubic(progress));
      if (progress < 1) {
        window.requestAnimationFrame(step);
      } else {
        onComplete?.();
      }
    };

    window.requestAnimationFrame(step);
  };

  const scrollToSection = (target: HTMLElement, focusTarget = true) => {
    const targetTop = target.getBoundingClientRect().top + window.scrollY - getHeaderOffset();
    smoothScrollToY(targetTop, () => {
      if (!focusTarget) return;
      if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: true });
    });
  };

  const normalizePath = (pathname: string) => (pathname.endsWith("/") ? pathname : `${pathname}/`);

  const setMobileSearchOpen = (open: boolean, returnFocus = false) => {
    if (!searchForm || !mobileSearchToggle) return;
    searchForm.classList.toggle("is-mobile-open", open);
    mobileSearchToggle.setAttribute("aria-expanded", String(open));
    mobileSearchToggle.setAttribute("aria-label", open ? "Close product search" : "Open product search");
    if (open) {
      window.requestAnimationFrame(() => searchInput?.focus({ preventScroll: true }));
    } else if (returnFocus) {
      mobileSearchToggle.focus({ preventScroll: true });
    }
  };

  if (mobileSearchToggle && searchForm) {
    mobileSearchToggle.addEventListener("click", () => {
      const expanded = mobileSearchToggle.getAttribute("aria-expanded") === "true";
      setMobileSearchOpen(!expanded);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileSearchToggle.getAttribute("aria-expanded") === "true") {
        setMobileSearchOpen(false, true);
      }
    });
  }

  let inertBackground: Array<{ element: HTMLElement; wasInert: boolean }> = [];

  const setBackgroundInert = (inert: boolean) => {
    if (inert) {
      const pageSiblings = Array.from(document.body.children).filter(
        (element): element is HTMLElement => element instanceof HTMLElement && element !== header
      );
      const headerSiblings = Array.from(navigation?.parentElement?.children ?? []).filter(
        (element): element is HTMLElement =>
          element instanceof HTMLElement && element !== navigation && element !== navBackdrop
      );
      inertBackground = Array.from(new Set([...pageSiblings, ...headerSiblings])).map((element) => ({
        element,
        wasInert: element.inert,
      }));
      inertBackground.forEach(({ element }) => { element.inert = true; });
      return;
    }
    inertBackground.forEach(({ element, wasInert }) => { element.inert = wasInert; });
    inertBackground = [];
  };

  const getNavigationFocusables = () =>
    Array.from(navigation?.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
    ) ?? []).filter((element) => element.getClientRects().length > 0);

  const openNavigation = () => {
    if (!toggle || !navigation) return;
    setMobileSearchOpen(false);
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Close navigation menu");
    navigation.classList.add("is-open");
    navBackdrop?.classList.add("is-open");
    setBackgroundInert(true);
    document.body.style.overflow = "hidden";
    window.requestAnimationFrame(() => navClose?.focus({ preventScroll: true }));
  };

  const closeNavigation = () => {
    if (!toggle || !navigation) return;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open navigation menu");
    navigation.classList.remove("is-open");
    navBackdrop?.classList.remove("is-open");
    setBackgroundInert(false);
    document.body.style.overflow = "";
  };

  if (toggle && navigation) {
    const mobileNavigationQuery = window.matchMedia("(max-width: 768px)");
    mobileNavigationQuery.addEventListener("change", (event) => {
      if (!event.matches && toggle.getAttribute("aria-expanded") === "true") {
        closeNavigation();
        navigation.querySelector<HTMLElement>("a[href]")?.focus({ preventScroll: true });
      }
    });

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      if (expanded) {
        closeNavigation();
      } else {
        openNavigation();
      }
    });

    navClose?.addEventListener("click", () => {
      closeNavigation();
      toggle.focus();
    });

    navBackdrop?.addEventListener("click", () => {
      closeNavigation();
      toggle.focus();
    });

    navigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("auxclick", (event) => {
        if (event.button === 1) {
          closeNavigation();
          toggle.focus();
        }
      });
    });

    document.addEventListener("keydown", (event) => {
      if (toggle.getAttribute("aria-expanded") !== "true") return;
      if (event.key === "Escape") {
        closeNavigation();
        toggle.focus();
        return;
      }
      if (event.key !== "Tab") return;
      const focusables = getNavigationFocusables();
      const first = focusables[0] ?? navClose;
      const last = focusables[focusables.length - 1] ?? navClose;
      if (!first || !last) return;
      if (!navigation.contains(document.activeElement)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      } else if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }

  header?.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
    link.addEventListener("click", (event) => {
      const keepsCurrentPageOpen = link.target === "_blank" || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
      const isDialogTrigger = link.hasAttribute("data-ehp-dialog");
      const wasOpen = toggle?.getAttribute("aria-expanded") === "true";

      closeNavigation();
      if (keepsCurrentPageOpen || isDialogTrigger) {
        if (wasOpen) toggle?.focus();
        return;
      }

      let url: URL;
      try {
        url = new URL(link.href, window.location.href);
      } catch {
        return;
      }

      if (url.origin !== window.location.origin) return;
      if (normalizePath(url.pathname) !== normalizePath(window.location.pathname)) return;

      if (url.hash) {
        const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (target) {
          event.preventDefault();
          history.pushState(null, "", url.hash);
          scrollToSection(target);
        }
        return;
      }

      event.preventDefault();
      if (window.location.hash) {
        history.pushState(null, "", url.pathname + url.search);
      }
      smoothScrollToY(0);
    });
  });

  if (searchForm && searchInput) {
    const initialQuery = new URLSearchParams(window.location.search).get("q") ?? "";
    if (initialQuery) {
      searchInput.value = initialQuery;
      setMobileSearchOpen(true);
    }

    const broadcastSearch = (query: string) => {
      window.dispatchEvent(new CustomEvent("ehp:product-search", { detail: { query } }));
    };

    searchInput.addEventListener("input", () => {
      broadcastSearch(searchInput.value);
    });

    searchForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = searchInput.value.trim();
      const productRangeTarget = document.getElementById("products") || document.getElementById("pantry-shelves");
      if (productRangeTarget) {
        broadcastSearch(searchInput.value);
        scrollToSection(productRangeTarget, false);
        return;
      }
      const nextUrl = query
        ? `${baseUrl}products/?q=${encodeURIComponent(query)}#pantry-shelves`
        : `${baseUrl}products/`;
      window.location.assign(nextUrl);
    });

    window.addEventListener("ehp:clear-product-search", () => {
      searchInput.value = "";
      broadcastSearch("");
      searchInput.focus();
    });
  }

  if (window.location.hash) {
    const initialTarget = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
    if (initialTarget) {
      window.requestAnimationFrame(() => scrollToSection(initialTarget));
    }
  }
</script>
