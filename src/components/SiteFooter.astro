---
import { siteConfig } from "../app/config/site";
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <div class="footer-brand-lockup">
        <span class="footer-logo-badge"><img class="footer-logo" src={base + "images/brand/eshwar-home-products-logo.png"} alt="Eshwar Home Products emblem" width="56" height="44" loading="lazy" decoding="async" /></span>
        <div class="footer-brand-copy">
          <a class="footer-name footer-name-copy" href={base}>Eshwar Home Products</a>
          <p class="footer-brand-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p>
        </div>
      </div>
      <p>Traditional rice, Siruthaniyam millets, cold-pressed oils &amp; pantry essentials in Perambur, Chennai.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href={base+"about/"}>Our story</a>
      <a href={base+"products/"}>The pantry</a>
      <a href={base+"contact/"}>Visit us</a>
      <a href={base+"perambur-millet-store/"}>Perambur guide</a>
      <a href={base+"kitchen-guides/"}>Kitchen guides</a>
    </nav>
    <div class="footer-contact">
      <span class="footer-contact-heading">Call or WhatsApp</span>
      <a class="footer-contact-link" href={`tel:${siteConfig.phoneLink}`}>{siteConfig.phoneDisplay}</a>
      <a class="footer-contact-link footer-whatsapp-link" href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp Enquiry ↗</a>
      <span class="footer-contact-heading">Email</span>
      <a class="footer-contact-link" href={`mailto:${siteConfig.email}`}>Send an email</a>
      <span class="footer-hours">{siteConfig.hoursDisplay}</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>{siteConfig.address}</span>
    <nav class="footer-socials" aria-label="Social media">
      <a class="footer-social-link" href={siteConfig.youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label="Visit Eshwar Home Products on YouTube" title="YouTube">
        <svg class="footer-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
        <span class="footer-social-label">YouTube</span>
      </a>
      <a class="footer-social-link" href={siteConfig.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Visit Eshwar Home Products on Instagram" title="Instagram">
        <svg class="footer-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2.1A2.9 2.9 0 0 0 4.1 7v10A2.9 2.9 0 0 0 7 19.9h10a2.9 2.9 0 0 0 2.9-2.9V7A2.9 2.9 0 0 0 17 4.1H7Zm5 3.1a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Zm0 2.1a2.7 2.7 0 1 0 0 5.4 2.7 2.7 0 0 0 0-5.4Zm5.1-3.2a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2Z"/></svg>
        <span class="footer-social-label">Instagram</span>
      </a>
      {siteConfig.facebookUrl ? (
        <a class="footer-social-link" href={siteConfig.facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Visit Eshwar Home Products on Facebook" title="Facebook">
          <svg class="footer-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.2h2.8V21h3.4Z"/></svg>
          <span class="footer-social-label">Facebook</span>
        </a>
      ) : (
        <span class="footer-social-link footer-social-unconfigured" aria-label="Facebook page not configured" title="Facebook page not configured" aria-disabled="true">
          <svg class="footer-social-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6h1.7V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.2h2.8V21h3.4Z"/></svg>
          <span class="footer-social-label">Facebook</span>
        </span>
      )}
    </nav>
    <span>© {new Date().getFullYear()} Eshwar Home Products</span>
  </div>
</footer>

<style>
  .footer-social-link {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: 6px;
    color: var(--accent-gold, #D9B66F);
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .footer-social-icon { display: block; width: 21px; height: 21px; flex: 0 0 auto; }
  .footer-social-label { font-size: 0.78rem; font-weight: 600; }
  .footer-social-link:hover { color: #FFFFFF; background: rgba(255,255,255,0.08); }
  .footer-social-link:focus-visible { outline: 2px solid var(--accent-gold, #D9B66F); outline-offset: 3px; }
  .footer-social-unconfigured { opacity: 0.48; cursor: not-allowed; }
  @media (prefers-reduced-motion: reduce) { .footer-social-link { transition: none; } }
</style>
