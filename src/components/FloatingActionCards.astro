---
const address = "119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India";
const mapsUrl = "https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu&g_ep=EgoyMDI2MTExNS4wIKXMDSoASAFQAw%3D%3D";
---
<dialog class="ehp-floating-card" id="ehp-product-dialog" aria-labelledby="ehp-product-title">
  <div class="ehp-dialog-top"><p class="eyebrow">The Pantry · Eshwar Home Products</p><button class="ehp-dialog-close" type="button" aria-label="Close">×</button></div>
  <p class="ehp-representative-meta">Representative category visual</p>
  <h2 id="ehp-product-title">Pantry details</h2>
  <p id="ehp-product-description">Ask the store about current varieties and availability.</p>
  <ul id="ehp-product-items" class="ehp-dialog-list"></ul>
  <p class="ehp-dialog-note">Varieties and pack sizes can change. Please confirm today's stock and available sizes with the store.</p>
  <a class="ehp-dialog-primary" id="ehp-product-whatsapp" href="https://wa.me/919941209953" target="_blank" rel="noopener noreferrer">Check availability on WhatsApp ↗</a>
</dialog>
<dialog class="ehp-floating-card" id="ehp-enquiry-dialog" aria-labelledby="ehp-enquiry-title">
  <div class="ehp-dialog-top"><p class="eyebrow">Quick Enquiry</p><button class="ehp-dialog-close" type="button" aria-label="Close">×</button></div>
  <h2 id="ehp-enquiry-title">What would you like to check?</h2><p>Select the pantry items you need. The store team can confirm current varieties and pack sizes.</p>
  <form id="ehp-enquiry-form">
    <fieldset class="ehp-enquiry-options"><legend class="visually-hidden">Choose pantry requirements</legend>
      <label><input type="checkbox" name="need" value="Rice"> Rice</label><label><input type="checkbox" name="need" value="Millets"> Millets</label>
      <label><input type="checkbox" name="need" value="Cold-Pressed Oil"> Cold-Pressed Oil</label><label><input type="checkbox" name="need" value="Ghee"> Ghee</label><label><input type="checkbox" name="need" value="Sathumaavu"> Sathumaavu</label><label><input type="checkbox" name="need" value="Other pantry item"> Other pantry item</label>
    </fieldset>
    <label class="ehp-quantity-label" for="ehp-enquiry-quantity">Quantity or pack size (optional)</label><input id="ehp-enquiry-quantity" name="quantity" type="text" maxlength="80" placeholder="e.g. 1 kg, 2 packs">
    <p id="ehp-enquiry-error" class="ehp-dialog-error" role="alert" hidden>Please select at least one item.</p><button class="ehp-dialog-primary" type="submit">Send List on WhatsApp ↗</button>
  </form>
</dialog>
<dialog class="ehp-floating-card" id="ehp-store-dialog" aria-labelledby="ehp-store-title">
  <div class="ehp-dialog-top"><p class="eyebrow">Visit Our Store · Perambur</p><button class="ehp-dialog-close" type="button" aria-label="Close">×</button></div>
  <h2 id="ehp-store-title">Eshwar Home Products</h2>
  <p class="ehp-store-status" id="ehp-store-status" aria-live="polite">Checking store hours…</p>
  <p class="ehp-store-hours">Monday–Saturday: 9:00 AM – 9:00 PM<br>Sunday: Closed · Chennai time (IST)</p>
  <address id="ehp-store-address">{address}</address>
  <div class="ehp-dialog-actions"><button class="ehp-dialog-secondary" id="ehp-copy-address" type="button">Copy Address</button><a class="ehp-dialog-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get Directions ↗</a><a class="ehp-dialog-secondary" href="tel:+919941209953">Call Store · +91 99412 09953</a></div>
  <p class="ehp-dialog-feedback" id="ehp-copy-feedback" role="status" aria-live="polite"></p>
</dialog>
<dialog class="ehp-floating-card" id="ehp-story-dialog" aria-labelledby="ehp-story-title">
  <div class="ehp-dialog-top"><p class="eyebrow">Our Story · Perambur, Chennai</p><button class="ehp-dialog-close" type="button" aria-label="Close">×</button></div>
  <h2 id="ehp-story-title">Rooted in devotion, serving everyday kitchens.</h2>
  <p>Eshwar Home Products is named with devotion after our family deity, Eshwaran (Lord Shiva). The Rudraksha and Trishul emblem reflects that connection and the values the store aims to uphold: honesty, gratitude and care.</p>
  <p>At the store in Chinnaiyan Colony, Perambur, the team brings together traditional rice, whole millets, millet flours, cold-pressed oils, ghee and other pantry essentials. The aim is to make familiar foods easier to find and help customers choose what suits their everyday kitchens.</p>
  <a class="ehp-dialog-primary" href={import.meta.env.BASE_URL + "about/"}>Read the full story ↗</a>
</dialog>
<dialog class="ehp-floating-card" id="ehp-guide-dialog" aria-labelledby="ehp-guide-title">
  <div class="ehp-dialog-top"><p class="eyebrow">Kitchen Guide · Practical Notes</p><button class="ehp-dialog-close" type="button" aria-label="Close">×</button></div>
  <h2 id="ehp-guide-title">Kitchen guide</h2><p id="ehp-guide-description"></p><ul id="ehp-guide-notes" class="ehp-dialog-list"></ul>
  <p class="ehp-dialog-note">Soaking and cooking times vary by grain, processing and recipe. Follow pack instructions or ask the store team; this guide does not assume a fixed time.</p>
  <a class="ehp-dialog-secondary" id="ehp-guide-reference" href="#" hidden>Open the original reference ↗</a>
  <button class="ehp-dialog-primary" id="ehp-guide-shop" type="button">Shop Ingredients for This Guide ↗</button>
</dialog>
<script is:inline>
(() => {
 const dialogs={product:document.getElementById('ehp-product-dialog'),enquiry:document.getElementById('ehp-enquiry-dialog'),store:document.getElementById('ehp-store-dialog'),story:document.getElementById('ehp-story-dialog'),guide:document.getElementById('ehp-guide-dialog')};
 const openDialog=(dialog)=>{if(dialog instanceof HTMLDialogElement&&typeof dialog.showModal==='function'&&!dialog.open)dialog.showModal();};
 const initialiseEnquiry=(items=[])=>{
  const form=document.getElementById('ehp-enquiry-form');if(!form)return;
  form.reset();
  const error=document.getElementById('ehp-enquiry-error');if(error)error.hidden=true;
  const requested=Array.isArray(items)?items.map((item)=>String(item).toLowerCase()):[];
  form.querySelectorAll('input[name="need"]').forEach((input)=>{input.checked=requested.some((item)=>item.includes(input.value.toLowerCase())||input.value.toLowerCase().includes(item));});
 };
 document.querySelectorAll('.ehp-dialog-close').forEach((button)=>button.addEventListener('click',()=>button.closest('dialog')?.close()));
 Object.values(dialogs).forEach((dialog)=>{
  if(!dialog)return;
  let pointerStart=null;
  const outside=(point,rect)=>point.x<rect.left||point.x>rect.right||point.y<rect.top||point.y>rect.bottom;
  dialog.addEventListener('pointerdown',(event)=>{pointerStart={x:event.clientX,y:event.clientY};});
  dialog.addEventListener('click',(event)=>{
   if(!pointerStart)return;
   const rect=dialog.getBoundingClientRect(),pointerEnd={x:event.clientX,y:event.clientY};
   if(outside(pointerStart,rect)&&outside(pointerEnd,rect))dialog.close();
   pointerStart=null;
  });
  dialog.addEventListener('pointercancel',()=>{pointerStart=null;});
 });
 document.addEventListener('click',(event)=>{
  const trigger=event.target instanceof Element?event.target.closest('[data-ehp-dialog], [data-quickview-trigger]'):null;if(!trigger)return;
  const kind=trigger.dataset.ehpDialog||(trigger.hasAttribute('data-quickview-trigger')?'product':'');if(!dialogs[kind])return;event.preventDefault();
  if(kind==='product'){
   const title=trigger.dataset.ehpTitle||trigger.dataset.quickviewTitle||'Pantry details';
   document.getElementById('ehp-product-title').textContent=title;
   document.getElementById('ehp-product-description').textContent=trigger.dataset.ehpDescription||trigger.dataset.quickviewDescription||'Ask the store about current varieties and availability.';
   let items=[];try{items=JSON.parse(trigger.dataset.ehpItems||trigger.dataset.quickviewItems||'[]');}catch{}
   document.getElementById('ehp-product-items').replaceChildren(...items.map((item)=>{const li=document.createElement('li');li.textContent=item;return li;}));
   document.getElementById('ehp-product-whatsapp').href='https://wa.me/919941209953?text='+encodeURIComponent('Hi, I want to check availability for '+title+'. Please share current varieties and pack sizes.');
  }
  if(kind==='store')updateStoreStatus();
  if(kind==='guide'){
   const title=trigger.dataset.ehpTitle||'Kitchen guide';document.getElementById('ehp-guide-title').textContent=title;
   document.getElementById('ehp-guide-description').textContent=trigger.dataset.ehpDescription||'';
   let notes=[];try{notes=JSON.parse(trigger.dataset.ehpItems||'[]');}catch{}
   document.getElementById('ehp-guide-notes').replaceChildren(...notes.map((item)=>{const li=document.createElement('li');li.textContent=item;return li;}));
   const reference=document.getElementById('ehp-guide-reference');
   reference.href=trigger.dataset.ehpHref||'#';reference.hidden=!trigger.dataset.ehpHref;
   reference.textContent=(trigger.dataset.ehpAction||'Open the original reference')+' ↗';
   const shop=document.getElementById('ehp-guide-shop');shop.dataset.ehpItems=JSON.stringify(notes);shop.dataset.ehpTitle=title;
  }
  if(kind==='enquiry'){
   let preset=[];try{preset=JSON.parse(trigger.dataset.ehpItems||'[]');}catch{}
   initialiseEnquiry(preset);
  }
  openDialog(dialogs[kind]);
 });
 document.getElementById('ehp-guide-shop')?.addEventListener('click',(event)=>{
  const button=event.currentTarget;let notes=[];try{notes=JSON.parse(button.dataset.ehpItems||'[]');}catch{}
  initialiseEnquiry(notes);
  dialogs.guide.close();openDialog(dialogs.enquiry);
 });
 document.getElementById('ehp-enquiry-form')?.addEventListener('submit',(event)=>{
  event.preventDefault();const selected=[...document.querySelectorAll('#ehp-enquiry-form input[name="need"]:checked')].map((input)=>input.value);
  const error=document.getElementById('ehp-enquiry-error');if(!selected.length){error.hidden=false;return;}error.hidden=true;
  const quantity=document.getElementById('ehp-enquiry-quantity').value.trim();
  const message='Hello Eshwar Home Products, please help me check availability for: '+selected.join(', ')+'.'+(quantity?' Quantity or pack size: '+quantity+'.':'')+' Please share today’s options.';
  window.location.href='https://wa.me/919941209953?text='+encodeURIComponent(message);
 });
 function updateStoreStatus(){
  const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Kolkata',weekday:'short',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date());
  const values=Object.fromEntries(parts.map((part)=>[part.type,part.value]));const hour=Number(values.hour);
  const open=values.weekday!=='Sun'&&hour>=9&&hour<21;
  const status=document.getElementById('ehp-store-status');status.textContent=(open?'Open now':'Closed now')+' · Chennai '+values.hour+':'+values.minute+' IST';status.dataset.open=String(open);
 }
 document.getElementById('ehp-copy-address')?.addEventListener('click',async()=>{
  const address=document.getElementById('ehp-store-address').textContent.trim(),feedback=document.getElementById('ehp-copy-feedback');
  try{await navigator.clipboard.writeText(address);feedback.textContent='Address copied.';}catch{feedback.textContent='Copy is not available in this browser. Please select the address text.';}
 });
})();
</script>
<style is:global>
.ehp-floating-card{width:min(480px,calc(100vw - 28px));max-width:480px;max-height:min(82vh,720px);max-height:min(82dvh,720px);overflow:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;margin:auto;padding:26px;border:1px solid var(--border-light);border-radius:12px;background:#FFFFFF;color:var(--text-main);box-shadow:0 20px 50px rgba(23,29,24,.18)}
.ehp-floating-card::backdrop{background:rgba(23,29,24,.52)}
.ehp-dialog-top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:12px}
.ehp-dialog-top .eyebrow{margin:0;color:var(--accent-green);font-size:.75rem;font-weight:600;letter-spacing:.02em;text-transform:none}
.ehp-dialog-close{display:grid;width:44px;height:44px;flex:0 0 44px;place-items:center;border:1px solid var(--border-light);border-radius:8px;background:var(--bg-page);color:var(--text-main);font-size:1.4rem;cursor:pointer}
.ehp-dialog-close:hover,.ehp-dialog-primary:hover,.ehp-dialog-secondary:hover,.ehp-enquiry-options label:hover{border-color:var(--accent-green)}
.ehp-dialog-close:focus-visible,.ehp-dialog-primary:focus-visible,.ehp-dialog-secondary:focus-visible,.ehp-enquiry-options label:focus-within{outline:2px solid var(--accent-green);outline-offset:3px}
.ehp-floating-card h2{margin:4px 0 10px;color:var(--text-main);font:400 clamp(1.5rem,4vw,1.95rem)/1.18 var(--serif);letter-spacing:-.02em}
.ehp-floating-card p,.ehp-floating-card address{color:var(--text-muted);font-size:.9rem;line-height:1.65}
.ehp-floating-card address{margin:12px 0;font-style:normal;color:var(--text-main)}
.ehp-representative-meta{margin:0 0 4px;color:var(--accent-brass);font-size:.75rem;font-weight:600}
.ehp-dialog-list{display:grid;gap:8px;margin:16px 0;padding-left:20px;color:var(--text-main);font-size:.88rem}
.ehp-dialog-note{padding:12px 14px;border:1px solid var(--border-light);border-radius:8px;background:var(--bg-subtle);font-size:.8rem!important}
.ehp-dialog-primary,.ehp-dialog-secondary{display:flex;min-height:46px;align-items:center;justify-content:center;width:100%;padding:10px 18px;border:1px solid var(--accent-green);border-radius:8px;background:var(--accent-green);color:#FFFFFF;font-size:.84rem;font-weight:600;text-align:center;text-decoration:none;cursor:pointer;transition:background-color .16s ease,border-color .16s ease}
.ehp-dialog-primary:hover{background:var(--accent-green-hover)}
.ehp-dialog-secondary{background:#FFFFFF;color:var(--accent-green);border-color:var(--border-light)}
.ehp-dialog-secondary:hover{background:var(--bg-subtle)}
.ehp-dialog-actions{display:grid;gap:9px;margin-top:16px}
.ehp-enquiry-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:16px 0;padding:0;border:0}
.ehp-enquiry-options label{display:flex;min-height:46px;align-items:center;gap:9px;padding:8px 12px;border:1px solid var(--border-light);border-radius:8px;background:var(--bg-page);color:var(--text-main);font-size:.84rem;cursor:pointer}
.ehp-enquiry-options input{width:18px;height:18px;accent-color:var(--accent-green)}
.ehp-quantity-label{display:block;margin:12px 0 6px;color:var(--text-main);font-size:.82rem;font-weight:600}
#ehp-enquiry-quantity{width:100%;min-height:46px;padding:10px 12px;border:1px solid var(--border-light);border-radius:8px;background:#FFFFFF;color:var(--text-main);font:inherit}
.ehp-dialog-error{color:#9B2C20!important;font-size:.8rem!important}
.ehp-store-status{margin:0 0 8px;color:var(--accent-green)!important;font-size:.84rem!important;font-weight:700}
.ehp-store-status[data-open="false"]{color:var(--accent-brass)!important}
.ehp-dialog-feedback{min-height:1.5em;margin-bottom:0;font-size:.8rem!important;color:var(--accent-green)!important}
.ehp-item-modal-trigger,.pantry-item-trigger,.live-product-title-trigger{display:inline-flex;min-height:40px;align-items:center;border:0;padding:0;background:transparent;color:inherit;font:inherit;text-align:left;text-decoration:underline;text-decoration-color:var(--border-light);text-underline-offset:3px;cursor:pointer}
@media(max-width:520px){.ehp-floating-card{padding:20px}.ehp-enquiry-options{grid-template-columns:1fr}}
</style>
