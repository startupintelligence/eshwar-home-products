---
import { buildWhatsAppUrl, storeConfig } from "../data/store";

const whatsappHref = buildWhatsAppUrl(
  "Hello Eshwar Home Products, I would like to enquire about products.",
);
---
<div class="contact-fab-wrap" data-contact-fab>
  <div
    class="contact-fab-menu"
    id="contact-fab-menu"
    role="group"
    aria-label="Contact options"
    hidden
  >
    <a class="contact-fab-option" href={storeConfig.emailHref}>
      <span class="contact-fab-option-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
      </span>
      <span class="contact-fab-option-copy">
        <strong>Email</strong>
        <span>{storeConfig.email}</span>
      </span>
    </a>

    <a
      class="contact-fab-option"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="contact-fab-option-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.08c-.24.68-1.42 1.3-1.97 1.38-.52.08-1.18.11-1.91-.12-.44-.14-1.01-.33-1.73-.64-3.05-1.32-5.04-4.38-5.19-4.58-.15-.2-1.24-1.65-1.24-3.15s.78-2.24 1.06-2.55c.28-.3.61-.38.81-.38.2 0 .4 0 .58.01.19.01.44-.07.69.53.26.62.88 2.14.96 2.3.08.16.13.35.03.55-.1.2-.15.33-.3.5-.15.17-.32.39-.45.52-.15.15-.31.31-.13.62.18.3.79 1.31 1.7 2.12 1.17 1.04 2.16 1.36 2.46 1.52.3.15.48.13.66-.08.18-.2.76-.88.96-1.19.2-.3.4-.25.68-.15.28.1 1.77.83 2.08.99.3.15.51.23.58.36.08.13.08.76-.16 1.44Z" />
        </svg>
      </span>
      <span class="contact-fab-option-copy">
        <strong>Whatsapp</strong>
        <span>Quick stock chat</span>
      </span>
    </a>

    <a class="contact-fab-option" href={storeConfig.phoneHref}>
      <span class="contact-fab-option-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
      </span>
      <span class="contact-fab-option-copy">
        <strong>Call Store</strong>
        <span>{storeConfig.phoneDisplay}</span>
      </span>
    </a>
  </div>

  <button
    class="contact-fab-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="contact-fab-menu"
    aria-label="Contact"
    title="Contact"
  >
    <svg class="contact-fab-icon-open" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      <path d="M8 10h.01" />
      <path d="M12 10h.01" />
      <path d="M16 10h.01" />
    </svg>
    <svg class="contact-fab-icon-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
    <span class="sr-only">Contact</span>
  </button>
</div>

<script>
  const fabWrap = document.querySelector<HTMLElement>("[data-contact-fab]");
  const fabTrigger = fabWrap?.querySelector<HTMLButtonElement>(".contact-fab-trigger");
  const fabMenu = fabWrap?.querySelector<HTMLElement>("#contact-fab-menu");
  const siteFooter = document.querySelector<HTMLElement>(".site-footer");

  if (fabWrap && fabTrigger && fabMenu) {
    const setMenuOpen = (open: boolean, returnFocus = false) => {
      fabWrap.classList.toggle("is-open", open);
      fabTrigger.setAttribute("aria-expanded", String(open));
      fabTrigger.setAttribute("aria-label", open ? "Close contact options" : "Contact");
      fabTrigger.setAttribute("title", open ? "Close contact options" : "Contact");
      fabMenu.hidden = !open;
      if (!open && returnFocus) {
        fabTrigger.focus({ preventScroll: true });
      }
    };

    fabTrigger.addEventListener("click", () => {
      const isOpen = fabTrigger.getAttribute("aria-expanded") === "true";
      setMenuOpen(!isOpen);
      if (!isOpen) {
        const firstLink = fabMenu.querySelector<HTMLAnchorElement>("a");
        window.requestAnimationFrame(() => firstLink?.focus({ preventScroll: true }));
      }
    });

    document.addEventListener("click", (event) => {
      if (
        fabTrigger.getAttribute("aria-expanded") === "true" &&
        event.target instanceof Node &&
        !fabWrap.contains(event.target)
      ) {
        setMenuOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && fabTrigger.getAttribute("aria-expanded") === "true") {
        event.preventDefault();
        setMenuOpen(false, true);
      }
    });

    fabMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        setMenuOpen(false);
      });
    });

    if (siteFooter && "IntersectionObserver" in window) {
      const footerObserver = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          const hideFab = entry.isIntersecting;
          fabWrap.classList.toggle("is-footer-visible", hideFab);
          fabWrap.setAttribute("aria-hidden", String(hideFab));
          if (hideFab) {
            setMenuOpen(false);
            fabTrigger.setAttribute("tabindex", "-1");
          } else {
            fabTrigger.removeAttribute("tabindex");
          }
        },
        { threshold: 0.05 },
      );
      footerObserver.observe(siteFooter);
    }
  }
</script>
