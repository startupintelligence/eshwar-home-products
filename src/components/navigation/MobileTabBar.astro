---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const active = {
  home: path === base || path === base.slice(0, -1),
  products: path.startsWith(base + "products"),
  contact: path.startsWith(base + "contact"),
  profile: path.startsWith(base + "profile"),
};
---
<nav class="ehp-mobile-tabs" aria-label="Primary mobile navigation">
  <a class="ehp-mobile-tab" href={base} aria-current={active.home ? "page" : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z" /></svg>
    <span>Home</span>
  </a>
  <a class="ehp-mobile-tab" href={base + "products/"} aria-current={active.products ? "page" : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1" /><rect x="13.5" y="3.5" width="7" height="7" rx="1" /><rect x="3.5" y="13.5" width="7" height="7" rx="1" /><rect x="13.5" y="13.5" width="7" height="7" rx="1" /></svg>
    <span>Products</span>
  </a>
  <a class="ehp-mobile-tab" href={base + "contact/"} aria-current={active.contact ? "page" : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v13H4z" /><path d="m4.5 7 7.5 6 7.5-6" /></svg>
    <span>Contact Us</span>
  </a>
  <a class="ehp-mobile-tab" href={base + "profile/"} aria-current={active.profile ? "page" : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M4.5 20c.6-3.5 3.4-5.5 7.5-5.5s6.9 2 7.5 5.5" /></svg>
    <span>Profile</span>
  </a>
</nav>
<style>
  .ehp-mobile-tabs{display:none}
  @media(max-width:768px){
    .ehp-mobile-tabs{position:fixed;inset-inline:0;bottom:0;z-index:70;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;padding:7px 10px calc(7px + env(safe-area-inset-bottom));background:#3B2112;border-top:1px solid #D99B26}
    .ehp-mobile-tab{display:flex;min-width:0;min-height:56px;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:5px 2px;color:#F5EDE3;text-decoration:none;font:600 .72rem/1.15 system-ui,sans-serif;text-align:center;border-radius:10px;-webkit-tap-highlight-color:transparent}
    .ehp-mobile-tab svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .ehp-mobile-tab[aria-current="page"]{background:#D99B26;color:#3B2112}
    .ehp-mobile-tab:focus-visible{outline:2px solid #F5EDE3;outline-offset:2px}
    body{padding-bottom:calc(76px + env(safe-area-inset-bottom))}
    .site-footer{padding-bottom:calc(12px + env(safe-area-inset-bottom))}
  }
  @media(prefers-reduced-motion:reduce){.ehp-mobile-tab{transition:none}}
</style>
