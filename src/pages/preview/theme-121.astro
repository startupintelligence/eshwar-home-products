---
const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu";
const logo = `${base}images/brand/eshwar-home-products-logo-400.webp`;
const shop = `${base}images/business/EHP_Shop_Front_View-1280.webp`;
const pantryOne = `${base}images/business/EHP_Products1-480.webp`;
const pantryTwo = `${base}images/business/EHP_Products2-480.webp`;
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#4b4a1b" />
  <title>Colour Study 121 | Eshwar Home Products</title>
  <meta name="description" content="A client-only visual preview of Eshwar Home Products using Combination 121 from A Dictionary of Colour Combinations." />
  <style>
    :root {
      color-scheme: light;
      --lincoln-green: #4b4a1b;
      --ochraceous-salmon: #d99a72;
      --book-brown: #7a2e1c;
      --salmon-paper: #f4e1d5;
      --salmon-light: #faeee7;
      --olive-deep: #353513;
      --content: 1180px;
      --serif: Georgia, "Times New Roman", serif;
      --sans: "Plus Jakarta Sans", "Segoe UI", Arial, sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--salmon-light); color: var(--book-brown); font-family: var(--sans); line-height: 1.55; }
    a { color: inherit; }
    img { display: block; max-width: 100%; }
    .preview-note { padding: 9px 18px; background: var(--book-brown); color: var(--salmon-light); text-align: center; font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
    .site-header { background: var(--salmon-paper); border-bottom: 1px solid rgba(122,46,28,.18); }
    .header-inner { width: min(var(--content), calc(100% - 40px)); min-height: 88px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 28px; }
    .brand { display: inline-flex; align-items: center; gap: 13px; text-decoration: none; min-width: 0; }
    .brand img { width: 64px; height: 64px; object-fit: contain; }
    .brand-name { font: 600 19px/1.1 var(--serif); letter-spacing: -.025em; }
    .brand-sub { display: block; margin-top: 5px; font: 700 9px/1.2 var(--sans); letter-spacing: .16em; text-transform: uppercase; }
    .nav { display: flex; align-items: center; gap: 28px; font-size: 13px; font-weight: 700; }
    .nav a { text-decoration: none; }
    .nav a:hover { text-decoration: underline; text-underline-offset: 5px; }
    .nav .nav-cta { padding: 12px 17px; border: 1px solid var(--book-brown); background: var(--book-brown); color: var(--salmon-light); }
    .hero { background: var(--lincoln-green); color: var(--salmon-light); }
    .hero-inner { width: min(var(--content), calc(100% - 40px)); margin: auto; display: grid; grid-template-columns: .92fr 1.08fr; min-height: 540px; align-items: stretch; }
    .hero-copy { padding: 78px 48px 72px 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
    .eyebrow { margin: 0 0 20px; color: var(--ochraceous-salmon); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { max-width: 610px; margin-bottom: 22px; font: 400 clamp(43px, 5vw, 68px)/.99 var(--serif); letter-spacing: -.045em; }
    h1 em { color: var(--ochraceous-salmon); font-style: italic; }
    .hero-lede { max-width: 480px; margin-bottom: 30px; color: #f4e1d5; font-size: 16px; line-height: 1.75; }
    .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
    .button { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; padding: 0 20px; border: 1px solid var(--ochraceous-salmon); background: var(--ochraceous-salmon); color: var(--book-brown); font-size: 13px; font-weight: 800; text-decoration: none; }
    .button:hover { background: var(--salmon-light); border-color: var(--salmon-light); }
    .button-outline { background: transparent; color: var(--salmon-light); }
    .button-outline:hover { background: var(--salmon-light); color: var(--book-brown); }
    .hero-photo { position: relative; min-height: 440px; margin: 36px 0 36px 12px; overflow: hidden; background: var(--book-brown); }
    .hero-photo img { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; }
    .hero-photo figcaption { position: absolute; right: 0; bottom: 0; padding: 12px 16px; background: var(--book-brown); color: var(--salmon-light); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
    .section { padding: 88px 20px; }
    .section-inner { width: min(var(--content), 100%); margin: auto; }
    .section-heading { max-width: 670px; margin-bottom: 38px; }
    .section-heading h2 { margin-bottom: 12px; font: 400 clamp(34px, 4vw, 48px)/1.06 var(--serif); letter-spacing: -.035em; }
    .section-heading p { max-width: 570px; margin-bottom: 0; color: rgba(122,46,28,.82); font-size: 15px; }
    .pantry-section { background: var(--salmon-light); }
    .category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    .category { min-width: 0; background: var(--salmon-paper); border-bottom: 4px solid var(--ochraceous-salmon); }
    .category img { width: 100%; height: 190px; object-fit: cover; background: var(--ochraceous-salmon); }
    .category-copy { padding: 18px 18px 20px; }
    .category h3 { margin-bottom: 5px; font: 600 21px/1.1 var(--serif); }
    .category p { margin-bottom: 0; color: rgba(122,46,28,.8); font-size: 12px; }
    .shelf-section { background: var(--book-brown); color: var(--salmon-light); }
    .shelf-section .section-heading p { color: var(--salmon-paper); }
    .shelf-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .shelf-image { position: relative; min-height: 300px; overflow: hidden; background: var(--lincoln-green); }
    .shelf-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .shelf-image span { position: absolute; left: 0; bottom: 0; padding: 12px 15px; background: var(--lincoln-green); color: var(--salmon-light); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .shelf-side { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .shelf-card { background: var(--lincoln-green); }
    .shelf-card img { width: 100%; height: 190px; object-fit: cover; background: var(--ochraceous-salmon); }
    .shelf-card div { padding: 14px; }
    .shelf-card h3 { margin: 0; color: var(--salmon-light); font: 600 19px/1.15 var(--serif); }
    .visit-section { background: var(--ochraceous-salmon); color: var(--book-brown); }
    .visit-grid { display: grid; grid-template-columns: 1fr .85fr; gap: 64px; align-items: center; }
    .visit-grid h2 { max-width: 550px; margin-bottom: 18px; font: 400 clamp(38px, 4.6vw, 58px)/1.02 var(--serif); letter-spacing: -.04em; }
    .visit-grid p { max-width: 540px; font-size: 15px; }
    .visit-details { padding: 26px; background: var(--salmon-paper); border-left: 5px solid var(--lincoln-green); }
    .detail-label { margin: 0 0 5px; color: var(--lincoln-green); font-size: 10px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
    .detail-value { margin: 0 0 19px; font-size: 14px; font-weight: 650; }
    .detail-value:last-child { margin-bottom: 0; }
    .visit-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
    .visit-actions .button { background: var(--book-brown); border-color: var(--book-brown); color: var(--salmon-light); }
    .visit-actions .button:hover { background: var(--lincoln-green); border-color: var(--lincoln-green); }
    .site-footer { padding: 30px 20px; background: var(--lincoln-green); color: var(--salmon-light); }
    .footer-inner { width: min(var(--content), 100%); margin: auto; display: flex; justify-content: space-between; gap: 20px; align-items: center; font-size: 12px; }
    .footer-inner p { margin: 0; }
    .footer-note { color: var(--ochraceous-salmon); }
    :focus-visible { outline: 3px solid var(--ochraceous-salmon); outline-offset: 4px; }
    @media (max-width: 850px) {
      .nav { gap: 16px; }
      .hero-inner { grid-template-columns: 1fr 1fr; }
      .hero-copy { padding: 54px 20px 54px 0; }
      .hero-photo { min-height: 400px; }
      .category-grid { grid-template-columns: repeat(2, 1fr); }
      .visit-grid { gap: 28px; }
    }
    @media (max-width: 620px) {
      .preview-note { font-size: 9px; letter-spacing: .08em; }
      .header-inner { min-height: 74px; width: min(100% - 28px, var(--content)); }
      .brand img { width: 52px; height: 52px; }
      .brand-name { font-size: 16px; }
      .nav a:not(.nav-cta) { display: none; }
      .nav .nav-cta { padding: 10px 12px; font-size: 11px; }
      .hero-inner { width: 100%; grid-template-columns: 1fr; }
      .hero-copy { padding: 52px 22px 34px; }
      h1 { font-size: clamp(42px, 13vw, 58px); }
      .hero-lede { font-size: 14px; }
      .hero-photo { min-height: 270px; margin: 0 16px 16px; }
      .section { padding: 62px 18px; }
      .section-heading { margin-bottom: 26px; }
      .category-grid { gap: 10px; }
      .category img { height: 138px; }
      .category-copy { padding: 13px; }
      .category h3 { font-size: 18px; }
      .category p { font-size: 11px; }
      .shelf-layout, .visit-grid { grid-template-columns: 1fr; gap: 14px; }
      .shelf-image { min-height: 230px; }
      .shelf-side { gap: 10px; }
      .shelf-card img { height: 130px; }
      .shelf-card div { padding: 11px; }
      .shelf-card h3 { font-size: 16px; }
      .visit-details { padding: 20px; }
      .footer-inner { align-items: flex-start; flex-direction: column; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  </style>
</head>
<body>
  <div class="preview-note">Client design preview · Colour direction 121 · Not the live website</div>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="#top" aria-label="Eshwar Home Products home">
        <img src={logo} alt="Eshwar Home Products emblem" width="64" height="64" />
        <span class="brand-name">Eshwar Home Products<span class="brand-sub">Perambur · Chennai</span></span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="#pantry">Our Pantry</a>
        <a href="#story">Our Store</a>
        <a class="nav-cta" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get Directions ↗</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">A neighbourhood pantry · Perambur</p>
          <h1 id="hero-title">Good food begins with <em>good staples.</em></h1>
          <p class="hero-lede">Traditional rice, whole millets, wood-pressed oils and everyday pantry essentials for South Indian kitchens. Discover the range, then visit our store in Perambur.</p>
          <div class="actions">
            <a class="button" href="#pantry">Explore the Pantry</a>
            <a class="button button-outline" href={mapsUrl} target="_blank" rel="noopener noreferrer">Visit Our Store ↗</a>
          </div>
        </div>
        <figure class="hero-photo">
          <img src={shop} alt="Eshwar Home Products storefront in Perambur, Chennai" width="1280" height="853" fetchpriority="high" />
          <figcaption>Our store · Paddy Field Road</figcaption>
        </figure>
      </div>
    </section>

    <section class="section pantry-section" id="pantry">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Explore the pantry</p>
          <h2>Everyday essentials, thoughtfully brought together.</h2>
          <p>Browse familiar kitchen staples and traditional ingredients. Availability and pack sizes can be confirmed at the store.</p>
        </div>
        <div class="category-grid">
          <article class="category">
            <img src={pantryOne} alt="A selection of pantry products at Eshwar Home Products" loading="lazy" width="480" height="320" />
            <div class="category-copy"><h3>Rice & Millets</h3><p>Traditional rice and whole-grain staples</p></div>
          </article>
          <article class="category">
            <img src={pantryTwo} alt="Assorted pantry products displayed in the store" loading="lazy" width="480" height="320" />
            <div class="category-copy"><h3>Pantry Staples</h3><p>Everyday essentials for home cooking</p></div>
          </article>
          <article class="category">
            <img src={pantryOne} alt="Representative pantry selection photographed in the store" loading="lazy" width="480" height="320" />
            <div class="category-copy"><h3>Millet & Pantry Range</h3><p>Explore available varieties in store</p></div>
          </article>
          <article class="category">
            <img src={pantryTwo} alt="Representative assortment of pantry products in store" loading="lazy" width="480" height="320" />
            <div class="category-copy"><h3>Pantry Assortment</h3><p>Ask our team about current selections</p></div>
          </article>
        </div>
      </div>
    </section>

    <section class="section shelf-section" id="story">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">From our shelves</p>
          <h2>A closer look at what you can find in store.</h2>
          <p>Explore the product range in person. Our team can help you identify varieties and check current availability.</p>
        </div>
        <div class="shelf-layout">
          <div class="shelf-image">
            <img src={pantryTwo} alt="A general view of pantry products at Eshwar Home Products" loading="lazy" width="900" height="620" />
            <span>Pantry products on our shelves</span>
          </div>
          <div class="shelf-side">
            <article class="shelf-card"><img src={pantryOne} alt="Representative pantry products displayed in store" loading="lazy" width="480" height="320" /><div><h3>Pantry Selections</h3></div></article>
            <article class="shelf-card"><img src={pantryTwo} alt="Representative pantry assortment displayed in store" loading="lazy" width="480" height="320" /><div><h3>Everyday Essentials</h3></div></article>
          </div>
        </div>
      </div>
    </section>

    <section class="section visit-section" id="visit">
      <div class="section-inner visit-grid">
        <div>
          <p class="eyebrow">Come by our store</p>
          <h2>Find your everyday pantry essentials in Perambur.</h2>
          <p>Visit Eshwar Home Products to browse the range and buy in store. If you are checking for a particular item, call or message before your visit.</p>
          <div class="visit-actions">
            <a class="button" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get Directions ↗</a>
            <a class="button" href="tel:+919941209953">Call the Store</a>
          </div>
        </div>
        <aside class="visit-details" aria-label="Store details">
          <p class="detail-label">Find us</p>
          <p class="detail-value">119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011</p>
          <p class="detail-label">Store hours</p>
          <p class="detail-value">Monday–Saturday: 9:00 AM–9:00 PM<br />Sunday: Closed</p>
          <p class="detail-label">Phone</p>
          <p class="detail-value">+91 99412 09953</p>
        </aside>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>© Eshwar Home Products · Perambur, Chennai</p>
      <p class="footer-note">Colour study 121 · Lincoln Green · Ochraceous Salmon · Brown</p>
    </div>
  </footer>
</body>
</html>
