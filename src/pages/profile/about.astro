---
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/company-profile.css";
import { sitePath } from "../../app/config/site";
const ranges = ["Traditional rice varieties", "Whole millets (Siruthaniyam)", "Millet flours", "Cold-pressed oils", "Ghee and dairy essentials", "Honey, pulses, nuts and pantry staples"];
---
<SiteLayout title="About Eshwar Home Products | Perambur" description="About Eshwar Home Products, a neighbourhood pantry in Perambur, Chennai, offering traditional rice, millets, millet flours, oils and pantry essentials." current="profile">
<div class="company-profile cp-subpage"><section class="cp-subhero"><div class="container"><a class="cp-back-link cp-back-light" href={sitePath("profile/")}>← Company Profile</a><p class="cp-eyebrow">01 · COMPANY OVERVIEW</p><h1>About <em>Eshwar Home Products.</em></h1><p>Traditional pantry essentials and personal guidance for everyday kitchens in Perambur.</p></div></section>
<section class="container cp-content-grid"><article class="cp-prose"><p class="cp-eyebrow">WHO WE ARE</p><h2>A neighbourhood pantry with a clear purpose.</h2><p>Eshwar Home Products is a local grocery and pantry store in Perambur, Chennai. The store began with the idea of offering a distinctive alternative to the many conventional provision stores found along a street: a place with a focus on millets and traditional food products.</p><p>Today, customers can explore traditional rice varieties, whole millets (Siruthaniyam), millet flours, cold-pressed oils, ghee and other pantry essentials. Our team is available to offer personal guidance when customers need help choosing.</p><p>Our name carries a devotional connection to our family deity, Eshwaran (Lord Shiva). The Rudraksha and Trishul emblem reflects that identity.</p></article><aside class="cp-fact-panel"><img src={sitePath("images/business/EHP_Shop_Front_View-768.webp")} alt="Eshwar Home Products storefront in Perambur" width="768" height="512" loading="lazy" /><div><p class="cp-eyebrow">VISIT THE STORE</p><strong>Perambur, Chennai</strong><p>119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India.</p><a href={sitePath("contact/")}>Store details & directions ↗</a></div></aside></section>
<section class="cp-range-section"><div class="container"><p class="cp-eyebrow">WHAT YOU CAN FIND</p><h2>Our pantry ranges.</h2><div class="cp-range-grid">{ranges.map((range, i) => <div class="cp-range-item"><span>{String(i+1).padStart(2,"0")}</span><strong>{range}</strong></div>)}</div></div></section>
<section class="container cp-values"><p class="cp-eyebrow">THE WAY WE SERVE</p><h2>Honesty, gratitude and care.</h2><p>We aim to help customers make informed choices, answer questions personally and make traditional pantry products easier to discover. We do not claim certifications, health outcomes or product availability that have not been verified.</p><a class="cp-button cp-button-dark" href={sitePath("products/")}>Browse the pantry ↗</a></section></div>
</SiteLayout>
