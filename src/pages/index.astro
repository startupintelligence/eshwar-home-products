    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
</style>

<script>
  const storyButtons = document.querySelectorAll<HTMLButtonElement>("[data-story-filter]");
  const storyCards = document.querySelectorAll<HTMLElement>("[data-story-category]");
  const storyCountEl = document.getElementById("customer-stories-count");

  if (storyButtons.length > 0 && storyCards.length > 0) {
    const totalStories = storyCards.length;
    storyButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.dataset.storyFilter ?? "all";
        let visibleCount = 0;

        storyButtons.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });

        storyCards.forEach((card) => {
          const matches = selected === "all" || card.dataset.storyCategory === selected;
          card.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        if (storyCountEl) {
          storyCountEl.textContent = `Showing ${visibleCount} of ${totalStories} ${visibleCount === 1 ? "story" : "stories"}`;
        }
      });
    });
  }

  const productCards = document.querySelectorAll<HTMLElement>("[data-product-search-item]");
  const mealFilterButtons = document.querySelectorAll<HTMLButtonElement>("[data-meal-filter]");
  const productCountEl = document.getElementById("home-products-count");
  const productSearchStatus = document.getElementById("home-products-search-status");
  const productSearchText = document.getElementById("home-products-search-text");
  const productSearchEmpty = document.getElementById("home-products-empty");
  const productSearchEmptyText = document.getElementById("home-products-empty-text");
  const clearSearchButtons = [
    document.getElementById("home-products-search-clear"),
    document.getElementById("home-products-empty-clear")
  ].filter((el): el is HTMLElement => Boolean(el));

  const productGridWrap = document.getElementById("home-product-grid-wrap");
  const productSpinner = document.getElementById("home-products-spinner");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let activeMealFilter = "all";
  let activeSearchQuery = new URLSearchParams(window.location.search).get("q") ?? "";
  let filterUpdateTimer: number | undefined;

  const setProductGridLoading = (loading: boolean) => {
    if (productGridWrap) productGridWrap.classList.toggle("is-updating", loading);
    if (productSpinner) productSpinner.hidden = !loading;
  };

  const applyHomeProductFilters = () => {
    const rawQuery = activeSearchQuery.trim();
    const query = rawQuery.toLowerCase();
    const totalCount = productCards.length;
    let visibleCount = 0;

    productCards.forEach((card) => {
      const mealTags = (card.dataset.mealTags ?? "").split(",");
      const matchesMeal = activeMealFilter === "all" || mealTags.includes(activeMealFilter);
      const text = card.dataset.searchText ?? "";
      const matchesSearch = !query || text.includes(query);
      const visible = matchesMeal && matchesSearch;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    if (productCountEl) {
      productCountEl.textContent = `Showing ${visibleCount} of ${totalCount} ${totalCount === 1 ? "range" : "ranges"}`;
    }

    if (productSearchStatus && productSearchText) {
      if (query) {
        productSearchStatus.hidden = false;
        productSearchText.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? "range" : "ranges"} matching "${rawQuery}"`;
      } else {
        productSearchStatus.hidden = true;
      }
    }

    if (productSearchEmpty && productSearchEmptyText) {
      if (visibleCount === 0) {
        productSearchEmpty.hidden = false;
        productSearchEmptyText.textContent = query
          ? `No product ranges matched "${rawQuery}" in this kitchen filter. Try clearing your search or switching to All Pantry.`
          : "No product ranges matched this filter.";
      } else {
        productSearchEmpty.hidden = true;
      }
    }
  };

  const scheduleHomeFilterUpdate = () => {
    if (filterUpdateTimer) window.clearTimeout(filterUpdateTimer);
    if (prefersReducedMotion) {
      setProductGridLoading(false);
      applyHomeProductFilters();
      return;
    }
    setProductGridLoading(true);
    filterUpdateTimer = window.setTimeout(() => {
      applyHomeProductFilters();
      setProductGridLoading(false);
    }, 220);
  };

  mealFilterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      activeMealFilter = button.dataset.mealFilter ?? "all";
      mealFilterButtons.forEach((item) => {
        item.setAttribute("aria-pressed", String(item === button));
      });
      scheduleHomeFilterUpdate();
    });
  });

  window.addEventListener("ehp:product-search", (event) => {
    const detail = (event as CustomEvent<{ query?: string }>).detail;
    activeSearchQuery = detail?.query ?? "";
    scheduleHomeFilterUpdate();
  });

  clearSearchButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (filterUpdateTimer) window.clearTimeout(filterUpdateTimer);
      setProductGridLoading(false);
      activeMealFilter = "all";
      mealFilterButtons.forEach((item) => {
        item.setAttribute("aria-pressed", String(item.dataset.mealFilter === "all"));
      });
      activeSearchQuery = "";
      window.dispatchEvent(new CustomEvent("ehp:clear-product-search"));
      applyHomeProductFilters();
    });
  });

  if (activeSearchQuery) {
    applyHomeProductFilters();
  }
</script>