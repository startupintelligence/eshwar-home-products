---
import SiteLayout from "../layouts/SiteLayout.astro";
import catalogue from "../data/catalogue.json";
import "../styles/home-redesign.css";
const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Door%20No.%20119%2F1%2C%20Nelvayal%20Road%2C%20Perambur%2C%20Chennai%20600011";
const whatsappUrl = "https://wa.me/919941209953?text=Hello%20Eshwar%20Home%20Products%2C%20I%20would%20like%20to%20enquire%20about%20your%20millet%20products.";
---
<SiteLayout title="Traditional Foods & Millets in Perambur, Chennai | Eshwar Home Products" description="Explore millet products, traditional rice, millet flours and everyday pantry essentials at Eshwar Home Products, Nelvayal Road, Perambur, Chennai." current="home">
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Perambur · Chennai</p>
        <p class="hero-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p>
        <h1 class="hero-brand">ESHWAR HOME PRODUCTS</h1>
        <p class="hero-tagline">All Kinds of Millet Products Under One Roof</p>
        <p class="hero-intro">Explore traditional rice, millets, millet flours and everyday pantry ingredients at our Perambur store. Contact us to ask about current varieties and availability.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#pantry">Explore the Pantry <span aria-hidden="true">↗</span></a>
          <a class="button button-whatsapp" href={whatsappUrl}>Enquire on WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hero-index" aria-label="Store information">
        <p class="eyebrow">At the store</p>
        <ol>
          <li><span>01</span><strong>Traditional rice & millets</strong></li>
          <li><span>02</span><strong>Millet flours & pantry foods</strong></li>
          <li><span>03</span><strong>Oils, ghee & dairy</strong></li>
          <li><span>04</span><strong>Honey, pulses & more</strong></li>
        </ol>
        <p class="index-note">Product range and availability can change. Call ahead if you are looking for something specific.</p>
      </aside>
    </div>
  </section>
  <section class="trust-strip" aria-label="Store information">
    <div class="container trust-strip-grid">
      <div class="trust-item">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v18M5 8c3-1 5 0 7 4 2-4 4-5 7-4M6 16c2-1 4 0 6 3 2-3 4-4 6-3"/></svg>
        <span>Traditional Millets</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M6 7v13h12V7M9 7V4h6v3M9 11h6"/></svg>
        <span>Everyday Pantry</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/></svg>
        <span>Local Perambur Store</span>
      </div>
      <div class="trust-item">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg>
        <span>Call to Check Availability</span>
      </div>
    </div>
  </section>
  <section class="location-banner">
    <div class="container location-banner-inner">
      <div class="location-copy">
        <p class="eyebrow">Visit our store</p>
        <strong>Door No. 119/1, Nelvayal Road, Perambur, Chennai – 600011</strong>
        <span>Mon–Sat: 10:00 AM – 9:00 PM · Sun: 10:00 AM – 2:00 PM</span>
      </div>
      <div class="location-actions">
        <a href="tel:+919941209953">+91 99412 09953</a>
        <a class="location-directions" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get Directions ↗</a>
      </div>
    </div>
  </section>
  <section class="section container pantry-section" id="pantry">
    <div class="section-intro">
      <div><p class="eyebrow">A guide to our shelves</p><h2>Explore the pantry.</h2></div>
      <p>Browse the range by category. For exact varieties, pack sizes and current stock, please contact the store.</p>
    </div>
    <div class="directory-list pantry-track">
      {catalogue.groups.map((group, index) => (
        <a class="directory-row card" href={base + "products/#" + group.id}>
          <span class="directory-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="directory-main"><small>{group.eyebrow}</small>{" "}<strong>{group.title}</strong></span>
          <span class="directory-description">{group.description}</span>
          <span class="directory-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="section-end"><a class="text-link" href={base + "products/"}>View the full pantry index ↗</a></div>
  </section>
  <section class="story-strip">
    <div class="container story-strip-inner">
      <p class="eyebrow">A little about Eshwar</p>
      <div><h2>Traditional foods for<br /><em>everyday cooking.</em></h2><p>We bring together traditional foods and familiar pantry essentials for homes in and around Perambur. Visit the store, ask a question and check what is available.</p><a class="text-link" href={base + "about/"}>Read our story ↗</a></div>
    </div>
  </section>
  <section class="section container home-guide" aria-labelledby="home-guide-title">
    <div class="home-guide-intro">
      <p class="eyebrow">A neighbourhood pantry in Chennai</p>
      <h2 id="home-guide-title">A closer look at the foods on our shelves.</h2>
      <p>Eshwar Home Products is a local store in Perambur for people looking for traditional rice, millets and familiar ingredients for everyday cooking. This guide explains the broad categories you can ask us about. It is not a live inventory, and the exact products available may change.</p>
    </div>
    <div class="home-guide-grid">
      <article><p class="eyebrow">01 · Traditional grains</p><h3>Rice and millets</h3><p>Our pantry range includes traditional rice varieties and millet grains, also known as Siruthaniyam. These ingredients are used in many kinds of home cooking. If you have a particular grain in mind, contact the store and ask for the variety currently available. We recommend checking before travelling, especially when you are looking for a specific type.</p></article>
      <article><p class="eyebrow">02 · Everyday cooking</p><h3>Millet flours and meal options</h3><p>You can also ask about millet flours and other millet-based pantry choices. The range may include items used for home recipes, quick meals and snacks. Names, brands and pack sizes can vary, so please confirm the details directly with our team rather than relying on a general category description.</p></article>
      <article><p class="eyebrow">03 · Kitchen essentials</p><h3>Cooking oils, ghee and dairy</h3><p>Our store categories also cover cooking essentials such as cold-pressed Chekku oils, ghee and dairy products. If you are looking for gingelly, groundnut or coconut oil, ask us about the current options and pack sizes. We can help you check what is listed and available at the time of your enquiry.</p></article>
      <article><p class="eyebrow">04 · Pantry cupboard</p><h3>Honey, pulses, nuts and more</h3><p>For a wider pantry shop, ask about categories such as honey, pulses, dry fruits, nuts and Sathumaavu, a traditional health-mix category. The catalogue is intended as a starting point for your enquiry. It does not promise that every item or variety is in stock on every day.</p></article>
    </div>
  </section>
  <section class="home-visit-guide" aria-labelledby="home-visit-title"><div class="container home-visit-grid">
    <div><p class="eyebrow">Planning a visit</p><h2 id="home-visit-title">Check first. Then drop by.</h2></div>
    <div class="home-visit-copy">
      <p>If you are making a special trip, contact Eshwar Home Products before setting out. Tell us the ingredient or category you are looking for. For a useful answer, include the variety or pack size if you know it. Our team can confirm the latest information available from the store.</p>
      <p>The shop is at Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011. Store hours are Monday to Saturday, 10:00 AM to 9:00 PM, and Sunday, 10:00 AM to 2:00 PM. Hours may change on special days, so call if you are unsure.</p>
      <p>Call <a href="tel:+919941209953">+91 99412 09953</a> or send a message through WhatsApp. You can also use the directions link on this page to plan your route. We are a physical neighbourhood store; this website is a guide to our store and product categories, not an online checkout or live stock system.</p>
      <div class="home-guide-actions"><a class="text-link" href={base + "products/"}>Browse pantry categories</a><a class="text-link" href={base + "contact/"}>Contact and directions</a></div>
    </div>
  </div></section>
  <section class="section container home-faq" aria-labelledby="home-faq-title">
    <p class="eyebrow">Before you shop</p><h2 id="home-faq-title">Frequently asked questions</h2>
    <div class="home-faq-list">
      <details><summary>Can I see live product stock on this website?</summary><p>No. The website provides an overview of the store and its product categories. Stock and varieties can change. Please call or message the store to confirm current availability.</p></details>
      <details><summary>Can I ask about a specific millet or rice variety?</summary><p>Yes. Contact us with the name of the variety you need. If you know the preferred pack size, include that too so the team can check the relevant details.</p></details>
      <details><summary>Where is Eshwar Home Products located?</summary><p>We are at Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011, India.</p></details>
      <details><summary>How can I contact the store?</summary><p>Call +91 99412 09953 or use the WhatsApp enquiry link on this page. For directions, open the Google Maps link in the store information section.</p></details>
    </div>
  </section>
  <section class="home-share" aria-label="Share this page"><div class="container home-share-inner">
    <p class="eyebrow">Know someone nearby?</p><strong>Share the store information.</strong>
    <nav aria-label="Share Eshwar Home Products">
      <a href="https://wa.me/?text=Eshwar%20Home%20Products%20in%20Perambur%2C%20Chennai%3A%20https%3A%2F%2Fstartupintelligence.github.io%2Feshwar-home-products%2F" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fstartupintelligence.github.io%2Feshwar-home-products%2F" target="_blank" rel="noopener noreferrer">Facebook</a>
      <a href="https://twitter.com/intent/tweet?url=https%3A%2F%2Fstartupintelligence.github.io%2Feshwar-home-products%2F&text=Eshwar%20Home%20Products%20in%20Perambur%2C%20Chennai" target="_blank" rel="noopener noreferrer">X</a>
    </nav>
  </div></section>

</SiteLayout>
