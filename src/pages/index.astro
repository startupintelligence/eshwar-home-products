---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/home-editorial.css";

const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Door%20No.%20119%2F1%2C%20Nelvayal%20Road%2C%20Perambur%2C%20Chennai%20600011";
const ask = (item: string) => "https://wa.me/919941209953?text=" + encodeURIComponent("Hello Eshwar Home Products, please help me check today's availability and pack sizes for " + item + ".");
const categories = [
  { number: "01", tamil: "அரிசி · சிறுதானியம்", title: "Rice & millets", detail: "Traditional rice varieties, whole millets and millet flours for everyday meals, breakfast and tiffin.", image: "rice-millets.webp", alt: "Representative category artwork for rice and millets", href: base + "products/#grains", enquiry: "rice and millet varieties", note: "Grains for everyday meals" },
  { number: "02", tamil: "செக்கு எண்ணெய்", title: "Oils, ghee & dairy", detail: "Chekku gingelly, groundnut and coconut oils, alongside ghee and everyday dairy essentials.", image: "oils-ghee.webp", alt: "Representative category artwork for oils and ghee", href: base + "products/#oils", enquiry: "cold-pressed oils, ghee and dairy", note: "Everyday cooking essentials" },
  { number: "03", tamil: "சிற்றுண்டி · மளிகை", title: "Snacks & pantry", detail: "Millet flakes, vermicelli, pasta and cookies, Sathumaavu, honey, pulses, dry fruits and nuts.", image: "pantry-essentials.webp", alt: "Representative category artwork for pantry essentials", href: base + "products/#pantry", enquiry: "millet snacks and pantry essentials", note: "Little things for the pantry" }
];
---
<SiteLayout title="Eshwar Home Products | Traditional Foods & Millets in Perambur, Chennai" description="Explore traditional rice, Siruthaniyam millets, Chekku oils and everyday pantry essentials at Eshwar Home Products, Nelvayal Road, Perambur, Chennai." current="home">
  <div class="home-utility" aria-label="Store details">
    <div class="container home-utility-inner">
      <span>NEIGHBOURHOOD PANTRY <i aria-hidden="true">/</i> PERAMBUR, CHENNAI</span>
      <span>MON–SAT 10 AM–9 PM <i aria-hidden="true">·</i> SUN 10 AM–2 PM</span>
      <a href="tel:+919941209953">+91 99412 09953</a>
    </div>
  </div>

  <section class="editorial-hero" aria-labelledby="home-title">
    <div class="container editorial-hero-grid">
      <div class="editorial-hero-copy">
        <p class="editorial-kicker"><span></span> ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p>
        <h1 id="home-title">The everyday<br />things that make<br /><em>a kitchen home.</em></h1>
        <p class="editorial-lede">Traditional rice, Siruthaniyam millets, Chekku oils and pantry favourites, brought together at your neighbourhood store in Perambur.</p>
        <div class="editorial-hero-actions">
          <a class="editorial-button editorial-button-dark" href={base + "products/"}>Explore the pantry <span aria-hidden="true">↗</span></a>
          <a class="editorial-text-link" href={ask("your pantry requirements")}>Ask about availability <span aria-hidden="true">↗</span></a>
        </div>
        <div class="editorial-hero-index"><span>01</span><span>GOOD FOOD, CLOSE TO HOME</span></div>
      </div>
      <div class="editorial-hero-visual">
        <div class="editorial-image-meta"><span>FROM OUR SHELVES</span><span>CHENNAI · INDIA</span></div>
        <div class="editorial-image-wrap">
          <img src={base + "images/placeholders/rice-millets.webp"} alt="Representative artwork for traditional rice and millets" width="800" height="600" fetchpriority="high" />
          <span class="editorial-image-seal" aria-hidden="true"><small>THE LOCAL</small><strong>ஈ</strong><small>PANTRY</small></span>
        </div>
        <div class="editorial-image-caption"><span>01 / 03</span><p>Ingredients for the meals, rituals and everyday moments that bring us together.</p></div>
        <p class="editorial-image-disclaimer">Representative category artwork. Store photography will replace these visuals when supplied.</p>
      </div>
      <span class="editorial-hero-side-note" aria-hidden="true">A STORE CLOSE TO HOME · EST. PERAMBUR</span>
    </div>
  </section>

  <section class="editorial-intro container" aria-labelledby="intro-title">
    <p class="editorial-label">A LITTLE BIT OF EVERYTHING</p>
    <div class="editorial-intro-content">
      <h2 id="intro-title">A familiar stop<br />for <em>everyday needs.</em></h2>
      <div><p>Some things belong in every kitchen. The rice we grew up with. The oil we cook with. The small pantry favourites we reach for through the week.</p><p>Find them at Eshwar Home Products, on Nelvayal Road, Perambur.</p><a href={base + "about/"} class="editorial-text-link">A little about our store <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="editorial-categories" aria-labelledby="categories-title">
    <div class="container">
      <div class="editorial-section-top">
        <div><p class="editorial-label">BROWSE THE SHELVES <span>01—03</span></p><h2 id="categories-title">What are you<br /><em>looking for?</em></h2></div>
        <p>Start with a category. Explore the range, then contact the store to check today's availability and pack sizes.</p>
      </div>
      <div class="editorial-category-list">
        {categories.map((category) => <article class="editorial-category">
          <a class="editorial-category-image" href={category.href} aria-label={"Browse " + category.title}>
            <img src={base + "images/placeholders/" + category.image} alt={category.alt} width="800" height="600" loading="lazy" decoding="async" />
            <span class="editorial-category-number">{category.number}</span>
            <span class="editorial-category-arrow" aria-hidden="true">↗</span>
          </a>
          <div class="editorial-category-copy">
            <p class="editorial-category-tamil" lang="ta">{category.tamil}</p>
            <h3>{category.title}</h3>
            <p>{category.detail}</p>
            <span class="editorial-category-note">{category.note}</span>
            <div class="editorial-category-links"><a href={category.href}>Browse category ↗</a><a href={ask(category.enquiry)}>Check availability ↗</a></div>
          </div>
        </article>)}
      </div>
      <p class="editorial-stock-note">Product availability and pack sizes can change. Please contact the store before making a special trip.</p>
    </div>
  </section>

  <section class="editorial-store-story" aria-labelledby="store-story-title">
    <div class="container editorial-story-grid">
      <div class="editorial-story-aside"><span lang="ta">எங்கள் கடை</span><strong>LOCAL<br />FOOD.<br />LOCAL<br />FAMILIARITY.</strong><small>PERAMBUR · CHENNAI</small></div>
      <div class="editorial-story-copy">
        <p class="editorial-label editorial-label-light">YOUR NEIGHBOURHOOD STORE</p>
        <h2 id="store-story-title">For the recipes<br />we know. <em>And the<br />ones still to come.</em></h2>
        <p>Eshwar Home Products is here on Nelvayal Road for families looking for traditional staples and pantry favourites close to home. Drop in, tell us what you are looking for, and explore the shelves with our team.</p>
        <a href={base + "about/"} class="editorial-story-link">Get to know our store <span aria-hidden="true">↗</span></a>
      </div>
      <div class="editorial-story-mark" aria-hidden="true"><span>ஈ</span><small>ESHwar<br />HOME PRODUCTS</small></div>
    </div>
  </section>

  <section class="editorial-visit container" aria-labelledby="visit-title">
    <div class="editorial-visit-copy">
      <p class="editorial-label">COME BY THE STORE</p>
      <h2 id="visit-title">A good pantry<br />is <em>closer than<br />you think.</em></h2>
      <p>Need a particular variety or pack size? Call or message before you visit. Our team can help check the latest store information.</p>
      <a class="editorial-button editorial-button-red" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a>
    </div>
    <div class="editorial-visit-details">
      <div><span>01 / FIND US</span><p>Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011, India.</p></div>
      <div><span>02 / OPENING HOURS</span><p>Monday to Saturday, 10:00 AM–9:00 PM<br />Sunday, 10:00 AM–2:00 PM</p></div>
      <div><span>03 / CALL THE STORE</span><p><a href="tel:+919941209953">+91 99412 09953</a></p></div>
      <div><span>04 / QUICK ENQUIRY</span><p><a href={ask("your pantry requirements")}>Message us on WhatsApp ↗</a></p></div>
    </div>
  </section>

  <section class="editorial-faq" aria-labelledby="faq-title">
    <div class="container editorial-faq-grid">
      <div><p class="editorial-label">BEFORE YOU VISIT</p><h2 id="faq-title">A few things<br /><em>to know.</em></h2></div>
      <div class="editorial-faq-list">
        <details><summary>Can I check today's stock on WhatsApp?</summary><p>Yes. Send us the product or variety name and preferred pack size. Our team can help check the latest information from the store. <a href={ask("a product or variety you are looking for")}>Message us on WhatsApp ↗</a></p></details>
        <details><summary>What are the store timings?</summary><p>Monday to Saturday, 10:00 AM to 9:00 PM. Sunday, 10:00 AM to 2:00 PM. For special-day timing changes, please call before visiting.</p></details>
        <details><summary>Where exactly is the store?</summary><p>Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011, India. <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Open Google Maps ↗</a></p></details>
        <details><summary>Can I ask about a particular millet or rice variety?</summary><p>Of course. Browse the <a href={base + "perambur-millet-store/"}>Perambur millet store guide</a>, then contact the store to check availability.</p></details>
      </div>
    </div>
  </section>

  <section class="editorial-final">
    <div class="container editorial-final-inner">
      <div><p class="editorial-label editorial-label-light">ESHwar HOME PRODUCTS · PERAMBUR</p><h2>Make room for<br /><em>good things.</em></h2></div>
      <div><a class="editorial-button editorial-button-light" href={base + "products/"}>Explore the pantry <span aria-hidden="true">↗</span></a><a class="editorial-final-link" href={ask("your pantry requirements")}>Have a question? Talk to the store ↗</a></div>
    </div>
  </section>
</SiteLayout>
