---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import StoreLocationMap from "../components/StoreLocationMap";
import reviewData from "../data/reviews.json";
import "../styles/mobile-responsive.css";

import riceImg from "../assets/images/pantry_traditional_rice_1795627178963.jpg";
import milletsImg from "../assets/images/pantry_whole_millets_1795627178343.jpg";
import oilsImg from "../assets/images/pantry_cold_pressed_oils_1795627178653.jpg";
import gheeHoneyImg from "../assets/images/pantry_ghee_honey_1795627179772.jpg";
import badamImg from "../assets/images/ESH_Badam_Pack.jpeg";
import ragiImg from "../assets/images/ESH_Ragi_Pack.jpeg";

interface CustomerReview {
  reviewer: string;
  context?: string;
  category?: "grains" | "oils" | "pantry";
  staple?: string;
  title?: string;
  text: string;
  source: "Google Maps" | "Justdial";
  rating?: number;
}
const reviews = reviewData as CustomerReview[];
const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu&g_ep=EgoyMDI2MTExNS4wIKXMDSoASAFQAw%3D%3D";
const whatsappUrl = "https://wa.me/919941209953";
const ask = (item: string) => whatsappUrl + "?text=" + encodeURIComponent("Hello Eshwar Home Products, please help me check today's availability and pack sizes for " + item + ".");

const categories = [
  { title: "Grains & Millets", subtitle: "Siruthaniyam & Rice", item: "grains and millets", image: riceImg },
  { title: "Chekku Oils", subtitle: "Wood-Pressed Purity", item: "cold-pressed oils", image: oilsImg },
  { title: "Whole Millets", subtitle: "Thinai, Varagu & Samai", item: "whole millets", image: milletsImg },
  { title: "Dry Fruits & Nuts", subtitle: "Badam, Cashew & Pista", item: "dry fruits and nuts", image: badamImg },
  { title: "Ragi & Snacks", subtitle: "Flours, Cookies & Sevai", item: "ragi and millet snacks", image: ragiImg },
  { title: "Ghee & Honey", subtitle: "Cow Ghee & Wild Honey", item: "ghee and wild honey", image: gheeHoneyImg }
];

const featuredProducts = [
  {
    category: "Heirloom Staples",
    title: "Traditional Rice",
    image: riceImg,
    alt: "Traditional South Indian heirloom rice varieties in ceramic and brass bowls",
    enquiry: "traditional rice varieties",
    description: "Familiar and heirloom South Indian rice varieties for everyday home meals.",
    kitchenUse: "Best for: Daily meals, pongal & idli batter",
    meals: ["rice-swap", "breakfast"],
    items: ["Traditional rice varieties", "Parboiled & raw rice options", "Ask store for current harvest stock"]
  },
  {
    category: "Siruthaniyam",
    title: "Whole Millets & Flours",
    featured: true,
    featuredLabel: "Featured · Fresh Harvest",
    image: milletsImg,
    alt: "Whole millets including foxtail millet, finger millet ragi, and pearl millet in ceramic bowls",
    enquiry: "whole millets and millet varieties",
    description: "Thinai, Varagu, Samai, Kuthiraivali, Ragi, and Kambu in whole grain and flour.",
    kitchenUse: "Best for: Rice swap, upma, khichdi & kanji",
    meals: ["breakfast", "rice-swap"],
    items: ["Thinai · Foxtail millet", "Varagu · Kodo millet", "Samai · Little millet", "Kuthiraivali · Barnyard millet", "Ragi · Finger millet", "Kambu · Pearl millet"]
  },
  {
    category: "Tiffin & Teatime",
    title: "Ragi & Millet Snacks",
    image: ragiImg,
    alt: "Packaged ragi millet staples and nutritious snacks from Eshwar Home Products",
    enquiry: "ragi, millet cookies, flakes and sevai",
    description: "Sprouted ragi flours, millet flakes, vermicelli, pasta, and everyday tiffin snacks.",
    kitchenUse: "Best for: Morning malt, dosa batter & kids tiffin",
    meals: ["breakfast", "festival"],
    items: ["Ragi flour & kanji mixes", "Millet flakes & sevai", "Millet pasta & teatime cookies"]
  },
  {
    category: "Chekku Pressed",
    title: "Cold-Pressed Oils",
    image: oilsImg,
    alt: "Cold-pressed gingelly sesame oil and groundnut oil in glass bottles with sesame seeds and peanuts",
    enquiry: "cold-pressed oils",
    description: "Wood-pressed gingelly, groundnut, and coconut oils chosen for everyday cooking.",
    kitchenUse: "Best for: Daily tempering, poriyal & deep frying",
    meals: ["cooking"],
    items: ["Wood-pressed gingelly oil", "Wood-pressed groundnut oil", "Wood-pressed coconut oil"]
  },
  {
    category: "Kitchen Pure",
    title: "Pure Ghee & Wild Honey",
    image: gheeHoneyImg,
    alt: "Artisanal clarified cow ghee and wild forest honey in glass jars on limestone",
    enquiry: "ghee and honey",
    description: "Traditional clarified cow ghee, everyday dairy, and pure wild forest honey.",
    kitchenUse: "Best for: Sweet pongal, warm breakfast & drizzle",
    meals: ["breakfast", "cooking", "festival"],
    items: ["Clarified cow ghee", "Wild forest honey", "Everyday dairy essentials"]
  },
  {
    category: "Pantry & Festive",
    title: "Badam, Cashews & Nuts",
    image: badamImg,
    alt: "Cleanly packed whole almonds, cashews, and pantry dry fruits at Eshwar Home Products",
    enquiry: "badam, cashews, pista and dry fruits",
    description: "Cleanly packed almonds, cashews, pistachios, walnuts, and native pantry pulses.",
    kitchenUse: "Best for: Festive sweets, payasam & daily soaking",
    meals: ["festival", "breakfast"],
    items: ["Whole Badam (Almonds)", "Whole Cashews & Pista", "Walnuts & Native Pulses"]
  }
];

const sourcingHighlights = [
  {
    number: "01",
    title: "Whole-Grain Siruthaniyam",
    detail: "Thinai, Varagu, Samai, Kuthiraivali, Ragi, and Kambu stocked cleanly in whole grain, rava, and flour."
  },
  {
    number: "02",
    title: "Wood-Pressed Chekku Oils",
    detail: "Gingelly, groundnut, and coconut oils selected for authentic South Indian kitchen aroma and daily cooking."
  },
  {
    number: "03",
    title: "Clean-Shelf Pantry Care",
    detail: "Neat counter packs of badam, cashews, walnuts, cow ghee, native pulses, and wild forest honey."
  },
  {
    number: "04",
    title: "Honest Counter & WhatsApp Help",
    detail: "Confirm fresh arrivals, Tamil millet names, and available pack sizes directly on +91 99412 09953 before visiting."
  }
];
---
<SiteLayout
  title="Eshwar Home Products | Millets & Pantry Store in Perambur"
  description="Shop traditional rice, Siruthaniyam millets, millet flours & cold-pressed oils at Eshwar Home Products in Perambur, Chennai."
  current="home"
  preloadHomeHero
>
  <!-- 1. Storefront Hero + Category Strip -->
  <section class="home-hero-section" id="home" aria-labelledby="home-title">
    <div class="container">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="home-meta-line">
            <span>Perambur, Chennai</span>
            <span aria-hidden="true">·</span>
            <span lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</span>
            <span aria-hidden="true">·</span>
            <span>Mon–Sat 9 AM – 9 PM</span>
          </p>
          <h1 id="home-title">Traditional Rice, Millets &amp; <em>Everyday Pantry</em> Essentials</h1>
          <p class="home-hero-lede">
            Thoughtfully chosen staples for everyday South Indian kitchens. Visit our neighbourhood pantry on Paddy Field Road in Perambur, or message us directly to check today's fresh stock.
          </p>
          <div class="home-hero-actions">
            <a class="button" href={base + "products/"}>Explore Our Pantry <span aria-hidden="true">→</span></a>
            <button class="button-whatsapp" type="button" data-ehp-dialog="enquiry" aria-haspopup="dialog">Check Stock on WhatsApp</button>
          </div>
          <div class="home-hero-proof">
            <a class="home-proof-rating" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              <span class="five-stars-reveal" aria-hidden="true">★★★★★</span>
              <span><strong>5.0</strong> Rated on Google Maps</span>
            </a>
            <span class="home-proof-sep" aria-hidden="true">·</span>
            <button class="home-proof-address" type="button" data-ehp-dialog="store" aria-haspopup="dialog">
              119/1, Paddy Field Road, Chinnaiyan Colony
            </button>
          </div>
        </div>

        <figure class="home-hero-media">
          <a class="home-hero-media-link" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Eshwar Home Products storefront location in Google Maps">
            <picture>
              <source
                type="image/webp"
                srcset={`${base}images/business/EHP_Shop_Front_View-480.webp 480w, ${base}images/business/EHP_Shop_Front_View-768.webp 768w, ${base}images/business/EHP_Shop_Front_View-1280.webp 1280w`}
                sizes="(max-width: 900px) 100vw, 48vw"
              />
              <img
                src={base + "images/business/EHP_Shop_Front_View.jpeg"}
                alt="Eshwar Home Products neighbourhood storefront in Perambur, Chennai"
                width="1288"
                height="966"
                fetchpriority="high"
                loading="eager"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </picture>
            <div class="home-hero-scrim" aria-hidden="true"></div>
            <figcaption class="home-hero-caption">
              <span>Neighbourhood Store · Chinnaiyan Colony, Perambur</span>
              <span>Directions ↗</span>
            </figcaption>
          </a>
        </figure>
      </div>

      <nav class="home-category-strip" aria-label="Browse pantry categories">
        {categories.map((category) => (
          <a
            class="home-category-item"
            href={ask(category.item)}
            data-ehp-dialog="product"
            data-ehp-title={category.title}
            data-ehp-description={category.subtitle + " · Ask the store about current varieties and pack sizes."}
            data-ehp-items={JSON.stringify([category.item])}
            aria-haspopup="dialog"
          >
            <Image
              class="home-category-thumb"
              src={category.image}
              alt=""
              width={160}
              format="webp"
              quality={60}
              loading="lazy"
              decoding="async"
            />
            <span class="home-category-copy">
              <strong>{category.title}</strong>
              <span>{category.subtitle}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 2. Featured Pantry Collection -->
  <section class="home-featured-section" id="products" aria-labelledby="products-title">
    <div class="container">
      <div class="home-section-header">
        <div>
          <p class="eyebrow">Thoughtful Pantry</p>
          <h2 id="products-title">Curated Essentials for Daily Cooking</h2>
        </div>
        <a class="text-link" href={base + "products/"}>View full catalogue <span aria-hidden="true">→</span></a>
      </div>

      <div class="home-meal-toolbar">
        <div class="home-meal-filters" role="group" aria-label="Filter pantry range by kitchen use">
          <button class="filter-button" type="button" data-meal-filter="all" aria-pressed="true">
            <svg class="filter-icon" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="6" height="6" rx="1.2" /><rect x="11" y="3" width="6" height="6" rx="1.2" /><rect x="3" y="11" width="6" height="6" rx="1.2" /><rect x="11" y="11" width="6" height="6" rx="1.2" />
            </svg>
            <span>All Pantry</span>
          </button>
          <button class="filter-button" type="button" data-meal-filter="breakfast" aria-pressed="false">
            <svg class="filter-icon" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 10h13a6.5 6.5 0 0 1-13 0Z" /><path d="M6.5 16.5h7" /><path d="M7.5 4.5c0 1.2 1 1.6 1 2.8" /><path d="M12 4c0 1.2 1 1.6 1 2.8" />
            </svg>
            <span>Breakfast &amp; Tiffin</span>
          </button>
          <button class="filter-button" type="button" data-meal-filter="rice-swap" aria-pressed="false">
            <svg class="filter-icon" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.2 3.2h5.6l-1 2.4H8.2l-1-2.4Z" /><path d="M8.2 5.6c-2.6 1.6-3.7 4.4-3.7 8.4a2.8 2.8 0 0 0 2.8 2.8h5.4a2.8 2.8 0 0 0 2.8-2.8c0-4-1.1-6.8-3.7-8.4" /><path d="M8 11.2h4" />
            </svg>
            <span>Everyday Rice Swap</span>
          </button>
          <button class="filter-button" type="button" data-meal-filter="cooking" aria-pressed="false">
            <svg class="filter-icon" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M8 2.5h4v2.6l2.4 2.4a2 2 0 0 1 .6 1.4v6.6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8.9a2 2 0 0 1 .6-1.4L8 5.1V2.5Z" /><path d="M8 12h4" />
            </svg>
            <span>Cold-Pressed Cooking</span>
          </button>
          <button class="filter-button" type="button" data-meal-filter="festival" aria-pressed="false">
            <svg class="filter-icon" viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 3.2c1.4 2 2 3.4 0 5.1-2-1.7-1.4-3.1 0-5.1Z" /><path d="M3.5 11.5h13a6.5 6.5 0 0 1-13 0Z" /><path d="M6.5 17h7" />
            </svg>
            <span>Festival &amp; Dry Fruits</span>
          </button>
        </div>
        <p class="home-meal-count" id="home-products-count" aria-live="polite">
          Showing {featuredProducts.length} of {featuredProducts.length} ranges
        </p>
      </div>

      <div class="home-search-status" id="home-products-search-status" hidden aria-live="polite">
        <span id="home-products-search-text"></span>
        <button class="home-search-clear" type="button" id="home-products-search-clear">Clear search</button>
      </div>

      <div class="home-product-grid-wrap" id="home-product-grid-wrap">
        <div class="home-products-spinner" id="home-products-spinner" role="status" aria-live="polite" aria-label="Updating product range" hidden>
          <span class="home-spinner-ring" aria-hidden="true"></span>
          <span class="sr-only">Updating product range</span>
        </div>
        <div class="home-product-grid" id="home-product-grid">
          {featuredProducts.map((product) => (
            <article
              class={product.featured ? "home-product-card is-featured" : "home-product-card"}
              data-product-search-item
              data-meal-tags={product.meals.join(",")}
              data-search-text={`${product.title} ${product.category} ${product.description} ${product.kitchenUse} ${product.items.join(" ")} ${product.enquiry}`.toLowerCase()}
            >
              <div class="home-product-media">
                {product.featured && (
                  <span class="home-product-featured-tag">{product.featuredLabel ?? "Featured"}</span>
                )}
                <Image
                  src={product.image}
                  alt={product.alt}
                  widths={[400, 800]}
                  sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 25vw"
                  format="webp"
                  quality={70}
                  loading="lazy"
                  decoding="async"
                />
              <button
                class="home-product-overlay-trigger"
                type="button"
                data-quickview-trigger
                data-quickview-title={product.title}
                data-quickview-description={product.description}
                data-quickview-items={JSON.stringify(product.items)}
                aria-haspopup="dialog"
                aria-label={`View varieties for ${product.title}`}
              ></button>
            </div>
            <div class="home-product-body">
              <p class="home-product-category">{product.category}</p>
              <h3>
                <button
                  class="home-product-title-btn"
                  type="button"
                  data-quickview-trigger
                  data-quickview-title={product.title}
                  data-quickview-description={product.description}
                  data-quickview-items={JSON.stringify(product.items)}
                  aria-haspopup="dialog"
                >
                  {product.title}
                </button>
              </h3>
              <p class="home-product-desc">{product.description}</p>
              <p class="home-product-cue">{product.kitchenUse}</p>
              <div class="home-product-footer">
                <button
                  class="home-product-details-link"
                  type="button"
                  data-quickview-trigger
                  data-quickview-title={product.title}
                  data-quickview-description={product.description}
                  data-quickview-items={JSON.stringify(product.items)}
                  aria-haspopup="dialog"
                >
                  View varieties
                </button>
                <a
                  class="home-product-wa"
                  href={ask(product.enquiry)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Enquire <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
        </div>
      </div>

      <div class="home-products-empty" id="home-products-empty" hidden>
        <p id="home-products-empty-text">No product categories matched your search.</p>
        <div class="home-products-empty-actions">
          <button class="filter-button" type="button" id="home-products-empty-clear">Show all products</button>
          <a class="text-link" href={base + "products/"}>Browse full pantry catalogue →</a>
        </div>
      </div>

      <p class="home-product-note">
        Representative photographs shown. Varieties and pack sizes may vary day to day — message us on WhatsApp to confirm current store stock.
      </p>
    </div>
  </section>

  <!-- 2B. Sourcing & Chekku Craft Highlights -->
  <section class="home-sourcing-band" id="sourcing" aria-labelledby="sourcing-title">
    <div class="container">
      <div class="home-sourcing-header">
        <div>
          <p class="eyebrow">Clean Pantry Standards · Pure Kitchen Craft</p>
          <h2 id="sourcing-title">Why Perambur Families <em>Trust Our Shelves</em></h2>
        </div>
        <a class="text-link" href={base + "perambur-millet-store/"}>Explore our grain &amp; oil guide →</a>
      </div>
      <div class="home-sourcing-grid">
        {sourcingHighlights.map((item) => (
          <article class="home-sourcing-item">
            <span class="home-sourcing-num">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Craftsmanship, Store Photography & Perambur Reviews -->
  <section class="home-story-band" id="story" aria-labelledby="story-title">
    <div class="container">
      <div class="home-story-layout">
        <aside class="home-emblem-card">
          <button
            class="home-emblem-btn"
            type="button"
            data-ehp-dialog="story"
            aria-label="Read the Eshwar Home Products story"
            aria-haspopup="dialog"
          >
            <img
              src={base + "images/brand/eshwar-home-products-logo-400.webp"}
              alt="Official Eshwar Home Products emblem with Rudraksha bead, golden Trishuls, Damrus and lemons"
              width="200"
              height="200"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </button>
          <p class="home-emblem-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p>
          <p class="home-emblem-sub">Named in devotion to Eshwaran</p>
          <a class="home-emblem-rating" href={mapsUrl} target="_blank" rel="noopener noreferrer">
            <span class="five-stars-reveal" aria-hidden="true">★★★★★</span>
            <span>5.0 Google Maps · Perambur</span>
          </a>
        </aside>

        <div class="home-story-content">
          <p class="home-dark-eyebrow">Our Story · Perambur, Chennai</p>
          <h2 id="story-title">Rooted in devotion, serving everyday kitchens.</h2>
          <p>
            Eshwar Home Products is named with devotion after our family deity, Eshwaran (Lord Shiva). That connection is reflected in our Rudraksha and Trishul emblem and in the care we bring to everyday household staples: honesty, gratitude, and personal guidance when you need help choosing.
          </p>
          <div class="home-story-actions">
            <a class="home-dark-link" href={base + "about/"}>Read Our Story <span aria-hidden="true">→</span></a>
            <a class="home-dark-link" href="#customer-stories">Read Customer Stories <span aria-hidden="true">↓</span></a>
          </div>

          <div class="home-gallery-strip" aria-label="Photographs inside Eshwar Home Products">
            <a class="home-gallery-tile" href={base + "products/#pantry-shelves"}>
              <picture>
                <source type="image/webp" srcset={`${base}images/business/EHP_Products1-480.webp 480w, ${base}images/business/EHP_Products1-767.webp 767w`} sizes="(max-width: 768px) 50vw, 24vw" />
                <img src={base + "images/business/EHP_Products1.jpeg"} alt="Pantry shelves inside Eshwar Home Products, Perambur" width="767" height="1280" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </picture>
              <div class="home-gallery-scrim" aria-hidden="true"></div>
              <span>Store Shelves →</span>
            </a>
            <a class="home-gallery-tile" href={base + "products/#pantry-shelves"}>
              <picture>
                <source type="image/webp" srcset={`${base}images/business/EHP_Products2-480.webp 480w, ${base}images/business/EHP_Products2-768.webp 768w`} sizes="(max-width: 768px) 50vw, 24vw" />
                <img src={base + "images/business/EHP_Products2.jpeg"} alt="Traditional rice and millet packs at Eshwar Home Products" width="960" height="1600" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </picture>
              <div class="home-gallery-scrim" aria-hidden="true"></div>
              <span>Pantry Range →</span>
            </a>
            <a class="home-gallery-tile" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              <picture>
                <source type="image/webp" srcset={`${base}images/business/EHP_Shop_Front_View-480.webp 480w, ${base}images/business/EHP_Shop_Front_View-768.webp 768w`} sizes="(max-width: 768px) 100vw, 24vw" />
                <img src={base + "images/business/EHP_Shop_Front_View.jpeg"} alt="Front view of Eshwar Home Products in Perambur" width="1288" height="966" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </picture>
              <div class="home-gallery-scrim" aria-hidden="true"></div>
              <span>Visit Storefront ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Customer Stories -->
  {reviews.length > 0 && (
    <section class="home-stories-section" id="customer-stories" aria-labelledby="customer-stories-title">
      <div class="container">
        <div class="home-stories-header">
          <div class="home-stories-heading">
            <p class="eyebrow">Community Trust · Perambur</p>
            <h2 id="customer-stories-title">Customer <em>Stories</em></h2>
            <p class="home-stories-lede">
              Hear from neighbourhood households across Perambur, Sembium, and North Chennai who rely on our pantry for everyday rice, millets, and wood-pressed oils.
            </p>
          </div>
          <div class="home-stories-proof">
