---
import SiteLayout from "../layouts/SiteLayout.astro";
import catalogue from "../data/catalogue.json";
const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/search/?api=1&query=Door%20No.%20119%2F1%2C%20Nelvayal%20Road%2C%20Perambur%2C%20Chennai%20600011";
const whatsappUrl = "https://wa.me/919941209953?text=Hello%20Eshwar%20Home%20Products%2C%20I%20would%20like%20to%20enquire%20about%20your%20products.";
---
<SiteLayout title="Traditional Foods & Millets in Perambur, Chennai | Eshwar Home Products" description="Explore millet products, traditional rice, millet flours and everyday pantry essentials at Eshwar Home Products, Nelvayal Road, Perambur, Chennai." current="home">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="container home-hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-mark"></span> A neighbourhood pantry · Perambur, Chennai</p>
          <p class="hero-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p>
          <h1 id="home-title">Traditional foods.<br /><em>Everyday essentials.</em></h1>
          <p class="hero-intro">A local place to explore traditional rice, millets, millet flours and familiar pantry ingredients. Visit our Perambur store or contact us to ask about current varieties and availability.</p>
          <div class="hero-actions">
            <a class="home-button home-button-primary" href={base + "products/"}>Explore the pantry <span aria-hidden="true">↗</span></a>
            <a class="home-button home-button-secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Enquire on WhatsApp <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-footnote">Store catalogue · Product availability confirmed directly by our team</p>
        </div>
        <div class="hero-visual" aria-label="Illustrations representing the store's pantry categories">
          {catalogue.groups.slice(0, 3).map((group, index) => (
            <figure class={"hero-tile hero-tile-" + (index + 1)}>
              <img src={base + group.placeholderImage} alt={group.placeholderAlt} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
              <figcaption><span>0{index + 1}</span>{group.title}</figcaption>
            </figure>
          ))}
          <span class="hero-visual-note">A guide to our shelves</span>
        </div>
      </div>
    </section>

    <section class="home-facts" aria-label="Store highlights">
      <div class="container home-facts-grid">
        <div><span class="fact-number">01</span><strong>Traditional rice<br />& millets</strong></div>
        <div><span class="fact-number">02</span><strong>Millet flours<br />& pantry foods</strong></div>
        <div><span class="fact-number">03</span><strong>Cooking oils,<br />ghee & dairy</strong></div>
        <div><span class="fact-number">04</span><strong>Honey, pulses<br />& more</strong></div>
      </div>
    </section>

    <section class="home-categories section container" id="pantry" aria-labelledby="pantry-title">
      <div class="home-section-heading">
        <div><p class="eyebrow">Explore the collection</p><h2 id="pantry-title">A pantry with <em>tradition.</em></h2></div>
        <p>Browse the broad categories below. For exact varieties, pack sizes and current stock, please contact the store before visiting.</p>
      </div>
      <div class="home-category-grid">
        {catalogue.groups.map((group, index) => (
          <a class="home-category-card" href={base + "products/#" + group.id}>
            <div class="home-category-image">
              <img src={base + group.placeholderImage} alt={group.placeholderAlt} loading="lazy" decoding="async" />
              <span class="home-category-index">0{index + 1}</span>
              <span class="home-category-arrow" aria-hidden="true">↗</span>
            </div>
            <div class="home-category-copy">
              <p class="eyebrow">{group.eyebrow}</p>
              <h3>{group.title}</h3>
              <p>{group.description}</p>
              <span class="home-category-link">Explore category <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
      <div class="home-section-end"><a class="home-text-link" href={base + "products/"}>View the complete pantry catalogue <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="home-story">
      <div class="container home-story-grid">
        <div class="home-story-label"><p class="eyebrow">A little about Eshwar</p><span lang="ta">நம் ஊர் · நம் உணவு</span></div>
        <div class="home-story-copy">
          <h2>Good food starts with<br /><em>the ingredients you choose.</em></h2>
          <p>Eshwar Home Products brings together traditional foods and familiar pantry essentials for homes in and around Perambur. Our store categories include traditional rice, Siruthaniyam, millet flours, Chekku oils and everyday pantry ingredients.</p>
          <p>Use this website to get familiar with the broad range, then speak with our team about the exact item you need. Product names, brands, pack sizes and availability can change, so we confirm those details directly rather than displaying unverified information online.</p>
          <a class="home-text-link" href={base + "about/"}>Read our story <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="home-guide section container" aria-labelledby="home-guide-title">
      <div class="home-section-heading home-guide-heading">
        <div><p class="eyebrow">A neighbourhood pantry in Chennai</p><h2 id="home-guide-title">A closer look at <em>our shelves.</em></h2></div>
        <p>Here is a useful starting point if you are planning a pantry visit or looking for a particular ingredient in Perambur.</p>
      </div>
      <div class="home-guide-grid">
        <article><span class="guide-number">01</span><div><p class="eyebrow">Traditional grains</p><h3>Rice and millets</h3><p>Our pantry range includes traditional rice varieties and millet grains, also known as Siruthaniyam. These ingredients are used in many kinds of home cooking. If you have a particular grain in mind, contact the store and ask for the variety currently available. We recommend checking before travelling, especially when you are looking for a specific type.</p></div></article>
        <article><span class="guide-number">02</span><div><p class="eyebrow">Everyday cooking</p><h3>Millet flours and meal options</h3><p>You can also ask about millet flours and other millet-based pantry choices. The range may include items used for home recipes, quick meals and snacks. Names, brands and pack sizes can vary, so please confirm the details directly with our team rather than relying on a general category description.</p></div></article>
        <article><span class="guide-number">03</span><div><p class="eyebrow">Kitchen essentials</p><h3>Cooking oils, ghee and dairy</h3><p>Our store categories also cover cooking essentials such as cold-pressed Chekku oils, ghee and dairy products. If you are looking for gingelly, groundnut or coconut oil, ask us about the current options and pack sizes. We can help you check what is listed and available at the time of your enquiry.</p></div></article>
        <article><span class="guide-number">04</span><div><p class="eyebrow">Pantry cupboard</p><h3>Honey, pulses, nuts and more</h3><p>For a wider pantry shop, ask about categories such as honey, pulses, dry fruits, nuts and Sathumaavu, a traditional mix category. The catalogue is intended as a starting point for your enquiry. It does not promise that every item or variety is in stock on every day.</p></div></article>
      </div>
    </section>

    <section class="home-visit" aria-labelledby="home-visit-title">
      <div class="container home-visit-grid">
        <div class="home-visit-heading"><p class="eyebrow">Find us in Perambur</p><h2 id="home-visit-title">A local store.<br /><em>A simple visit.</em></h2></div>
        <div class="home-visit-copy">
          <p>If you are making a special trip, contact Eshwar Home Products before setting out. Tell us the ingredient or category you are looking for. For a useful answer, include the variety or pack size if you know it. Our team can confirm the latest information available from the store.</p>
          <p>The shop is at Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011. Store hours are Monday to Saturday, 10:00 AM to 9:00 PM, and Sunday, 10:00 AM to 2:00 PM. Hours may change on special days, so call if you are unsure.</p>
          <p>Call <a href="tel:+919941209953">+91 99412 09953</a> or send a message through WhatsApp. You can also use the directions link to plan your route. This website is a guide to our physical store and product categories, not an online checkout or live stock system.</p>
          <div class="home-visit-actions"><a class="home-button home-button-primary" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a><a class="home-text-link" href={base + "contact/"}>Contact and opening hours <span aria-hidden="true">↗</span></a></div>
        </div>
      </div>
    </section>

    <section class="home-faq section container" aria-labelledby="home-faq-title">
      <div class="home-section-heading"><div><p class="eyebrow">Before you shop</p><h2 id="home-faq-title">A few helpful <em>answers.</em></h2></div><p>Need more detail? Our team can help confirm product information directly.</p></div>
      <div class="home-faq-list">
        <details><summary>Can I see live product stock on this website?</summary><p>No. The website provides an overview of the store and its product categories. Stock and varieties can change. Please call or message the store to confirm current availability.</p></details>
        <details><summary>Can I ask about a specific millet or rice variety?</summary><p>Yes. Contact us with the name of the variety you need. If you know the preferred pack size, include that too so the team can check the relevant details.</p></details>
        <details><summary>Where is Eshwar Home Products located?</summary><p>We are at Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011, India.</p></details>
        <details><summary>How can I contact the store?</summary><p>Call +91 99412 09953 or use the WhatsApp enquiry link on this page. For directions, open the Google Maps link in the store information section.</p></details>
      </div>
    </section>

    <section class="home-share" aria-label="Share this page">
      <div class="container home-share-inner">
        <div><p class="eyebrow">Know someone nearby?</p><strong>Share Eshwar Home Products.</strong></div>
        <nav aria-label="Share Eshwar Home Products">
          <a href="https://wa.me/?text=Eshwar%20Home%20Products%20in%20Perambur%2C%20Chennai%3A%20https%3A%2F%2Fstartupintelligence.github.io%2Feshwar-home-products%2F" target="_blank" rel="noopener noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
          <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fstartupintelligence.github.io%2Feshwar-home-products%2F" target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a>
          <a href="https://twitter.com/intent/tweet?url=https%3A%2F%2Fstartupintelligence.github.io%2Feshwar-home-products%2F&text=Eshwar%20Home%20Products%20in%20Perambur%2C%20Chennai" target="_blank" rel="noopener noreferrer">X <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </section>
  </div>
</SiteLayout>
