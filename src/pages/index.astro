---
import SiteLayout from "../layouts/SiteLayout.astro";
import reviewData from "../data/reviews.json";
const reviews = reviewData as Array<{ reviewer: string; text: string; source: "Google Maps" | "Justdial"; rating?: number }>;
import "../styles/home-editorial.css";
import "../styles/story-theme2.css";
import "../styles/mobile-responsive.css";
const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu&g_ep=EgoyMDI2MTExNS4wIKXMDSoASAFQAw%3D%3D";
const whatsappUrl = "https://wa.me/919941209953";
const ask = (item: string) => whatsappUrl + "?text=" + encodeURIComponent("Hello Eshwar Home Products, please help me check today's availability and pack sizes for " + item + ".");
const categories = [
  { title: "Grains & Millets", symbol: "✳", item: "grains and millets" },
  { title: "Oils & Ghee", symbol: "◒", item: "oils and ghee" },
  { title: "Pulses & Dals", symbol: "❋", item: "pulses and dals" },
  { title: "Dry Fruits & Nuts", symbol: "❖", item: "dry fruits and nuts" },
  { title: "Millet Snacks", symbol: "✦", item: "millet snacks" },
  { title: "More Pantry", symbol: "▦", item: "other pantry essentials" }
];
const products = [
  { title: "Traditional Rice", image: "category-traditional-rice.svg", alt: "Illustration of traditional rice varieties", enquiry: "traditional rice varieties", description: "Explore traditional rice varieties and ask the store about current options.", items: ["Traditional rice varieties"] },
  { title: "Whole Millets", image: "rice-millets.webp", alt: "Illustration of millet grains and rice", enquiry: "whole millets and millet varieties", description: "Whole millet varieties listed in the store pantry guide.", items: ["Thinai · Foxtail millet", "Varagu · Kodo millet", "Samai · Little millet", "Kuthiraivali · Barnyard millet", "Ragi · Finger millet", "Kambu · Pearl millet"] },
  { title: "Cold-Pressed Oils", image: "oils-ghee.webp", alt: "Illustration of cold-pressed oils and ghee", enquiry: "cold-pressed oils", description: "Traditional wood-pressed oils listed in the store pantry guide.", items: ["Wood-pressed gingelly oil", "Wood-pressed groundnut oil", "Wood-pressed coconut oil"] },
  { title: "Pure Ghee & Honey", image: "category-ghee-dairy.svg", alt: "Illustration of ghee and dairy products", enquiry: "ghee and honey", description: "Ghee and wild honey are included in the store pantry guide. Contact the store to confirm current availability.", items: ["Ghee", "Wild honey"] }
];
---
<SiteLayout title="Eshwar Home Products | Millets & Pantry Store in Perambur" description="Shop traditional rice, Siruthaniyam millets, millet flours & cold-pressed oils at Eshwar Home Products in Perambur, Chennai." current="home" preloadHomeHero>
  <section class="ehp-home-hero" aria-labelledby="home-title">
    <div class="ehp-hero-main container">
      <div class="ehp-hero-copy">
        <p class="ehp-gold-eyebrow">PURE · NATURAL · TRADITIONAL · PERAMBUR</p>
        <h1 id="home-title">Traditional Rice, Millets &amp;<br /><em>Pantry Essentials</em></h1>
        <p class="ehp-hero-lede">Traditional foods for everyday kitchens, thoughtfully chosen. Explore familiar staples and pantry essentials at your neighbourhood store in Perambur.</p>
        <a class="ehp-gold-button" href={base + "products/"}>Explore Our Pantry <span aria-hidden="true">→</span></a>
        <button class="ehp-hero-address ehp-store-trigger" type="button" data-ehp-dialog="store" aria-haspopup="dialog">119/1, Paddy Field Road · Chinnaiyan Colony, Perambur, Chennai</button>
      </div>
      <figure class="ehp-hero-visual">
        <a class="ehp-hero-image-link" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Eshwar Home Products in Google Maps">
          <picture>
            <source type="image/webp" srcset={`${base}images/business/EHP_Shop_Front_View-480.webp 480w, ${base}images/business/EHP_Shop_Front_View-768.webp 768w, ${base}images/business/EHP_Shop_Front_View-1280.webp 1280w`} sizes="(max-width: 900px) 100vw, 50vw" />
            <img src={base + "images/business/EHP_Shop_Front_View.jpeg"} alt="Eshwar Home Products storefront in Perambur, Chennai. Open the store location in Google Maps." width="1288" height="966" fetchpriority="high" loading="eager" decoding="async" />
          </picture>
        </a>
      </figure>
    </div>
    <div class="ehp-category-band">
      <nav class="ehp-category-strip container" aria-label="Explore pantry categories">
        {categories.map((category) => <a class="ehp-category-link" href={ask(category.item)} data-ehp-dialog="product" data-ehp-title={category.title} data-ehp-description={category.item + " · Ask the store about current options and pack sizes."} data-ehp-items={JSON.stringify([category.item])} aria-haspopup="dialog"><span class="ehp-category-icon" aria-hidden="true">{category.symbol}</span><span>{category.title}</span></a>)}
      </nav>
    </div>
    <svg class="ehp-cream-arch" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H1440V22C1180 112 260 112 0 22Z" fill="#F3F5F3" /></svg>
  </section>

  <section class="pantry-ticker" aria-label="Everyday pantry selections" tabindex="0">
    <div class="pantry-ticker-track">
      <ul class="pantry-ticker-group" aria-label="Pantry categories and products">
        <li class="pantry-ticker-item">Traditional rice varieties <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Millet varieties <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Millet flours <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Flakes, vermicelli &amp; pasta <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Millet cookies <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Cold-pressed oils <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Ghee &amp; dairy <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Honey, pulses, dry fruits &amp; nuts <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Health mix (Sathumaavu) <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Mudavattukal Kilangu</li>
      </ul>
      <ul class="pantry-ticker-group" aria-hidden="true">
        <li class="pantry-ticker-item">Traditional rice varieties <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet varieties <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet flours <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Flakes, vermicelli &amp; pasta <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet cookies <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Cold-pressed oils <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Ghee &amp; dairy <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Honey, pulses, dry fruits &amp; nuts <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Health mix (Sathumaavu) <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Mudavattukal Kilangu</li>
      </ul>
    </div>
  </section>

  <section class="ehp-products-section" aria-labelledby="products-title">
    <div class="container">
      <header class="ehp-products-heading"><p class="ehp-section-kicker">A THOUGHTFUL PANTRY</p><h2 id="products-title">Our Products</h2><p>Natural. Nutritious. Trusted. <span>119/1, Paddy Field Road, Chinnaiyan Colony, Perambur</span></p></header>
      <div class="ehp-product-grid">
        {products.map((product) => <article class="ehp-product-card pantry-interactive-card">
          <button class="ehp-product-card-trigger" type="button" data-quickview-trigger data-quickview-title={product.title} data-quickview-description={product.description} data-quickview-items={JSON.stringify(product.items)} aria-haspopup="dialog" aria-label={`View details for ${product.title}`}><span class="visually-hidden">View details for {product.title}</span></button>
          <figure><img src={base + "images/placeholders/" + product.image} alt={product.alt} width="420" height="315" loading="lazy" decoding="async" /></figure>
          <div class="ehp-product-card-copy"><h3>{product.title}</h3><a class="ehp-product-enquiry" href={ask(product.enquiry)} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp enquiry about ${product.title}`}><span aria-hidden="true">↗</span></a></div>
        </article>)}
      </div>
      <p class="ehp-product-note">Food and product images are illustrative and may not show the exact item or packaging in store. Please contact the store to confirm current varieties, pack sizes and availability.</p>
    </div>
  </section>

  <section class="ehp-trust-band" aria-label="Store highlights"><div class="container ehp-trust-grid">
    <div><span aria-hidden="true">✧</span><p>Traditional<br />Staples</p></div>
    <a class="reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span><p>5.0 Rated on<br />Google Maps · Perambur</p></a>
    <button class="ehp-trust-store-trigger" type="button" data-ehp-dialog="store" aria-haspopup="dialog"><span aria-hidden="true">◷</span><p>Mon–Sat<br />9:00 AM – 9:00 PM · Sun: Closed</p></button>
    <a href={ask("your pantry requirements")} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">↗</span><p>Direct WhatsApp<br />Support</p></a>
  </div></section>

  {reviews.length > 0 && <section class="ehp-reviews-section" aria-labelledby="reviews-title">
    <div class="container">
      <header class="ehp-reviews-heading"><p class="ehp-section-kicker">CUSTOMER WORDS · PERAMBUR</p><h2 id="reviews-title">Loved by Perambur Families</h2><p>Selected customer feedback shared on our public review profiles.</p></header>
      <div class="ehp-reviews-grid">
        {reviews.map((review) => <article class="ehp-review-card">
          <p class="ehp-review-source">{review.source}{review.rating ? ` · ${review.rating.toFixed(1)} ★` : ""}</p>
          <blockquote>{review.text}</blockquote>
          <p class="ehp-reviewer">— {review.reviewer}</p>
        </article>)}
      </div>
      <nav class="ehp-review-links" aria-label="Verify customer reviews">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Read reviews on Google Maps ↗</a>
        <a href="https://www.justdial.com/Chennai/Eshwar-Home-Products-Perambur/044PXX44-XX44-230926121128-L4A9_BZDET" target="_blank" rel="noopener noreferrer">View our Justdial profile ↗</a>
      </nav>
    </div>
  </section>}

  <section class="ehp-story-home" aria-labelledby="story-title"><div class="container ehp-story-grid">
    <aside class="ehp-story-proof"><div class="ehp-story-proof-inner"><button class="ehp-emblem-trigger" type="button" data-ehp-dialog="story" aria-label="Read the Eshwar Home Products brand story" aria-haspopup="dialog"><img class="ehp-story-logo ehp-story-logo-cream" src={base + "images/brand/eshwar-home-products-logo.png"} alt="Official Eshwar Home Products emblem with a Rudraksha bead, golden Trishuls, Damrus and lemons" width="320" height="320" loading="lazy" decoding="async" /></button><p class="ehp-story-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p><p class="ehp-story-english">ESHWAR HOME PRODUCTS</p><p class="ehp-story-origin">Named in devotion to Eshwaran · Perambur, Chennai</p><a class="ehp-google-rating reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="5.0 star rated on Google Maps in Perambur"><strong>5.0</strong><span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span><span class="ehp-google-rating-label">Rated on Google Maps · Perambur</span></a></div></aside>
    <div class="ehp-story-copy"><p class="ehp-story-eyebrow">OUR STORY · PERAMBUR, CHENNAI</p><h2 id="story-title">Rooted in devotion, serving everyday kitchens.</h2><p>Eshwar Home Products is named with devotion after our family deity, Eshwaran (Lord Shiva). That connection is reflected in the store’s Rudraksha and Trishul emblem, and in the values we bring to everyday household staples: honesty, gratitude and care.</p><p>At our store on Paddy Field Road, Chinnaiyan Colony, Perambur, explore traditional rice varieties, whole millets (<em>Siruthaniyam</em>), millet flours, cold-pressed oils, ghee and other pantry essentials. Our team is here to offer personal guidance when you need help choosing.</p><a class="ehp-story-link" href={base + "about/"} data-ehp-dialog="story" aria-haspopup="dialog">Read Our Story <span aria-hidden="true">→</span></a></div>
  </div></section>


  <section class="ehp-local-guide" aria-labelledby="local-guide-title">
    <div class="container ehp-local-guide-inner">
      <p class="ehp-section-kicker">A NEIGHBOURHOOD PANTRY · PERAMBUR</p>
      <h2 id="local-guide-title">A thoughtful place for traditional foods in Perambur</h2>
      <div class="ehp-local-guide-grid">
        <article><h3>1. Traditional Grains &amp; Millets</h3><p>Explore traditional rice, whole millets (<em>Siruthaniyam</em>) and millet flours. Ask us about the varieties currently available.</p></article>
        <article><h3>2. Cold-Pressed Oils &amp; Ghee</h3><p>Browse cold-pressed oils and ghee for everyday cooking. Contact the store to confirm current options.</p></article>
        <article><h3>3. Easy WhatsApp Stock Check</h3><p>Message us to check today's stock, brands and pack sizes before you visit.</p></article>
      </div>
      <div class="ehp-local-faq" aria-labelledby="local-faq-title">
        <h2 id="local-faq-title">Quick questions before you visit</h2>
        <div class="ehp-local-faq-list">
          <details name="ehp-home-faq"><summary>Where is Eshwar Home Products?</summary><p>You can find the store at 119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India. <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Open Google Maps directions</a>.</p></details>
          <details name="ehp-home-faq"><summary>When is the store open?</summary><p>Monday – Saturday: 9:00 AM – 9:00 PM · Sunday: Closed.</p></details>
          <details name="ehp-home-faq"><summary>Can I check a product before visiting?</summary><p>Yes. Message us on WhatsApp to ask about a product, variety or pack size. The website does not show live stock, so please confirm current availability with the store.</p></details>
          <details name="ehp-home-faq"><summary>Does the website show exact product images?</summary><p>Some images are representative illustrations. They help identify a category, but may not show the exact item or packaging currently in store. Contact the team for confirmation.</p></details>
        </div>
      </div>
    </div>
  </section>


  <section class="ehp-category-details" aria-labelledby="ehp-category-details-title">
    <div class="container">
      <p class="ehp-section-kicker">EXPLORE THE EVERYDAY PANTRY</p>
      <h2 id="ehp-category-details-title">Traditional rice, millet flours &amp; cold-pressed oils</h2>
      <p class="ehp-category-details-intro">A good pantry starts with ingredients that suit the way your household cooks. At Eshwar Home Products in Perambur, you can ask about familiar grains, Siruthaniyam varieties and other everyday kitchen essentials in one neighbourhood store. Our catalogue is a starting point; contact us to confirm the exact varieties and packs available on the day.</p>
      <div class="ehp-category-details-grid">
        <article><h3>Traditional rice for familiar meals</h3><p>Explore traditional rice varieties used in everyday meals, rice-based dishes and home cooking. If you have a particular variety in mind, ask the team before visiting. We can help you check the name and current availability, so you can make a more informed choice at the store.</p></article>
        <article><h3>Siruthaniyam millets and millet flours</h3><p>Our pantry range includes whole millets and millet-based products. Ask about Siruthaniyam options and millet flours for the recipes you prepare at home. Names, varieties and pack sizes can differ, so a quick call or WhatsApp message is the easiest way to check what is currently stocked.</p></article>
        <article><h3>Cold-pressed oils and everyday cooking</h3><p>Browse the cold-pressed oils listed in our pantry range alongside ghee and other cooking essentials. If you are comparing oil varieties or looking for a particular pack size, contact the store for current product details. We do not display live inventory or make a promise that every listed item is in stock.</p></article>
        <article><h3>Seeds, nuts and pantry additions</h3><p>Find out about seeds, nuts, pulses, honey and other pantry additions listed in the store catalogue. These ingredients can serve different uses in home kitchens. Ask the team about the product name, pack size and availability before making a special trip for a specific item.</p></article>
      </div>
      <div class="ehp-category-details-visit"><div><h3>Planning a visit to our Perambur store?</h3><p>We are at 119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011. The store is open Monday to Saturday, 9:00 AM to 9:00 PM, and closed on Sunday. Call or message us to check a product before travelling.</p></div><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Get directions to our store ↗</a></div>
    </div>
  </section>

  <section class="ehp-store-gallery" aria-labelledby="store-gallery-title">
    <div class="container">
      <div class="ehp-store-gallery-heading">
        <p class="ehp-gold-eyebrow">A LOOK AROUND OUR STORE</p>
        <h2 id="store-gallery-title">A little closer to Eshwar Home Products.</h2>
        <p>See the store, browse a glimpse of the product range and find us in Perambur.</p>
      </div>
      <div class="ehp-store-gallery-grid">
        <a class="ehp-store-gallery-card ehp-store-gallery-front" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Open Eshwar Home Products in Google Maps">
          <picture><source type="image/webp" srcset={`${base}images/business/EHP_Shop_Front_View-480.webp 480w, ${base}images/business/EHP_Shop_Front_View-768.webp 768w, ${base}images/business/EHP_Shop_Front_View-1280.webp 1280w`} sizes="(max-width: 700px) 100vw, 50vw" /><img src={base + "images/business/EHP_Shop_Front_View.jpeg"} alt="Front view of Eshwar Home Products in Perambur. Open store location in Google Maps." width="1288" height="966" loading="lazy" decoding="async" /></picture>
          <span class="ehp-store-map-caption">Eshwar Home Products · Find our store ↗</span>
        </a>
        <a class="ehp-store-gallery-card" href={base + "products/#pantry-shelves"} aria-label="Browse the Eshwar Home Products pantry catalogue">
          <picture><source type="image/webp" srcset={`${base}images/business/EHP_Products1-480.webp 480w, ${base}images/business/EHP_Products1-767.webp 767w`} sizes="(max-width: 700px) 100vw, 33vw" /><img src={base + "images/business/EHP_Products1.jpeg"} alt="Products photographed at Eshwar Home Products, Perambur" width="767" height="1280" loading="lazy" decoding="async" /></picture>
          <span class="ehp-store-map-caption">Browse our product range →</span>
        </a>
        <a class="ehp-store-gallery-card" href={base + "products/#pantry-shelves"} aria-label="Explore products at Eshwar Home Products">
          <picture><source type="image/webp" srcset={`${base}images/business/EHP_Products2-480.webp 480w, ${base}images/business/EHP_Products2-768.webp 768w, ${base}images/business/EHP_Products2-960.webp 960w`} sizes="(max-width: 700px) 100vw, 33vw" /><img src={base + "images/business/EHP_Products2.jpeg"} alt="More products photographed at Eshwar Home Products, Perambur" width="960" height="1600" loading="lazy" decoding="async" /></picture>
          <span class="ehp-store-map-caption">Explore pantry categories →</span>
        </a>
        <a class="ehp-store-gallery-card ehp-store-map-card" href="https://www.google.com/maps/search/?api=1&query=Eshwar+Home+Products%2C+119%2F1+Paddy+Field+Road%2C+Perambur%2C+Chennai" target="_blank" rel="noopener noreferrer" aria-label="Open Eshwar Home Products location in Google Maps">
          <picture><source type="image/webp" srcset={`${base}images/business/EHP_Map_Small-480.webp 480w, ${base}images/business/EHP_Map_Small-768.webp 768w`} sizes="(max-width: 700px) 100vw, 33vw" /><img src={base + "images/business/EHP_Map_Small.jpeg"} alt="Map reference for the Eshwar Home Products store location" width="1088" height="638" loading="lazy" decoding="async" /></picture>
          <span class="ehp-store-map-caption">Find our store <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="ehp-visit-section" aria-labelledby="visit-title"><div class="container ehp-visit-grid"><div><p class="ehp-gold-eyebrow">VISIT OUR STORE</p><h2 id="visit-title">Good food, close to home.</h2><p>Come by and explore our traditional pantry range in Perambur.</p><button class="ehp-gold-button" type="button" data-ehp-dialog="store" aria-haspopup="dialog">Visit Us <span aria-hidden="true">↗</span></button></div><div class="ehp-visit-details"><div><span>ADDRESS</span><p>119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India</p></div><div><span>OPENING HOURS</span><p>Mon–Sat: 9:00 AM – 9:00 PM<br />Sunday: Closed</p></div><div><span>CALL OR WHATSAPP</span><p><a href="tel:+919941209953">+91 99412 09953</a><br /><a href={ask("your pantry requirements")} target="_blank" rel="noopener noreferrer">Send an enquiry ↗</a></p></div></div></div></section>
</SiteLayout>

<style>
  /* One-shot hero reveal and decorative grain sweep; transform/opacity only. */
  .ehp-home-hero { position: relative; isolation: isolate; overflow: hidden; background: #F3F5F3; }
  .ehp-home-hero::after { content: ""; position: absolute; z-index: 0; inset: 0 auto 0 -110%; width: 110%; pointer-events: none; opacity: 0; background-image: radial-gradient(circle, rgba(190,154,85,.72) 1px, transparent 1.5px), linear-gradient(105deg, transparent 35%, rgba(190,154,85,.08) 46%, rgba(190,154,85,.28) 50%, transparent 62%); background-size: 12px 12px, 100% 100%; animation: ehp-grain-sweep 1.25s ease-out .12s both; }
  .ehp-hero-main { position: relative; z-index: 1; }
  .ehp-hero-copy, .ehp-hero-visual { animation: ehp-hero-reveal .65s cubic-bezier(.2,.7,.2,1) both; }
  .ehp-hero-visual { animation-delay: .08s; }
  @keyframes ehp-hero-reveal { from { opacity: 0; transform: translate3d(0,12px,0); } to { opacity: 1; transform: translate3d(0,0,0); } }
  @keyframes ehp-grain-sweep { 0% { opacity: 0; transform: translate3d(0,0,0); } 18% { opacity: .72; } 100% { opacity: 0; transform: translate3d(205%,0,0); } }
  @media (max-width: 640px), (pointer: coarse) { .ehp-home-hero::after { display: none; animation: none; } }
  @media (prefers-reduced-motion: reduce) { .ehp-home-hero::after, .ehp-hero-copy, .ehp-hero-visual { animation: none !important; opacity: 1; transform: none; } }
  .ehp-category-details { padding: clamp(42px, 6vw, 76px) 0; background: #F3F5F3; }
  .ehp-category-details > .container { max-width: 1120px; }
