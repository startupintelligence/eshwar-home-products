      <ul class="pantry-ticker-group" aria-hidden="true">
        <li class="pantry-ticker-item">Traditional rice varieties <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet varieties <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet flours <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Flakes, vermicelli &amp; pasta <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet cookies <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Cold-pressed oils <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Ghee &amp; dairy <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Honey, pulses, dry fruits &amp; nuts <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Health mix (Sathumaavu) <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Mudavattukal Kilangu</li>
      </ul>
    </div>
  </section>

  <section class="ehp-products-section" aria-labelledby="products-title">
    <div class="container">
      <header class="ehp-products-heading"><p class="ehp-section-kicker">A THOUGHTFUL PANTRY</p><h2 id="products-title">Our Products</h2><p>Natural. Nutritious. Trusted. <span>119/1, Paddy Field Road, Chinnaiyan Colony, Perambur</span></p></header>
      <div class="ehp-product-grid">
        {products.map((product) => <article class="ehp-product-card pantry-interactive-card">
          <button class="ehp-product-card-trigger" type="button" data-quickview-trigger data-quickview-title={product.title} data-quickview-description={product.description} data-quickview-items={JSON.stringify(product.items)} aria-haspopup="dialog" aria-label={`View details for ${product.title}`}><span class="visually-hidden">View details for {product.title}</span></button>
          <figure><img src={base + "images/placeholders/" + product.image} alt={product.alt} width="420" height="420" loading="lazy" decoding="async" /></figure>
          <div class="ehp-product-card-copy"><h3>{product.title}</h3><a class="ehp-product-enquiry" href={ask(product.enquiry)} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp enquiry about ${product.title}`}><span aria-hidden="true">↗</span></a></div>
        </article>)}
      </div>
      <p class="ehp-product-note">Food and product images are illustrative and may not show the exact item or packaging in store. Please contact the store to confirm current varieties, pack sizes and availability.</p>
    </div>
  </section>

  <section class="ehp-trust-band" aria-label="Store highlights"><div class="container ehp-trust-grid">
    <div><span aria-hidden="true">✧</span><p>Traditional<br />Staples</p></div>
    <a class="reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span><p>5.0 Rated on<br />Google Maps · Perambur</p></a>
    <button class="ehp-trust-store-trigger" type="button" data-ehp-dialog="store" aria-haspopup="dialog"><span aria-hidden="true">◷</span><p>Mon–Sat<br />9:00 AM – 9:00 PM · Sun: Closed</p></button>
    <a href={ask("your pantry requirements")} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">↗</span><p>Direct WhatsApp<br />Support</p></a>
  </div></section>

  {reviews.length > 0 && <section class="ehp-reviews-section" aria-labelledby="reviews-title">
    <div class="container">
      <header class="ehp-reviews-heading"><p class="ehp-section-kicker">CUSTOMER WORDS · PERAMBUR</p><h2 id="reviews-title">Loved by Perambur Families</h2><p>Selected customer feedback shared on our public review profiles.</p></header>
      <div class="ehp-reviews-grid">
        {reviews.map((review) => <article class="ehp-review-card">
          <p class="ehp-review-source">{review.source}{review.rating ? ` · ${review.rating.toFixed(1)} ★` : ""}</p>
          <blockquote>{review.text}</blockquote>
          <p class="ehp-reviewer">— {review.reviewer}</p>
        </article>)}
      </div>
      <nav class="ehp-review-links" aria-label="Verify customer reviews">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Read reviews on Google Maps ↗</a>
        <a href="https://www.justdial.com/Chennai/Eshwar-Home-Products-Perambur/044PXX44-XX44-230926121128-L4A9_BZDET" target="_blank" rel="noopener noreferrer">View our Justdial profile ↗</a>
      </nav>
    </div>
  </section>}

  <section class="ehp-story-home" aria-labelledby="story-title"><div class="container ehp-story-grid">
    <aside class="ehp-story-proof"><div class="ehp-story-proof-inner"><button class="ehp-emblem-trigger" type="button" data-ehp-dialog="story" aria-label="Read the Eshwar Home Products brand story" aria-haspopup="dialog"><img class="ehp-story-logo ehp-story-logo-cream" src={base + "images/brand/eshwar-home-products-logo.png"} alt="Official Eshwar Home Products emblem with a Rudraksha bead, golden Trishuls, Damrus and lemons" width="320" height="320" loading="lazy" decoding="async" /></button><p class="ehp-story-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p><p class="ehp-story-english">ESHWAR HOME PRODUCTS</p><p class="ehp-story-origin">Named in devotion to Eshwaran · Perambur, Chennai</p><a class="ehp-google-rating reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="5.0 star rated on Google Maps in Perambur"><strong>5.0</strong><span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span> Rated on Google Maps · Perambur</a></div></aside>
    <div class="ehp-story-copy"><p class="ehp-story-eyebrow">OUR STORY · PERAMBUR, CHENNAI</p><h2 id="story-title">Rooted in devotion, serving everyday kitchens.</h2><p>Eshwar Home Products is named with devotion after our family deity, Eshwaran (Lord Shiva). That connection is reflected in the store’s Rudraksha and Trishul emblem, and in the values we bring to everyday household staples: honesty, gratitude and care.</p><p>At our store on Paddy Field Road, Chinnaiyan Colony, Perambur, explore traditional rice varieties, whole millets (<em>Siruthaniyam</em>), millet flours, cold-pressed oils, ghee and other pantry essentials. Our team is here to offer personal guidance when you need help choosing.</p><a class="ehp-story-link" href={base + "about/"} data-ehp-dialog="story" aria-haspopup="dialog">Read Our Story <span aria-hidden="true">→</span></a></div>
  </div></section>


  <section class="ehp-local-guide" aria-labelledby="local-guide-title">
    <div class="container ehp-local-guide-inner">
      <p class="ehp-section-kicker">A NEIGHBOURHOOD PANTRY · PERAMBUR</p>
      <h2 id="local-guide-title">A thoughtful place for traditional foods in Perambur</h2>
      <div class="ehp-local-guide-grid">
        <article><h3>1. Traditional Grains &amp; Millets</h3><p>Explore traditional rice, whole millets (<em>Siruthaniyam</em>) and millet flours. Ask us about the varieties currently available.</p></article>
        <article><h3>2. Cold-Pressed Oils &amp; Ghee</h3><p>Browse cold-pressed oils and ghee for everyday cooking. Contact the store to confirm current options.</p></article>
        <article><h3>3. Easy WhatsApp Stock Check</h3><p>Message us to check today's stock, brands and pack sizes before you visit.</p></article>
      </div>
      <div class="ehp-local-faq" aria-labelledby="local-faq-title">
        <h2 id="local-faq-title">Quick questions before you visit</h2>
        <article><h3>Where is Eshwar Home Products?</h3><p>You can find the store at 119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India. Open the map directions from the Visit Our Store section.</p></article>
        <article><h3>When is the store open?</h3><p>Monday – Saturday: 9:00 AM – 9:00 PM · Sunday: Closed.</p></article>
        <article><h3>Can I check a product before visiting?</h3><p>Yes. Message us on WhatsApp to ask about a product, variety or pack size. The website does not show live stock, so please confirm current availability with the store.</p></article>
        <article><h3>Does the website show exact product images?</h3><p>Some images are representative illustrations. They help identify a category, but may not show the exact item or packaging currently in store. Contact the team for confirmation.</p></article>
      </div>
    </div>
  </section>

  <section class="ehp-visit-section" aria-labelledby="visit-title"><div class="container ehp-visit-grid"><div><p class="ehp-gold-eyebrow">VISIT OUR STORE</p><h2 id="visit-title">Good food, close to home.</h2><p>Come by and explore our traditional pantry range in Perambur.</p><button class="ehp-gold-button" type="button" data-ehp-dialog="store" aria-haspopup="dialog">Visit Us <span aria-hidden="true">↗</span></button></div><div class="ehp-visit-details"><div><span>ADDRESS</span><p>119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India</p></div><div><span>OPENING HOURS</span><p>Mon–Sat: 9:00 AM – 9:00 PM<br />Sunday: Closed</p></div><div><span>CALL OR WHATSAPP</span><p><a href="tel:+919941209953">+91 99412 09953</a><br /><a href={ask("your pantry requirements")} target="_blank" rel="noopener noreferrer">Send an enquiry ↗</a></p></div></div></div></section>

  <script is:inline>
    (() => {
      const hero = document.querySelector('.ehp-home-hero');
      const canvas = hero?.querySelector('.ehp-wind-canvas');
      const revealItems = hero ? Array.from(hero.querySelectorAll('[data-ehp-reveal]')) : [];
      if (!hero || !canvas || !revealItems.length) return;

      const motionPreference = window.matchMedia?.('(prefers-reduced-motion: reduce)');
      if (motionPreference?.matches) return;

      let context;
      try { context = canvas.getContext('2d', { alpha: true }); } catch { context = null; }
      if (!context) return;

      const root = document.documentElement;
      const particles = [];
      let width = 0;
      let height = 0;
      let pixelRatio = 1;
      let frameId = 0;
      let resizeObserver = null;
      let startTime = 0;
      let lastTime = 0;
      let finished = false;
      const duration = 2800;
      const count = window.matchMedia('(max-width: 767px)').matches ? 36 : 80;
      const goldTones = ['218,178,108', '235,206,148', '194,152,82'];

      const resizeCanvas = () => {
        const rect = hero.getBoundingClientRect();
        const nextWidth = Math.max(1, rect.width);
        const nextHeight = Math.max(1, rect.height);
        const scaleX = width ? nextWidth / width : 1;
        const scaleY = height ? nextHeight / height : 1;
        width = nextWidth;
        height = nextHeight;
        pixelRatio = Math.min(window.devicePixelRatio || 1, 1.35);
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        canvas.style.width = width + 'px';
        canvas.style.height = height + 'px';
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        particles.forEach((particle) => {
          particle.x *= scaleX;
          particle.y *= scaleY;
          particle.speed = width * particle.speedRatio / (duration / 1000);
        });
      };

      for (let index = 0; index < count; index += 1) {
        particles.push({
          x: 0,
          y: 0,
          radius: Math.random() * 2.4 + 1.1,
          speedRatio: Math.random() * 0.38 + 0.58,
          speed: 0,
          drift: -(Math.random() * 54 + 24),
          phase: Math.random() * Math.PI * 2,
          tone: goldTones[Math.floor(Math.random() * goldTones.length)]
        });
      }

      const finish = () => {
        if (finished) return;
        finished = true;
        if (frameId) cancelAnimationFrame(frameId);
        resizeObserver?.disconnect();
        window.removeEventListener('resize', resizeCanvas);
        canvas.classList.add('is-fading');
        window.setTimeout(() => {
          root.classList.remove('ehp-hero-anim-ready');
          revealItems.forEach((item) => item.classList.remove('is-visible'));
          canvas.remove();
        }, 520);
      };

      try {
        resizeCanvas();
        particles.forEach((particle) => {
          particle.x = Math.random() * width * 0.62 - width * 0.24;
          particle.y = Math.random() * height * 0.78 + height * 0.18;
          particle.speed = width * particle.speedRatio / (duration / 1000);
        });
        root.classList.add('ehp-hero-anim-ready');
        if ('ResizeObserver' in window) {
          resizeObserver = new ResizeObserver(resizeCanvas);
          resizeObserver.observe(hero);
        } else {
          window.addEventListener('resize', resizeCanvas, { passive: true });
        }

        const reveal = () => revealItems.forEach((item) => item.classList.add('is-visible'));
        requestAnimationFrame(() => requestAnimationFrame(reveal));

        const draw = (timestamp) => {
          if (!startTime) startTime = timestamp;
          const delta = lastTime ? Math.min((timestamp - lastTime) / 1000, 0.05) : 0;
          lastTime = timestamp;
          const elapsed = timestamp - startTime;
          context.clearRect(0, 0, width, height);

          // Fine curved gust lines establish the wind direction before the heavier grains pass.
          context.lineCap = 'round';
          for (let band = 0; band < 3; band += 1) {
            const sweep = (elapsed * 0.00034 + band * 0.31) % 1.35;
            const startX = -width * 0.12 + sweep * width * 0.42;
            const startY = height * (0.76 - band * 0.13);
            context.beginPath();
            context.moveTo(startX, startY);
            context.bezierCurveTo(startX + width * 0.18, startY - height * 0.2, startX + width * 0.34, startY - height * 0.08, startX + width * 0.56, startY - height * 0.31);
            context.strokeStyle = `rgba(194,152,82,${(0.13 + band * 0.025).toFixed(2)})`;
            context.lineWidth = 1.2 + band * 0.45;
            context.stroke();
          }

          particles.forEach((particle) => {
            particle.x += particle.speed * delta;
            particle.y += (particle.drift + Math.sin(elapsed * 0.003 + particle.phase) * 18) * delta;
            const alpha = 0.42 + Math.abs(Math.sin(elapsed * 0.004 + particle.phase)) * 0.42;
            const tail = particle.radius * (2.2 + particle.speedRatio * 2.4);
            context.beginPath();
            context.moveTo(particle.x - tail, particle.y + tail * 0.48);
            context.lineTo(particle.x + particle.radius * 0.4, particle.y - particle.radius * 0.25);
            context.strokeStyle = `rgba(${particle.tone},${(alpha * 0.72).toFixed(2)})`;
            context.lineWidth = Math.max(0.8, particle.radius * 0.9);
            context.stroke();
            context.beginPath();
            context.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
            context.fillStyle = `rgba(${particle.tone},${alpha.toFixed(2)})`;
            context.fill();
            if (particle.x > width + 12 || particle.y < -12) {
              particle.x = -Math.random() * width * 0.18;
              particle.y = height * (0.45 + Math.random() * 0.65);
            }
          });

          if (elapsed < duration) frameId = requestAnimationFrame(draw);
          else finish();
        };
        frameId = requestAnimationFrame(draw);
        window.setTimeout(finish, duration + 80);
      } catch {
        root.classList.remove('ehp-hero-anim-ready');
        revealItems.forEach((item) => item.classList.remove('is-visible'));
        canvas.remove();
      }
    })();
  </script>

</SiteLayout>

<style>
  /* Homepage product cards: explicit layout, readable labels and touch-sized enquiry control. */
  .ehp-products-section { padding: clamp(48px, 7vw, 84px) 0; background: #FAF8F5; }
  .ehp-products-heading { max-width: 680px; margin: 0 auto 28px; text-align: center; }
  .ehp-products-heading h2 { margin: 8px 0; color: #2A1508; font: 400 clamp(2rem, 4vw, 3rem)/1.12 Georgia, "Times New Roman", serif; }
  .ehp-products-heading > p:last-child { color: #4A3525; font-size: .88rem; line-height: 1.7; }
  .ehp-product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .ehp-emblem-trigger { display:block;width:100%;padding:0;border:0;background:transparent;cursor:pointer; }
  .ehp-store-trigger { border:0;background:transparent;color:inherit;font:inherit;text-align:left;text-decoration:underline;text-underline-offset:3px;cursor:pointer; }
  .ehp-trust-store-trigger { display:flex;align-items:center;justify-content:center;gap:10px;min-width:0;border:0;border-left:1px solid rgba(217,155,38,.38);background:transparent;color:inherit;font:inherit;text-align:center;cursor:pointer; }
  .ehp-trust-store-trigger p { margin:0; }
  .ehp-product-card { position: relative; min-width: 0; overflow: hidden; border: 1px solid #E2D6C5; background: #FFFDF9; }
  .ehp-product-card-trigger { position:absolute; inset:0; z-index:1; width:100%; height:100%; border:0; background:transparent; cursor:pointer; }
  .ehp-product-card-trigger:focus-visible { outline:3px solid #D99B26; outline-offset:-4px; }
