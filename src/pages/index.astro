---
import SiteLayout from "../layouts/SiteLayout.astro";
import reviewData from "../data/reviews.json";
const reviews = reviewData as Array<{ reviewer: string; text: string; source: "Google Maps" | "Justdial"; rating?: number }>;
import "../styles/home-editorial.css";
import "../styles/story-theme2.css";
const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu&g_ep=EgoyMDI2MTExNS4wIKXMDSoASAFQAw%3D%3D";
const whatsappUrl = "https://wa.me/919941209953";
const ask = (item: string) => whatsappUrl + "?text=" + encodeURIComponent("Hello Eshwar Home Products, please help me check today's availability and pack sizes for " + item + ".");
const categories = [
  { title: "Grains & Millets", symbol: "✳", item: "grains and millets" },
  { title: "Oils & Ghee", symbol: "◒", item: "oils and ghee" },
  { title: "Pulses & Dals", symbol: "❋", item: "pulses and dals" },
  { title: "Dry Fruits & Nuts", symbol: "❖", item: "dry fruits and nuts" },
  { title: "Millet Snacks", symbol: "✦", item: "millet snacks" },
  { title: "More Pantry", symbol: "▦", item: "other pantry essentials" }
];
const products = [
  { title: "Traditional Rice", image: "category-traditional-rice.svg", alt: "Representative illustration of traditional rice", enquiry: "traditional rice varieties" },
  { title: "Whole Millets", image: "rice-millets.webp", alt: "Representative millet and rice visual", enquiry: "whole millets and millet varieties" },
  { title: "Cold-Pressed Oils", image: "oils-ghee.webp", alt: "Representative oils and ghee visual", enquiry: "cold-pressed oils" },
  { title: "Pure Ghee & Honey", image: "category-ghee-dairy.svg", alt: "Representative illustration of ghee and dairy", enquiry: "ghee and honey" }
];
---
<SiteLayout title="Eshwar Home Products | Pantry Store in Perambur" description="Explore traditional rice, Siruthaniyam millets, cold-pressed oils and pantry essentials at Eshwar Home Products, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai." current="home">
  <section class="ehp-home-hero" aria-labelledby="home-title">
    <div class="ehp-hero-main container">
      <div class="ehp-hero-copy">
        <p class="ehp-gold-eyebrow">PURE · NATURAL · TRADITIONAL · PERAMBUR</p>
        <h1 id="home-title">Traditional Foods<br /><em>for Everyday Kitchens</em></h1>
        <p class="ehp-hero-lede">Traditional foods for everyday kitchens, thoughtfully chosen. Explore familiar staples and pantry essentials at your neighbourhood store in Perambur.</p>
        <a class="ehp-gold-button" href={base + "products/"}>Explore Our Pantry <span aria-hidden="true">→</span></a>
        <p class="ehp-hero-address">119/1, Paddy Field Rd · Chinnaiyan Colony, Perambur, Chennai</p>
      </div>
      <figure class="ehp-hero-visual">
        <img src={base + "images/placeholders/hero-grain-bowl.svg"} alt="Representative illustration of traditional grains in a wooden bowl" width="520" height="460" fetchpriority="high" decoding="async" />
        <figcaption>Representative visual</figcaption>
      </figure>
    </div>
    <div class="ehp-category-band">
      <nav class="ehp-category-strip container" aria-label="Explore pantry categories">
        {categories.map((category) => <a class="ehp-category-link" href={ask(category.item)} target="_blank" rel="noopener noreferrer"><span class="ehp-category-icon" aria-hidden="true">{category.symbol}</span><span>{category.title}</span></a>)}
      </nav>
    </div>
    <svg class="ehp-cream-arch" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H1440V22C1180 112 260 112 0 22Z" fill="#F5EDE3" /></svg>
  </section>

  <section class="pantry-ticker" aria-label="Everyday pantry selections" tabindex="0">
    <div class="pantry-ticker-track">
      <ul class="pantry-ticker-group" aria-label="Pantry categories and products">
        <li class="pantry-ticker-item">Traditional rice varieties <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Millet varieties <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Millet flours <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Flakes, vermicelli &amp; pasta <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Millet cookies <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Cold-pressed oils <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Ghee &amp; dairy <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Honey, pulses, dry fruits &amp; nuts <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Health mix (Sathumaavu) <span class="pantry-ticker-dot" aria-hidden="true">·</span></li>
        <li class="pantry-ticker-item">Mudavattukal Kilangu</li>
      </ul>
      <ul class="pantry-ticker-group" aria-hidden="true">
        <li class="pantry-ticker-item">Traditional rice varieties <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet varieties <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet flours <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Flakes, vermicelli &amp; pasta <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Millet cookies <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Cold-pressed oils <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Ghee &amp; dairy <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Honey, pulses, dry fruits &amp; nuts <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Health mix (Sathumaavu) <span class="pantry-ticker-dot">·</span></li>
        <li class="pantry-ticker-item">Mudavattukal Kilangu</li>
      </ul>
    </div>
  </section>

  <section class="ehp-products-section" aria-labelledby="products-title">
    <div class="container">
      <header class="ehp-products-heading"><p class="ehp-section-kicker">A THOUGHTFUL PANTRY</p><h2 id="products-title">Our Products</h2><p>Natural. Nutritious. Trusted. <span>119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur</span></p></header>
      <div class="ehp-product-grid">
        {products.map((product) => <article class="ehp-product-card">
          <figure><img src={base + "images/placeholders/" + product.image} alt={product.alt} width="420" height="420" loading="lazy" decoding="async" /><figcaption>Representative visual</figcaption></figure>
          <div class="ehp-product-card-copy"><h3>{product.title}</h3><a class="ehp-product-enquiry" href={ask(product.enquiry)} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp enquiry about ${product.title}`}><span aria-hidden="true">↗</span></a></div>
        </article>)}
      </div>
      <p class="ehp-product-note">Images are representative. Please contact the store to confirm current varieties, pack sizes and availability.</p>
    </div>
  </section>

  <section class="ehp-trust-band" aria-label="Store highlights"><div class="container ehp-trust-grid">
    <div><span aria-hidden="true">✧</span><p>Traditional<br />Staples</p></div>
    <a class="reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer"><span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span><p>5.0 Rated on<br />Google Maps · Perambur</p></a>
    <div><span aria-hidden="true">◷</span><p>Open Mon–Sat<br />9 AM – 9 PM</p></div>
    <a href={ask("your pantry requirements")} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">↗</span><p>Direct WhatsApp<br />Support</p></a>
  </div></section>

  {reviews.length > 0 && <section class="ehp-reviews-section" aria-labelledby="reviews-title">
    <div class="container">
      <header class="ehp-reviews-heading"><p class="ehp-section-kicker">CUSTOMER WORDS · PERAMBUR</p><h2 id="reviews-title">Loved by Perambur Families</h2><p>Selected customer feedback shared on our public review profiles.</p></header>
      <div class="ehp-reviews-grid">
        {reviews.map((review) => <article class="ehp-review-card">
          <p class="ehp-review-source">{review.source}{review.rating ? ` · ${review.rating.toFixed(1)} ★` : ""}</p>
          <blockquote>{review.text}</blockquote>
          <p class="ehp-reviewer">— {review.reviewer}</p>
        </article>)}
      </div>
      <nav class="ehp-review-links" aria-label="Verify customer reviews">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Read reviews on Google Maps ↗</a>
        <a href="https://www.justdial.com/Chennai/Eshwar-Home-Products-Perambur/044PXX44-XX44-230926121128-L4A9_BZDET" target="_blank" rel="noopener noreferrer">View our Justdial profile ↗</a>
      </nav>
    </div>
  </section>}

  <section class="ehp-story-home" aria-labelledby="story-title"><div class="container ehp-story-grid">
    <aside class="ehp-story-proof"><div class="ehp-story-proof-inner"><img class="ehp-story-logo ehp-story-logo-cream" src={base + "images/brand/eshwar-home-products-logo.png"} alt="Official Eshwar Home Products emblem with a Rudraksha bead, golden Trishuls, Damrus and lemons" width="320" height="320" loading="lazy" decoding="async" /><p class="ehp-story-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p><p class="ehp-story-english">ESHWAR HOME PRODUCTS</p><p class="ehp-story-origin">Named in devotion to Eshwaran · Perambur, Chennai</p><a class="ehp-google-rating reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="5.0 star rated on Google Maps in Perambur"><strong>5.0</strong><span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span> Rated on Google Maps · Perambur</a></div></aside>
    <div class="ehp-story-copy"><p class="ehp-story-eyebrow">OUR STORY · PERAMBUR, CHENNAI</p><h2 id="story-title">Rooted in devotion, serving everyday kitchens.</h2><p>Eshwar Home Products is named with devotion after our family deity, Eshwaran (Lord Shiva). That connection is reflected in the store’s Rudraksha and Trishul emblem, and in the values we bring to everyday household staples: honesty, gratitude and care.</p><p>At our store on Paddy Field Rd, Chinnaiyan Colony, Perambur, explore traditional rice varieties, whole millets (<em>Siruthaniyam</em>), millet flours, cold-pressed oils, ghee and other pantry essentials. Our team is here to offer personal guidance when you need help choosing.</p><a class="ehp-story-link" href={base + "about/"}>Read Our Story <span aria-hidden="true">→</span></a></div>
  </div></section>


  <section class="ehp-local-guide" aria-labelledby="local-guide-title">
    <div class="container ehp-local-guide-inner">
      <p class="ehp-section-kicker">A NEIGHBOURHOOD PANTRY · PERAMBUR</p>
      <h2 id="local-guide-title">A thoughtful place for traditional foods in Perambur</h2>
      <p>Traditional Foods for Everyday Kitchens is more than a page heading. It describes the kind of pantry range you can explore at Eshwar Home Products: familiar ingredients, traditional food choices and everyday essentials for households in and around Perambur, Chennai. Visit the store to see the available range, or contact the team before travelling if you are looking for a particular item.</p>
      <div class="ehp-local-guide-grid">
        <article><h3>Rice, millets and flours</h3><p>Explore traditional rice varieties and whole millets, also known as <em>Siruthaniyam</em>. The pantry range also includes millet flours and related staples. If you are comparing varieties or are unsure which ingredient suits a recipe, ask the store team about the options currently available. Names, pack sizes and availability can change, so a quick enquiry is the best way to get current information.</p></article>
        <article><h3>Oils, ghee and pantry basics</h3><p>Browse the store's food categories, including cold-pressed oils, ghee, pulses and dals, honey, dry fruits and nuts. You can also ask about other pantry essentials such as flakes, vermicelli, pasta, millet snacks and health mix (Sathumaavu). Product images on this website are representative visuals, not a live inventory list. Please confirm the brand, pack size and current availability directly with the store.</p></article>
        <article><h3>Help choosing what you need</h3><p>A grocery list can include ingredients you already know as well as items you are trying for the first time. Send a WhatsApp enquiry with the product name or category you have in mind. The team can help you check whether it is available and clarify the pack options before you visit. For a faster reply, include the quantity or type you are looking for, if you know it.</p></article>
        <article><h3>Visit our Perambur store</h3><p>Eshwar Home Products is located at 119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011. The store is open Monday to Saturday, from 9:00 AM to 9:00 PM, and is closed on Sunday. Use the directions link on this page to plan your visit. If you are coming for a specific item, contact the store first to check availability and avoid an unnecessary trip.</p></article>
      </div>
      <div class="ehp-local-faq" aria-labelledby="local-faq-title">
        <h2 id="local-faq-title">Quick questions before you visit</h2>
        <article><h3>Where is Eshwar Home Products?</h3><p>You can find the store at 119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011. Open the map directions from the Visit Our Store section.</p></article>
        <article><h3>When is the store open?</h3><p>Opening hours are Monday to Saturday, 9:00 AM to 9:00 PM. The store is closed on Sunday.</p></article>
        <article><h3>Can I check a product before visiting?</h3><p>Yes. Use the WhatsApp enquiry links to ask about a product category, variety or pack size. The website does not show live stock, so please confirm current availability with the store.</p></article>
        <article><h3>Does the website show exact product images?</h3><p>Some images are representative illustrations. They help identify a category, but may not show the exact item or packaging currently in store. Contact the team for confirmation.</p></article>
      </div>
    </div>
  </section>

  <section class="ehp-visit-section" aria-labelledby="visit-title"><div class="container ehp-visit-grid"><div><p class="ehp-gold-eyebrow">VISIT OUR STORE</p><h2 id="visit-title">Good food, close to home.</h2><p>Come by and explore our traditional pantry range in Perambur.</p><a class="ehp-gold-button" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get Directions <span aria-hidden="true">↗</span></a></div><div class="ehp-visit-details"><div><span>ADDRESS</span><p>119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India</p></div><div><span>OPENING HOURS</span><p>Mon–Sat: 9:00 AM – 9:00 PM<br />Sunday: Closed</p></div><div><span>CALL OR WHATSAPP</span><p><a href="tel:+919941209953">+91 99412 09953</a><br /><a href={ask("your pantry requirements")} target="_blank" rel="noopener noreferrer">Send an enquiry ↗</a></p></div></div></div></section>
</SiteLayout>

<style>
  /* Homepage product cards: explicit layout, readable labels and touch-sized enquiry control. */
  .ehp-products-section { padding: clamp(48px, 7vw, 84px) 0; background: #FAF8F5; }
  .ehp-products-heading { max-width: 680px; margin: 0 auto 28px; text-align: center; }
  .ehp-products-heading h2 { margin: 8px 0; color: #2A1508; font: 400 clamp(2rem, 4vw, 3rem)/1.12 Georgia, "Times New Roman", serif; }
  .ehp-products-heading > p:last-child { color: #4A3525; font-size: .88rem; line-height: 1.7; }
  .ehp-product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .ehp-product-card { min-width: 0; overflow: hidden; border: 1px solid #E2D6C5; background: #FFFDF9; }
  .ehp-product-card figure { position: relative; overflow: hidden; aspect-ratio: 1; margin: 0; background: #F5EDE3; }
  .ehp-product-card figure img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ehp-product-card figcaption { position: absolute; inset: auto 0 0; padding: 7px 10px; background: rgb(42 21 8 / 78%); color: #FFFDF9; font-size: .68rem; line-height: 1.35; }
  .ehp-product-card-copy { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px 12px 16px; }
  .ehp-product-card-copy h3 { min-width: 0; margin: 0; color: #2A1508; font: 400 clamp(.98rem, 1.5vw, 1.15rem)/1.3 Georgia, "Times New Roman", serif; }
  .ehp-product-enquiry { display: inline-flex; flex: 0 0 48px; width: 48px; height: 48px; align-items: center; justify-content: center; border: 1px solid #E2D6C5; border-radius: 50%; background: #FFFDF9; color: #432818; font-size: 1.15rem; text-decoration: none; }
  .ehp-product-enquiry:hover { border-color: #D99B26; background: #F5EDE3; }
  .ehp-product-enquiry:focus-visible { outline: 3px solid #D99B26; outline-offset: 3px; }
  .ehp-product-note { margin: 18px 0 0; color: #5A4638; font-size: .76rem; line-height: 1.65; text-align: center; }
  @media (max-width: 900px) { .ehp-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } }
  @media (max-width: 420px) { .ehp-product-grid { gap: 10px; } .ehp-product-card-copy { gap: 8px; padding: 10px; } .ehp-product-card-copy h3 { font-size: .94rem; } }

  .ehp-local-guide { padding: clamp(48px, 7vw, 84px) 0; background: #FFFDF9; }
  .ehp-local-guide-inner { max-width: 1080px; }
  .ehp-local-guide-inner > h2, .ehp-local-faq > h2 { max-width: 760px; margin: 8px 0 18px; color: #2A1508; font: 400 clamp(1.8rem, 3.5vw, 2.65rem)/1.16 Georgia, "Times New Roman", serif; }
  .ehp-local-guide-inner > p:not(.ehp-section-kicker), .ehp-local-guide-grid p, .ehp-local-faq p { color: #4A3525; font-size: .94rem; line-height: 1.8; }
  .ehp-local-guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 32px; margin-top: 30px; }
  .ehp-local-guide-grid article, .ehp-local-faq article { border-top: 1px solid #E2D6C5; padding-top: 16px; }
  .ehp-local-guide-grid h3, .ehp-local-faq h3 { margin: 0 0 8px; color: #2A1508; font: 400 1.2rem/1.35 Georgia, "Times New Roman", serif; }
  .ehp-local-faq { margin-top: 48px; }
  .ehp-local-faq article { margin-top: 18px; }
  @media (max-width: 680px) { .ehp-local-guide-grid { grid-template-columns: 1fr; gap: 18px; } }

  .ehp-reviews-section { padding: clamp(48px, 7vw, 84px) 0; background: #FAF8F5; }
  .ehp-reviews-heading { max-width: 680px; margin: 0 auto 28px; text-align: center; }
  .ehp-reviews-heading h2 { margin: 8px 0; color: #2A1508; font: 400 clamp(2rem, 4vw, 3rem)/1.12 Georgia, "Times New Roman", serif; }
  .ehp-reviews-heading > p:last-child { color: #4A3525; font-size: .88rem; line-height: 1.7; }
  .ehp-reviews-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ehp-review-card { min-width: 0; padding: 20px; border: 1px solid #E2D6C5; border-top: 3px solid #D99B26; background: #FFFDF9; }
  .ehp-review-source { margin: 0 0 12px; color: #8A5A08; font-size: .7rem; font-weight: 700; letter-spacing: .04em; }
  .ehp-review-card blockquote { margin: 0; color: #2A1508; font: 400 1rem/1.65 Georgia, "Times New Roman", serif; }
  .ehp-reviewer { margin: 16px 0 0; color: #4A3525; font-size: .76rem; font-weight: 700; }
  .ehp-review-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 24px; margin-top: 22px; }
  .ehp-review-links a { display: inline-flex; min-height: 48px; align-items: center; color: #432818; font-size: .78rem; font-weight: 700; text-underline-offset: 4px; }
  @media (max-width: 760px) { .ehp-reviews-grid { grid-template-columns: 1fr; } }
</style>
