---
import SiteLayout from "../layouts/SiteLayout.astro";
import catalogue from "../data/catalogue.json";
import PublishedCatalogue from "../components/PublishedCatalogue";
const siteRoot = Astro.site ?? new URL("https://startupintelligence.github.io");
const pageUrl = new URL(`${import.meta.env.BASE_URL}products/`, siteRoot).toString();
const storeId = `${new URL(import.meta.env.BASE_URL, siteRoot).toString()}#store`;
const shelfGuides = {
  grains: { categoryName: "Rice & Millets (Siruthaniyam)", title: "Rice & Millets", eyebrow: "Traditional grains · Siruthaniyam", description: "Everyday meal staples and familiar ingredients for rice meals, idli, upma, dosa and home-style tiffin.", cues: ["Traditional rice varieties", "Whole millets: Thinai, Varagu, Samai, Kuthiraivali, Ragi and Kambu", "Millet flours", "Idli / Upma Rava"], occasions: ["Everyday meals", "Idli & upma", "Dosa & tiffin"] },
  oils: { categoryName: "Cold-Pressed Oils, Ghee & Dairy (Chekku)", title: "Cold-Pressed Oils, Ghee & Dairy", eyebrow: "Kitchen essentials · Chekku", description: "Traditional cooking essentials to ask about for everyday South Indian meals and home kitchens.", cues: ["Wood-pressed gingelly oil", "Wood-pressed groundnut oil", "Wood-pressed coconut oil", "Pure ghee and daily dairy essentials"], occasions: ["Daily cooking", "Seasoning & tempering", "Traditional recipes"] },
  pantry: { categoryName: "Millet Snacks, Honey & Pantry", title: "Millet Snacks, Honey & Pantry", eyebrow: "Teatime · Tiffin · Pantry favourites", description: "A helpful guide to snack-time, quick-tiffin and everyday pantry categories listed by the store.", cues: ["Millet flakes, Sevai (vermicelli) and millet pasta", "Millet cookies and Sathumaavu (traditional mix)", "Wild honey", "Native pulses, dry fruits and nuts"], occasions: ["Teatime", "Quick tiffin", "Everyday pantry"] }
};
const homeUrl = new URL(import.meta.env.BASE_URL, siteRoot).toString();
const pantryItemList = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": "The Pantry at Eshwar Home Products",
      "about": { "@id": storeId },
      "mainEntity": { "@id": `${pageUrl}#pantry-list` },
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#pantry-list`,
      "name": "The Pantry at Eshwar Home Products",
      "url": pageUrl,
      "itemListElement": catalogue.groups.map((group, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": { "@type": "Thing", "name": group.id === "grains" ? "Rice & millets (Siruthaniyam)" : group.title, "url": `${pageUrl}#${group.id}` },
      })),
    },
  ],
};
const pantryBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": homeUrl },
    { "@type": "ListItem", "position": 2, "name": "The Pantry", "item": pageUrl },
  ],
};
---
<SiteLayout title="Pantry & Traditional Groceries in Perambur, Chennai | Eshwar Home Products" description="Explore the pantry shelves at Eshwar Home Products in Perambur, Chennai: traditional rice and millets (Siruthaniyam), cold-pressed Chekku oils, ghee and everyday pantry essentials including Sathumaavu. Call or WhatsApp the store to confirm current varieties and availability." current="products">
  <script type="application/ld+json" set:html={JSON.stringify(pantryItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(pantryBreadcrumbs)} />
  <section class="page-heading"><div class="container">
    <p class="eyebrow">The pantry · Eshwar Home Products · Perambur, Chennai</p>
    <h1>Browse the<br /><em>pantry index.</em></h1>
    <p>Explore the shelves by the way you cook: everyday rice meals, idli and upma, traditional oils, teatime snacks and quick tiffin ideas. Message the Perambur team to check today's varieties and pack sizes.</p>
    <a class="text-link millet-guide-link" href={new URL(`${import.meta.env.BASE_URL}perambur-millet-store/#millet-name-guide`, siteRoot).toString()}>Read the Tamil-to-English millet name guide ↗</a>
    <div class="hero-actions">
      <a class="button button-dark" href="https://wa.me/919941209953?text=Hello%20Eshwar%20Home%20Products%2C%20I%20would%20like%20to%20check%20the%20pantry%20range." target="_blank" rel="noopener noreferrer">Ask on WhatsApp ↗</a>
      <a class="text-link phone-action" href="tel:+919941209953">Call +91 99412 09953</a>
    </div>
  </div></section>
  <section class="section container">
    <div class="catalogue-toolbar">
      <div><p class="eyebrow">Browse by shelf</p><h2>Find your pantry aisle.</h2></div>
      <div class="filter-list" role="group" aria-label="Filter pantry categories">
        <button type="button" class="filter-button is-active" data-filter="all" aria-pressed="true">All shelves</button>
        <button type="button" class="filter-button" data-filter="grains" aria-pressed="false">Rice & millets (Siruthaniyam)</button>
        <button type="button" class="filter-button" data-filter="oils" aria-pressed="false">Oils & ghee</button>
        <button type="button" class="filter-button" data-filter="pantry" aria-pressed="false">Pantry essentials</button>
      </div>
    </div>
    <nav class="pantry-shelf-nav pantry-track" aria-label="Jump to a pantry shelf">
      {catalogue.groups.map((group) => (
        <a class="pantry-shelf-link card" href="#catalogue-results" data-filter={group.id} aria-label={`Show ${group.title} products`}>
          <span>{group.id === "grains" ? `${group.title} (Siruthaniyam)` : group.title}</span><span aria-hidden="true">↘</span>
        </a>
      ))}
    </nav>
    <div id="catalogue-results" class="catalogue-results" tabindex="-1">
      <PublishedCatalogue client:visible />
      <div class="pantry-directory" id="static-catalogue">
      <div class="pantry-directory-inner" id="pantry-directory" aria-live="polite">
        {catalogue.groups.map((group, index) => (
          <section class="pantry-group" id={group.id} data-group={group.id}>
            <div class="pantry-group-visual">
              <div class="pantry-image-frame">
                <img src={`${import.meta.env.BASE_URL}${group.placeholderImage}`} alt={group.placeholderAlt} width="800" height="600" loading="lazy" decoding="async" />
              </div>
              <p class="representative-caption">Representative visual · Store photos coming soon</p>
            </div>
            <div class="pantry-group-content">
              <div class="pantry-group-heading">
                <span class="directory-number">{String(index + 1).padStart(2, "0")}</span>
                <div><p class="eyebrow">{shelfGuides[group.id].eyebrow}</p><h2>{shelfGuides[group.id].title}</h2><p>{shelfGuides[group.id].description}</p></div>
              </div>
              <div class="kitchen-use-block">
                <p class="kitchen-use-label">Kitchen-use guide</p>
                <ul class="kitchen-use-list">{shelfGuides[group.id].cues.map((cue) => <li>{cue}</li>)}</ul>
                <p class="meal-occasion-label">Useful for</p>
                <div class="meal-occasion-tags">{shelfGuides[group.id].occasions.map((occasion) => <span>{occasion}</span>)}</div>
              </div>
              <div class="catalogue-source-items">
                <p class="kitchen-use-label">From the store catalogue</p>
                <ul class="pantry-items">{group.items.map((item) => <li><strong>{item.title}</strong><span>{item.detail}</span></li>)}</ul>
              </div>
              <a class="shelf-whatsapp-button" href={`https://wa.me/919941209953?text=${encodeURIComponent(`Hello Eshwar Home Products, please check today's stock for ${shelfGuides[group.id].categoryName}.`)}`} target="_blank" rel="noopener noreferrer">Check Today's Stock on WhatsApp ↗</a>
            </div>
          </section>
        ))}
      </div>
      </div>
    </div>
    <!-- PANTRY_FAQS_SLOT -->
    <section class="pantry-faq" id="pantry-faqs" aria-labelledby="pantry-faq-title">
      <p class="eyebrow">Before you visit</p>
      <h2 id="pantry-faq-title">Pantry questions, answered.</h2>
      <div class="pantry-faq-list">
        <details><summary>How can I check today's varieties and pack sizes?</summary><p>Choose the shelf above and send its WhatsApp enquiry. You can include a specific grain, oil or snack and the pack size you are looking for.</p></details>
        <details><summary>Can I use the pantry guide to plan meals?</summary><p>Yes. The shelf notes group familiar ingredients around everyday meals, idli, upma, dosa, teatime and tiffin. They are kitchen-use cues, not a live stock list.</p></details>
        <details><summary>Where can I visit the Perambur store?</summary><p>Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011, India. Call <a href="tel:+919941209953">+91 99412 09953</a> if you need help before visiting.</p></details>
      </div>
    </section>
    <div class="catalogue-contact-notice">
      <p class="catalogue-footnote">For today's varieties and pack sizes, send the Perambur team a quick WhatsApp message before you visit.</p>
      <a class="button button-dark phone-action" href="tel:+919941209953">Call +91 99412 09953</a>
    </div>
    <div class="enquiry-row"><div><p class="eyebrow">Shopping in Perambur?</p><h2>Ask us about today’s range.</h2><p class="store-location-note">Eshwar Home Products · Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011.</p></div><a class="button button-dark" href="https://wa.me/919941209953?text=Hello%20Eshwar%20Home%20Products%2C%20I%20would%20like%20to%20check%20product%20availability." target="_blank" rel="noopener noreferrer">Enquire on WhatsApp ↗</a></div>
  </section>
</SiteLayout>
<script>
  import "../scripts/catalogue-filter.js";
</script>

<style>
.millet-guide-link{display:inline-flex;min-height:48px;align-items:center;margin-top:8px;color:var(--accent-green,#1B3B2B);text-underline-offset:4px}.pantry-group-content{min-width:0}.pantry-group-heading{margin-bottom:18px}.kitchen-use-block,.catalogue-source-items{margin:18px 0;padding:16px 0;border-top:1px solid var(--border-light,#E5E0D8)}.kitchen-use-label,.meal-occasion-label{margin:0 0 10px;color:var(--accent-green,#1B3B2B);font-size:.68rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.kitchen-use-list{display:flex;flex-wrap:wrap;gap:8px 18px;margin:0;padding:0;list-style:none}.kitchen-use-list li{position:relative;padding-left:14px;color:#37312C;font-size:.82rem;line-height:1.65}.kitchen-use-list li::before{position:absolute;left:0;color:var(--accent-gold,#D99B26);content:"•"}.meal-occasion-label{margin-top:18px}.meal-occasion-tags{display:flex;flex-wrap:wrap;gap:8px}.meal-occasion-tags span{display:inline-flex;min-height:32px;align-items:center;padding:5px 10px;border:1px solid var(--border-light,#E5E0D8);background:var(--bg-subtle,#FAF8F5);color:#4E473F;font-size:.72rem}.shelf-whatsapp-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;margin-top:12px;padding:10px 16px;border:1px solid var(--accent-green,#1B3B2B);background:var(--accent-green,#1B3B2B);color:#fff;font-size:.76rem;font-weight:700;line-height:1.35;text-align:center;text-decoration:none}.shelf-whatsapp-button:hover{background:#142E22}.pantry-group h2,.page-heading h1,.pantry-faq h2{text-wrap:balance}@media(max-width:760px){.shelf-whatsapp-button{width:100%}.kitchen-use-list{display:grid;grid-template-columns:minmax(0,1fr)}}
</style>
