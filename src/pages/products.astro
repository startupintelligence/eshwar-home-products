---
import SiteLayout from "../layouts/SiteLayout.astro";
import catalogue from "../data/catalogue.json";
import PublishedCatalogue from "../components/PublishedCatalogue";
const siteRoot = Astro.site ?? new URL("https://startupintelligence.github.io");
const pageUrl = new URL(`${import.meta.env.BASE_URL}products/`, siteRoot).toString();
const storeId = `${new URL(import.meta.env.BASE_URL, siteRoot).toString()}#store`;
const homeUrl = new URL(import.meta.env.BASE_URL, siteRoot).toString();
const pantryItemList = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      "url": pageUrl,
      "name": "The Pantry at Eshwar Home Products",
      "about": { "@id": storeId },
      "mainEntity": { "@id": `${pageUrl}#pantry-list` },
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#pantry-list`,
      "name": "The Pantry at Eshwar Home Products",
      "url": pageUrl,
      "itemListElement": catalogue.groups.map((group, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": { "@type": "Thing", "name": group.id === "grains" ? "Rice & millets (Siruthaniyam)" : group.title, "url": `${pageUrl}#${group.id}` },
      })),
    },
  ],
};
const pantryBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": homeUrl },
    { "@type": "ListItem", "position": 2, "name": "The Pantry", "item": pageUrl },
  ],
};
---
<SiteLayout title="Pantry & Traditional Groceries in Perambur, Chennai | Eshwar Home Products" description="Explore the pantry shelves at Eshwar Home Products in Perambur, Chennai: traditional rice and millets (Siruthaniyam), cold-pressed Chekku oils, ghee and everyday pantry essentials including Sathumaavu. Call or WhatsApp the store to confirm current varieties and availability." current="products">
  <script type="application/ld+json" set:html={JSON.stringify(pantryItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(pantryBreadcrumbs)} />
  <section class="page-heading"><div class="container">
    <p class="eyebrow">The pantry · Eshwar Home Products · Perambur, Chennai</p>
    <h1>Browse the<br /><em>pantry index.</em></h1>
    <p>A guide to the kinds of products covered by our store. Specific varieties, pack sizes and availability may change. Contact the Perambur store to confirm before visiting.</p>
    <div class="hero-actions">
      <a class="button button-dark" href="https://wa.me/919941209953?text=Hello%20Eshwar%20Home%20Products%2C%20I%20would%20like%20to%20check%20the%20pantry%20range." target="_blank" rel="noopener noreferrer">Ask on WhatsApp ↗</a>
      <a class="text-link phone-action" href="tel:+919941209953">Call +91 99412 09953</a>
    </div>
  </div></section>
  <section class="section container">
    <div class="catalogue-toolbar">
      <div><p class="eyebrow">Browse by shelf</p><h2>Find your pantry aisle.</h2></div>
      <div class="filter-list" role="group" aria-label="Filter pantry categories">
        <button type="button" class="filter-button is-active" data-filter="all" aria-pressed="true">All shelves</button>
        <button type="button" class="filter-button" data-filter="grains" aria-pressed="false">Rice & millets (Siruthaniyam)</button>
        <button type="button" class="filter-button" data-filter="oils" aria-pressed="false">Oils & ghee</button>
        <button type="button" class="filter-button" data-filter="pantry" aria-pressed="false">Pantry essentials</button>
      </div>
    </div>
    <nav class="pantry-shelf-nav pantry-track" aria-label="Jump to a pantry shelf">
      {catalogue.groups.map((group) => (
        <a class="pantry-shelf-link card" href="#catalogue-results" data-filter={group.id} aria-label={`Show ${group.title} products`}>
          <span>{group.id === "grains" ? `${group.title} (Siruthaniyam)` : group.title}</span><span aria-hidden="true">↘</span>
        </a>
      ))}
    </nav>
    <div id="catalogue-results" class="catalogue-results" tabindex="-1">
      <PublishedCatalogue client:visible />
      <div class="pantry-directory" id="static-catalogue">
      <div class="pantry-directory-inner" id="pantry-directory" aria-live="polite">
        {catalogue.groups.map((group, index) => (
          <section class="pantry-group" id={group.id} data-group={group.id}>
            <div class="pantry-group-visual">
              <div class="pantry-image-frame">
                <img src={`${import.meta.env.BASE_URL}${group.placeholderImage}`} alt={group.placeholderAlt} width="800" height="600" loading="lazy" decoding="async" />
              </div>
              <p class="representative-caption">Representative visual · Store photos coming soon</p>
            </div>
            <div class="pantry-group-content">
              <div class="pantry-group-heading">
                <span class="directory-number">{String(index + 1).padStart(2, "0")}</span>
                <div><p class="eyebrow">{group.eyebrow}</p><h2>{group.title}</h2><p>{group.description}</p></div>
                <a class="shelf-whatsapp-link" href={`https://wa.me/919941209953?text=${encodeURIComponent(`Hello Eshwar Home Products, please help me check current stock in the ${group.title} shelf.`)}`} target="_blank" rel="noopener noreferrer">Check stock on WhatsApp ↗</a>
              </div>
              <ul class="pantry-items">
                {group.items.map((item) => <li><strong>{item.title}</strong><span>{item.detail}</span></li>)}
              </ul>
            </div>
          </section>
        ))}
      </div>
      </div>
    </div>
    <!-- PANTRY_FAQS_SLOT -->
    <section class="pantry-faq" id="pantry-faqs" aria-labelledby="pantry-faq-title">
      <p class="eyebrow">Before you visit</p>
      <h2 id="pantry-faq-title">Pantry questions, answered.</h2>
      <div class="pantry-faq-list">
        <details><summary>Does this page show live stock?</summary><p>No. This page is a guide to the store’s pantry categories, not a live stock list. Please call or WhatsApp to confirm a product and its current availability.</p></details>
        <details><summary>Can I check varieties and pack sizes before visiting?</summary><p>Yes. Contact the store and ask about the specific variety or pack size you need. The team can confirm the latest information before you travel.</p></details>
        <details><summary>Where is Eshwar Home Products?</summary><p>Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011, India.</p></details>
        <details><summary>How do I contact the Perambur store?</summary><p>Call <a href="tel:+919941209953">+91 99412 09953</a> or message the store on WhatsApp to ask about the pantry range.</p></details>
      </div>
    </section>
    <div class="catalogue-contact-notice">
      <p class="catalogue-footnote">This pantry guide is not a live stock list. Please call or message the store to confirm a particular variety or pack size before travelling.</p>
      <a class="button button-dark phone-action" href="tel:+919941209953">Call +91 99412 09953</a>
    </div>
    <div class="enquiry-row"><div><p class="eyebrow">Shopping in Perambur?</p><h2>Ask us about today’s range.</h2><p class="store-location-note">Eshwar Home Products · Door No. 119/1, Nelvayal Road, Neelam Garden, Bunder Garden, Perambur, Chennai, Tamil Nadu 600011.</p></div><a class="button button-dark" href="https://wa.me/919941209953?text=Hello%20Eshwar%20Home%20Products%2C%20I%20would%20like%20to%20check%20product%20availability." target="_blank" rel="noopener noreferrer">Enquire on WhatsApp ↗</a></div>
  </section>
</SiteLayout>
<script>
  import "../scripts/catalogue-filter.js";
</script>
