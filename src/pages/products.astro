---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getImage } from "astro:assets";
import catalogue from "../data/catalogue.json";
import PublishedCatalogue from "../components/PublishedCatalogue";
import { buildWhatsAppUrl, storeConfig } from "../data/store";
import milletsImg from "../assets/images/pantry_whole_millets_1795627178343.jpg";
import oilsImg from "../assets/images/pantry_cold_pressed_oils_1795627178653.jpg";
import ragiImg from "../assets/images/ESH_Ragi_Pack.jpeg";
import badamImg from "../assets/images/ESH_Badam_Pack.jpeg";

async function buildShelfImageSet(image: ImageMetadata) {
  const [w400, w800] = await Promise.all([
    getImage({ src: image, width: 400, height: 300, format: "webp", fit: "cover" }),
    getImage({ src: image, width: 800, height: 600, format: "webp", fit: "cover" }),
  ]);
  return {
    src: w800.src,
    srcset: `${w400.src} 400w, ${w800.src} 800w`,
  };
}

const [grainsVisual, oilsVisual, pantryVisual] = await Promise.all([
  buildShelfImageSet(ragiImg),
  buildShelfImageSet(oilsImg),
  buildShelfImageSet(badamImg),
]);

const shelfImages: Record<string, { src: string; srcset: string; alt: string; caption: string }> = {
  grains: {
    ...grainsVisual,
    alt: "Official Eshwar Home Products Ragi finger millet pouch pack",
    caption: "Official Eshwar Home Products pack · Whole millets & rice stocked in-store",
  },
  oils: {
    ...oilsVisual,
    alt: "Representative illustration of cold-pressed gingelly and groundnut oils",
    caption: "Representative visual · Ask on WhatsApp for today's bottled Chekku oils",
  },
  pantry: {
    ...pantryVisual,
    alt: "Official Eshwar Home Products Badam almonds pouch pack",
    caption: "Official Eshwar Home Products pack · Nuts, honey & snacks stocked in-store",
  },
};
void milletsImg;
const siteRoot = Astro.site ?? new URL("https://startupintelligence.github.io");
const pageUrl = new URL(`${import.meta.env.BASE_URL}products/`, siteRoot).toString();
const storeId = `${new URL(import.meta.env.BASE_URL, siteRoot).toString()}#store`;
const homeUrl = new URL(import.meta.env.BASE_URL, siteRoot).toString();
const mapsUrl = storeConfig.mapsUrl;
const shelfDetails = {
  grains: {
    label: "Rice & Millets (Siruthaniyam)",
    intro: "Traditional rice, whole millets and millet flours for everyday meals, breakfast and tiffin. Use the Tamil and English grain names as a handy guide when asking the store.",
    cues: ["Traditional rice varieties", "Thinai · Foxtail millet", "Varagu · Kodo millet", "Samai · Little millet", "Kuthiraivali · Barnyard millet", "Ragi · Finger millet", "Kambu · Pearl millet", "Millet flours", "Idli / Upma rava"],
    occasions: ["Breakfast & tiffin", "Everyday meals", "Pongal & upma"]
  },
  oils: {
    label: "Cold-Pressed Oils, Ghee & Dairy (Chekku)",
    intro: "Traditional wood-pressed gingelly, groundnut and coconut oils, alongside ghee and everyday dairy essentials for South Indian home cooking.",
    cues: ["Wood-pressed gingelly oil", "Wood-pressed groundnut oil", "Wood-pressed coconut oil", "Ghee", "Everyday dairy essentials"],
    occasions: ["Everyday cooking", "Seasoning & tempering", "Traditional recipes"]
  },
  pantry: {
    label: "Millet Snacks, Honey & Pantry",
    intro: "A practical pantry mix for teatime, tiffin and everyday kitchen planning, from millet-based quick-cook options to familiar pantry staples.",
    cues: ["Millet flakes", "Sevai · vermicelli", "Millet pasta", "Millet cookies", "Sathumaavu · traditional mix", "Wild honey", "Native pulses", "Dry fruits & nuts"],
    occasions: ["Teatime", "Tiffin", "Quick meals & snacks"]
  }
};
const pantryItemList = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": `${pageUrl}#webpage`, "url": pageUrl, "name": "The Pantry at Eshwar Home Products", "about": { "@id": storeId }, "mainEntity": { "@id": `${pageUrl}#pantry-list` } },
    { "@type": "ItemList", "@id": `${pageUrl}#pantry-list`, "name": "The Pantry at Eshwar Home Products", "url": pageUrl,
      "itemListElement": catalogue.groups.map((group, index) => ({ "@type": "ListItem", "position": index + 1, "item": { "@type": "Thing", "name": shelfDetails[group.id as keyof typeof shelfDetails]?.label ?? group.title, "url": `${pageUrl}#${group.id}` } })) }
  ]
};
const pantryBreadcrumbs = { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
  { "@type": "ListItem", "position": 1, "name": "Home", "item": homeUrl },
  { "@type": "ListItem", "position": 2, "name": "The Pantry", "item": pageUrl }
] };
---
<SiteLayout title="The Pantry | Traditional Rice, Millets & Kitchen Essentials in Perambur" description="Explore traditional rice and Siruthaniyam millets, Chekku oils, ghee, millet snacks and everyday pantry categories at Eshwar Home Products in Perambur, Chennai. Ask the store about today's stock on WhatsApp." current="products">
  <script type="application/ld+json" set:html={JSON.stringify(pantryItemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(pantryBreadcrumbs)} />
  <section class="page-heading pantry-hero"><div class="container pantry-hero-grid">
    <div class="pantry-hero-copy">
      <p class="eyebrow">The Pantry · Perambur, Chennai</p>
      <h1>Good things for<br /><em>everyday cooking.</em></h1>
      <p>Explore traditional rice, millets, cooking essentials and familiar pantry favourites for everyday South Indian kitchens. Browse by shelf, then ask our team about the variety or pack size you need.</p>
      <div class="hero-actions">
        <a class="button pantry-hero-cta" href={mapsUrl} target="_blank" rel="noopener noreferrer">Visit Store &amp; Buy (Directions) ↗</a>
        <a class="button-whatsapp" href={buildWhatsAppUrl("Hello Eshwar Home Products, please help me check today's pantry stock.")} target="_blank" rel="noopener noreferrer">Check stock on WhatsApp ↗</a>
        <a class="text-link phone-action" href={storeConfig.phoneHref}>Call {storeConfig.phoneDisplay}</a>
      </div>
    </div>
    <aside class="pantry-store-card" aria-label="Store details">
      <p class="eyebrow">Visit our neighbourhood store</p>
      <div class="pantry-store-detail"><span>Store location</span><address>{storeConfig.address}</address></div>
      <div class="pantry-store-detail"><span>Opening hours</span><p>{storeConfig.shortHours}</p></div>
      <div class="pantry-store-detail"><span>Direct contact</span><a href={storeConfig.phoneHref}>{storeConfig.phoneDisplay}</a></div>
    </aside>
  </div></section>
  <section class="pantry-real-photos" aria-labelledby="pantry-real-photos-title">
    <div class="container">
      <div class="pantry-real-photos-heading"><p class="eyebrow">STOREFRONT &amp; PRODUCT BOARDS</p><h2 id="pantry-real-photos-title">A closer look at Eshwar Home Products.</h2><p>View our Perambur storefront, printed Tamil product lists, and store location. Select any card to browse the shelves or find directions.</p></div>
      <div class="pantry-real-photo-grid">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Find Eshwar Home Products in Google Maps"><picture><source type="image/webp" srcset={`${import.meta.env.BASE_URL}images/business/EHP_Shop_Front_View-480.webp 480w, ${import.meta.env.BASE_URL}images/business/EHP_Shop_Front_View-768.webp 768w, ${import.meta.env.BASE_URL}images/business/EHP_Shop_Front_View-1280.webp 1280w`} sizes="(max-width: 700px) 100vw, 40vw" /><img src={`${import.meta.env.BASE_URL}images/business/EHP_Shop_Front_View.jpeg`} alt="Eshwar Home Products storefront in Perambur, Chennai" width="1288" height="966" loading="lazy" decoding="async" /></picture><span>Perambur storefront on Maps ↗</span></a>
        <a class="is-board" href="#grains" aria-label="Browse rice and millet varieties"><picture><source type="image/webp" srcset={`${import.meta.env.BASE_URL}images/business/EHP_Products1-480.webp 480w, ${import.meta.env.BASE_URL}images/business/EHP_Products1-767.webp 767w`} sizes="(max-width: 700px) 100vw, 25vw" /><img src={`${import.meta.env.BASE_URL}images/business/EHP_Products1.jpeg`} alt="Printed Tamil rice and Siruthaniyam millet product board from Eshwar Home Products" width="767" height="1280" loading="lazy" decoding="async" /></picture><span>Rice &amp; Millet Board →</span></a>
        <a class="is-board" href="#oils" aria-label="Explore Chekku oils, ghee, and pantry board"><picture><source type="image/webp" srcset={`${import.meta.env.BASE_URL}images/business/EHP_Products2-480.webp 480w, ${import.meta.env.BASE_URL}images/business/EHP_Products2-768.webp 768w, ${import.meta.env.BASE_URL}images/business/EHP_Products2-960.webp 960w`} sizes="(max-width: 700px) 100vw, 25vw" /><img src={`${import.meta.env.BASE_URL}images/business/EHP_Products2.jpeg`} alt="Printed Tamil Chekku oils, ghee, honey, and pantry product board from Eshwar Home Products" width="960" height="1600" loading="lazy" decoding="async" /></picture><span>Oils &amp; Pantry Board →</span></a>
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="Open the store map in Google Maps"><picture><source type="image/webp" srcset={`${import.meta.env.BASE_URL}images/business/EHP_Map_Small-480.webp 480w, ${import.meta.env.BASE_URL}images/business/EHP_Map_Small-768.webp 768w`} sizes="(max-width: 700px) 100vw, 25vw" /><img src={`${import.meta.env.BASE_URL}images/business/EHP_Map_Small.jpeg`} alt="Map image for Eshwar Home Products in Perambur" width="1088" height="638" loading="lazy" decoding="async" /></picture><span>Open store location ↗</span></a>
      </div>
    </div>
  </section>
  <section class="section container pantry-page">
    <div class="pantry-intro-row">
      <div><p class="eyebrow">Three familiar shelves</p><h2>Find a place to start.</h2></div>
      <p>From traditional grains for breakfast and meals to cooking oils, teatime snacks and pantry staples, explore the categories in one simple guide.</p>
    </div>
    <nav class="pantry-shelf-nav pantry-track" aria-label="Jump to a pantry shelf">
      {catalogue.groups.map((group) => <a class="pantry-shelf-link card" href={`#${group.id}`}><span>{shelfDetails[group.id as keyof typeof shelfDetails]?.label ?? group.title}</span><span aria-hidden="true">↘</span></a>)}
    </nav>
    <div class="catalogue-live-intro"><p class="eyebrow">Client-published products</p><h2>Recently published to the store catalogue</h2><p>Product details shown here come from the store's publishing system. For anything else, ask the team directly.</p></div>
    <PublishedCatalogue client:visible />
    <div class="pantry-search-status" id="pantry-search-status" hidden aria-live="polite">
      <span id="pantry-search-text"></span>
      <button class="pantry-search-clear" type="button" id="pantry-search-clear">Clear search</button>
    </div>
    <div class="pantry-search-empty" id="pantry-search-empty" hidden>
      <p id="pantry-search-empty-text"></p>
      <button class="filter-button" type="button" id="pantry-search-empty-clear">Show all shelves</button>
    </div>
    <div class="pantry-grid-wrap" id="pantry-grid-wrap">
      <div class="pantry-spinner" id="pantry-spinner" role="status" aria-live="polite" hidden>
        <span class="pantry-spinner-ring" aria-hidden="true"></span>
        <span class="sr-only" id="pantry-spinner-label"></span>
      </div>
      <div class="pantry-directory" id="pantry-shelves">
        <div class="pantry-directory-inner">
        {catalogue.groups.map((group, index) => {
          const shelf = shelfDetails[group.id as keyof typeof shelfDetails];
          const categoryName = shelf?.label ?? group.title;
          const cues = shelf?.cues ?? group.items.map((item) => item.title);
          const occasions = shelf?.occasions ?? [];
          const searchText = `${categoryName} ${group.eyebrow} ${shelf?.intro ?? group.description} ${cues.join(" ")} ${occasions.join(" ")}`.toLowerCase();
          const message = `Hello Eshwar Home Products, please help me check today's stock for ${categoryName}.`;
          const shelfVisual = shelfImages[group.id];
          return <section class="pantry-group pantry-interactive-card" id={group.id} data-group={group.id} data-pantry-search-item data-search-text={searchText}>
            <div class="pantry-group-visual">
              <div class="pantry-image-frame"><img src={shelfVisual?.src ?? `${import.meta.env.BASE_URL}${group.placeholderImage}`} srcset={shelfVisual?.srcset} sizes="(max-width: 760px) 100vw, 420px" alt={shelfVisual?.alt ?? group.placeholderAlt} width="800" height="600" loading="lazy" decoding="async" /></div>
              <p class="representative-caption">{shelfVisual?.caption ?? "Representative visual · Store photos coming soon"}</p>
            </div>
            <div class="pantry-group-content">
              <div class="pantry-group-heading"><span class="directory-number">{String(index + 1).padStart(2, "0")}</span><div>
                <p class="eyebrow">{group.eyebrow}</p><h2>{categoryName}</h2><p>{shelf?.intro ?? group.description}</p>
              </div></div>
              <p class="kitchen-cue-label">Kitchen-use guide</p>
              <ul class="kitchen-cues">{(shelf?.cues ?? group.items.map((item) => item.title)).map((cue) => <li><button class="pantry-item-trigger" type="button" data-ehp-dialog="product" data-ehp-title={cue} data-ehp-description={"Ask the store about current options for " + cue + "."} data-ehp-items={JSON.stringify([cue])} aria-haspopup="dialog">{cue}</button></li>)}</ul>
              <div class="meal-occasions">{(shelf?.occasions ?? []).map((occasion) => <span>{occasion}</span>)}</div>
              <button class="pantry-quickview-trigger" type="button" data-ehp-dialog="product" data-ehp-title={categoryName} data-ehp-description={shelf?.intro ?? group.description} data-ehp-items={JSON.stringify(shelf?.cues ?? group.items.map((item) => item.title))} aria-haspopup="dialog">View shelf details →</button>
              <a class="shelf-whatsapp-link" href={buildWhatsAppUrl(message)} target="_blank" rel="noopener noreferrer">Check Today's Stock on WhatsApp ↗</a>
              
            </div>
          </section>;
        })}
        </div>
      </div>
    </div>
    <p class="pantry-stock-note">Looking for a particular variety or pack size? Message us on WhatsApp anytime to check today's fresh arrivals and options.</p>
    <section class="pantry-faq" aria-labelledby="pantry-faq-title">
      <p class="eyebrow">A little help before you visit</p><h2 id="pantry-faq-title">Pantry questions.</h2>
      <div class="pantry-faq-list">
        <details><summary>Can I ask about a Tamil millet name?</summary><p>Yes. Use the Tamil–English millet reference in our <a href={`${import.meta.env.BASE_URL}perambur-millet-store/#millet-reference`}>Perambur store guide</a>, then message the team about the variety you have in mind.</p></details>
        <details><summary>Can I check pack sizes before visiting?</summary><p>Yes. Send the product or variety name through WhatsApp and ask the team about current options.</p></details>
        <details><summary>How can I check my order status or track pickup?</summary><p>Reply to your existing <a href={buildWhatsAppUrl("Hello Eshwar Home Products, I would like to check my order status.")} target="_blank" rel="noopener noreferrer">WhatsApp message</a> or call <a href={storeConfig.phoneHref}>{storeConfig.phoneDisplay}</a> with your name during store hours (Mon–Sat, 9 AM–9 PM) for a quick update from our counter team.</p></details>
        <details><summary>Where is the store?</summary><p>{storeConfig.address}.</p></details>
        <details><summary>What are the store hours?</summary><p>{storeConfig.hours}</p></details>
      </div>
    </section>
    <div class="enquiry-row"><div><p class="eyebrow">A neighbourhood pantry in Perambur</p><h2>Need help choosing a shelf?</h2><p class="store-location-note">Call or message the store. The team can help you check today's options before you visit.</p></div><a class="button" href={buildWhatsAppUrl("Hello Eshwar Home Products, I need help with the pantry range.")} target="_blank" rel="noopener noreferrer">Ask on WhatsApp ↗</a></div>
  </section>
</SiteLayout>
<script>
  import "../scripts/catalogue-filter.js";

  const pantryShelves = document.querySelectorAll<HTMLElement>("[data-pantry-search-item]");
  const pantryStatus = document.getElementById("pantry-search-status");
  const pantryStatusText = document.getElementById("pantry-search-text");
  const pantryEmpty = document.getElementById("pantry-search-empty");
  const pantryEmptyText = document.getElementById("pantry-search-empty-text");
  const pantryClearButtons = [
    document.getElementById("pantry-search-clear"),
    document.getElementById("pantry-search-empty-clear")
  ].filter((el): el is HTMLElement => Boolean(el));

  const applyPantrySearch = (rawQuery: string) => {
    const query = rawQuery.trim().toLowerCase();
    let visibleCount = 0;

    pantryShelves.forEach((shelf) => {
      const text = shelf.dataset.searchText ?? "";
      const matches = !query || text.includes(query);
      shelf.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    if (pantryStatus && pantryStatusText) {
      if (query) {
        pantryStatus.hidden = false;
        pantryStatusText.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? "shelf" : "shelves"} matching "${rawQuery.trim()}"`;
      } else {
        pantryStatus.hidden = true;
      }
    }

    if (pantryEmpty && pantryEmptyText) {
      if (query && visibleCount === 0) {
        pantryEmpty.hidden = false;
        pantryEmptyText.textContent = `No pantry shelves matched "${rawQuery.trim()}". Try millets, rice, oils, ghee, honey, or nuts.`;
      } else {
        pantryEmpty.hidden = true;
        pantryEmptyText.textContent = "";
      }
    }
  };

  const pantryGridWrap = document.getElementById("pantry-grid-wrap");
  const pantrySpinner = document.getElementById("pantry-spinner");
  const pantrySpinnerLabel = document.getElementById("pantry-spinner-label");
  const pantryReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let pantrySearchTimer: number | undefined;

  const setPantryLoading = (loading: boolean) => {
    if (pantryGridWrap) pantryGridWrap.classList.toggle("is-updating", loading);
    if (pantrySpinner) pantrySpinner.hidden = !loading;
    if (pantrySpinnerLabel) pantrySpinnerLabel.textContent = loading ? "Updating pantry shelves" : "";
  };

  window.addEventListener("ehp:product-search", (event) => {
    const detail = (event as CustomEvent<{ query?: string }>).detail;
    const nextQuery = detail?.query ?? "";
    if (pantrySearchTimer) window.clearTimeout(pantrySearchTimer);
    if (pantryReducedMotion) {
      setPantryLoading(false);
      applyPantrySearch(nextQuery);
      return;
    }
    setPantryLoading(true);
    pantrySearchTimer = window.setTimeout(() => {
      applyPantrySearch(nextQuery);
      setPantryLoading(false);
    }, 220);
  });

  pantryClearButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (pantrySearchTimer) window.clearTimeout(pantrySearchTimer);
      setPantryLoading(false);
      window.dispatchEvent(new CustomEvent("ehp:clear-product-search"));
    });
  });

  const initialPantryQuery = new URLSearchParams(window.location.search).get("q") ?? "";
  if (initialPantryQuery) {
    applyPantrySearch(initialPantryQuery);
  }
</script>
<style>
  .pantry-page h2,.pantry-page h3 { text-wrap: balance; }
  .pantry-real-photos { padding:32px 0 12px; }
  .pantry-real-photos-heading { max-width:650px; margin-bottom:18px; }
  .pantry-real-photos-heading h2 { margin:6px 0; font:600 clamp(1.7rem,3vw,2.35rem)/1.15 var(--serif); }
  .pantry-real-photos-heading > p:last-child { color:var(--text-muted); font-size:.9375rem; line-height:1.65; }
  .pantry-real-photo-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
  .pantry-real-photo-grid a { display:flex; min-width:0; flex-direction:column; overflow:hidden; border:1px solid var(--border-light); border-radius:10px; background:var(--bg-card); color:var(--text-main); text-decoration:none; }
  .pantry-real-photo-grid img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; }
  .pantry-real-photo-grid a.is-board img { object-fit:contain; background:#FFFFFF; padding:6px; }
  .pantry-real-photo-grid span { display:flex; min-height:42px; align-items:center; padding:10px 12px; font-size:.8125rem; font-weight:600; }
  .pantry-real-photo-grid a:focus-visible { outline:2px solid var(--accent-green); outline-offset:3px; }
  @media(max-width:760px) { .pantry-real-photo-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; } }
  .pantry-intro-row { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:32px; align-items:end; margin-bottom:28px; }
  .pantry-intro-row h2,.catalogue-live-intro h2 { margin:8px 0 0; font:600 clamp(2rem,4vw,2.75rem)/1.1 var(--serif); }
  .pantry-intro-row > p,.catalogue-live-intro > p:last-child { margin:0; color:var(--text-muted); font-size:.9375rem; line-height:1.75; }
  .catalogue-live-intro { margin:32px 0 16px; padding:20px 0 14px; border-top:1px solid var(--border-light); }
  .catalogue-live-intro h2 { font-size:1.65rem; }
  .catalogue-live-intro > p:last-child { margin-top:8px; }
  .pantry-group { display:grid; grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr); gap:clamp(24px,4vw,48px); align-items:start; padding:34px 0; border-bottom:1px solid var(--border-light); }
  .pantry-group-visual { min-width:0; }
  .pantry-image-frame { overflow:hidden; aspect-ratio:4/3; border:1px solid var(--border-light); border-radius:12px; background:var(--bg-subtle); }
  .pantry-image-frame img { display:block; width:100%; height:100%; object-fit:cover; }
  .representative-caption { margin:8px 0 0; color:var(--text-muted); font-size:.8125rem; }
  .pantry-group-heading { display:grid; grid-template-columns:34px minmax(0,1fr); gap:12px; }
  .pantry-group-heading h2 { margin:4px 0 8px; font:600 clamp(1.55rem,2.8vw,2.1rem)/1.18 var(--serif); }
  .pantry-group-heading div > p:last-child { margin:0; color:var(--text-muted); font-size:.9375rem; line-height:1.75; }
  .kitchen-cue-label { margin:20px 0 9px; color:var(--accent-brass); font-size:.8125rem; font-weight:700; letter-spacing:.03em; }
  .kitchen-cues { display:flex; flex-wrap:wrap; gap:8px; margin:0; padding:0; list-style:none; }
  .kitchen-cues li { display:flex; min-height:36px; align-items:center; padding:4px 12px; border:1px solid var(--border-light); border-radius:8px; background:var(--bg-card); color:var(--text-main); font-size:.875rem; line-height:1.35; }
  .meal-occasions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
  .meal-occasions span { color:var(--text-muted); font-size:.8125rem; }
  .meal-occasions span + span::before { content:"·"; margin-right:8px; color:var(--accent-brass); }
  .pantry-page .shelf-whatsapp-link { display:inline-flex; min-height:46px; align-items:center; justify-content:center; margin:16px 0 8px; padding:0 18px; border:1px solid var(--accent-green); border-radius:8px; background:var(--accent-green); color:#FFFFFF; font-size:.875rem; font-weight:600; text-decoration:none; }
  .pantry-page .shelf-whatsapp-link:hover { background:var(--accent-green-hover); border-color:var(--accent-green-hover); color:#FFFFFF; }
  .pantry-quickview-trigger { display:inline-flex; min-height:46px; align-items:center; justify-content:center; margin:16px 10px 8px 0; padding:0 16px; border:1px solid var(--border-light); border-radius:8px; background:var(--bg-card); color:var(--text-main); font:inherit; font-size:.875rem; font-weight:600; cursor:pointer; }
