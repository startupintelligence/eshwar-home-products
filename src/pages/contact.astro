---
import SiteLayout from "../layouts/SiteLayout.astro";
import StoreLocationMap from "../components/StoreLocationMap";
import "../styles/mobile-responsive.css";
---
<SiteLayout title="Visit us | Eshwar Home Products" description="Find and contact Eshwar Home Products at 119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India." current="contact">
  <section class="page-heading contact-hero">
    <div class="container contact-hero-grid">
      <div class="contact-hero-copy">
        <p class="eyebrow">Visit or get in touch</p>
        <h1>We’re here in<br /><em>Perambur.</em></h1>
        <p>Want to ask about a product or check what is available today? Give us a call before you visit.</p>
      </div>
      <aside class="contact-hero-card" aria-label="Store information">
        <p class="contact-hero-rating"><span aria-hidden="true">5.0 ★</span> Rated Neighbourhood Store on Google Maps</p>
        <div class="contact-hero-fact">
          <span>Opening hours</span>
          <strong>Mon–Sat: 9:00 AM – 9:00 PM · Sun: Closed</strong>
        </div>
        <div class="contact-hero-fact">
          <span>Visit our store</span>
          <strong>119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai 600011</strong>
        </div>
        <a class="contact-explore-button" href="../products/">Explore the Pantry <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="section container contact-layout">
    <div class="contact-details-panel">
      <p class="eyebrow">Store details</p><h2>Come by<br /><em>and say hello.</em></h2>
      <dl class="contact-list">
        <div><dt>Address</dt><dd>119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India.</dd></div>
        <div><dt>Phone</dt><dd><a href="tel:+919941209953">+91 99412 09953</a></dd></div>
        <div><dt>WhatsApp</dt><dd><a href="https://wa.me/919941209953" target="_blank" rel="noopener noreferrer">+91 99412 09953</a></dd></div>
        <div><dt>Email</dt><dd><a data-email-contact href="mailto:info.eshwarhomeproducts@gmail.com">Send an email</a></dd></div>
        <div><dt>Opening hours</dt><dd>Mon–Sat: 9:00 AM – 9:00 PM · Sun: Closed</dd></div>
      </dl>
      <div class="contact-actions">
        <a class="contact-call-button" href="tel:+919941209953">Call the shop</a>
        <a class="contact-whatsapp-button" href="https://wa.me/919941209953" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
      </div>
    </div>
    <div class="directions-panel">
      <p class="eyebrow">Find the shop</p><h2>Paddy Field Rd,<br /><em>Chinnaiyan Colony, Perambur.</em></h2>
      <p>119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India.</p>
      <StoreLocationMap client:visible />
      <a class="text-link" href="https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu&g_ep=EgoyMDI2MTExNS4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener noreferrer">Open directions in Google Maps ↗</a>
    </div>
  </section>

  <section class="section container youtube-promo" aria-label="Follow Eshwar Home Products">
    <div class="social-profile-grid">
      <a class="social-profile-card" href="https://www.youtube.com/@EHP_PeramburOfficial" target="_blank" rel="noopener noreferrer">
        <span><span class="eyebrow">Official YouTube</span><strong>@EHP_PeramburOfficial</strong></span>
        <span class="social-profile-action">Visit channel ↗</span>
      </a>
      <a class="social-profile-card" href="https://www.instagram.com/eshwar_home_products/" target="_blank" rel="noopener noreferrer">
        <span><span class="eyebrow">Official Instagram</span><strong>@eshwar_home_products</strong></span>
        <span class="social-profile-action">Visit profile ↗</span>
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .social-profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .social-profile-card {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 20px;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-main);
    text-decoration: none;
    transition: border-color .18s var(--ease-out), transform .18s var(--ease-out);
  }
  .social-profile-card strong {
    display: block;
    color: var(--text-main);
    font-size: .95rem;
    overflow-wrap: anywhere;
  }
  .social-profile-card .eyebrow {
    display: block;
    margin-bottom: 4px;
    color: var(--accent-brass);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: none;
  }
  .social-profile-action {
    flex: 0 0 auto;
    color: var(--accent-green);
    font-size: .84rem;
    font-weight: 600;
  }
  .social-profile-card:hover {
    border-color: var(--accent-green);
    transform: translateY(-2px);
  }
  @media (max-width: 600px) {
    .social-profile-grid { grid-template-columns: 1fr; }
  }
  .contact-map-embed {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 280px;
    margin: 20px 0 16px;
    border: 1px solid var(--border-light) !important;
    border-radius: 12px;
  }
  .contact-hero-grid {
    width: min(1200px, calc(100% - (2 * clamp(16px, 4vw, 32px))));
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }
  .contact-hero-copy { max-width: 620px; }
  .contact-hero-card {
    position: relative;
    padding: 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    text-align: left;
  }
  .contact-hero-rating {
    margin: 0 0 20px;
    color: var(--text-main);
    font-size: .9rem;
    font-weight: 600;
    line-height: 1.55;
  }
  .contact-hero-rating span {
    display: block;
    margin-bottom: 4px;
    color: var(--accent-brass);
    font-size: 1.1rem;
  }
  .contact-hero-fact {
    display: grid;
    gap: 6px;
    padding: 14px 0;
    border-top: 1px solid var(--border-light);
  }
  .contact-hero-fact span {
    color: var(--text-muted);
    font-size: .75rem;
    font-weight: 600;
  }
  .contact-hero-fact strong {
    color: var(--text-main);
    font-size: .9rem;
    line-height: 1.6;
  }
  .contact-explore-button,
  .contact-call-button,
  .contact-whatsapp-button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: .88rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background-color .18s var(--ease-out), border-color .18s var(--ease-out), transform .18s var(--ease-out);
  }
  .contact-explore-button {
    width: 100%;
    margin-top: 16px;
    background: var(--accent-green);
    border-color: var(--accent-green);
    color: #FFFFFF;
  }
  .contact-explore-button:hover {
    background: var(--accent-green-hover);
    border-color: var(--accent-green-hover);
    color: #FFFFFF;
    transform: translateY(-1px);
  }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .contact-call-button {
    background: var(--accent-green);
    border-color: var(--accent-green);
    color: #FFFFFF;
  }
  .contact-call-button:hover {
    background: var(--accent-green-hover);
    border-color: var(--accent-green-hover);
    color: #FFFFFF;
    transform: translateY(-1px);
  }
  .contact-whatsapp-button {
    background: var(--bg-card);
    border-color: var(--border-light);
    color: var(--text-main);
  }
  .contact-whatsapp-button:hover {
    background: var(--bg-subtle);
    border-color: var(--accent-green);
    color: var(--text-main);
    transform: translateY(-1px);
  }
  .contact-layout,
  .youtube-promo {
    width: min(1200px, calc(100% - (2 * clamp(16px, 4vw, 32px))));
    margin-inline: auto;
  }
  .directions-panel {
    padding: 28px;
  }
  @media (max-width: 760px) {
    .contact-hero-grid { grid-template-columns: 1fr; gap: 26px; }
    .contact-hero-card { max-width: 520px; }
    .contact-layout,
    .youtube-promo { width: calc(100% - 32px); }
    .directions-panel { padding: 20px; }
  }
  @media (max-width: 420px) {
    .contact-hero-card { padding: 20px; }
    .contact-actions { display: grid; grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-profile-card,
    .contact-explore-button,
    .contact-call-button,
    .contact-whatsapp-button { transition: none; }
  }
</style>