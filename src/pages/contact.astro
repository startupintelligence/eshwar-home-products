---
import SiteLayout from "../layouts/SiteLayout.astro";
import StoreLocationMap from "../components/StoreLocationMap";
import { storeConfig } from "../data/store";

const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Visit us | Eshwar Home Products" description="Visit and contact Eshwar Home Products at 119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India." current="contact">
  <section class="page-heading contact-hero">
    <div class="container contact-hero-grid">
      <div class="contact-hero-copy">
        <p class="eyebrow">Visit or get in touch</p>
        <h1>Visit us in<br /><em>Perambur.</em></h1>
        <p>Drop by our neighbourhood pantry on Paddy Field Road to browse our shelves in person, or check today's availability by call or WhatsApp before your visit.</p>
      </div>
      <aside class="contact-hero-card" aria-label="Store information">
        <p class="contact-hero-rating"><span aria-hidden="true">5.0 ★</span> Rated Neighbourhood Store on Google Maps</p>
        <div class="contact-hero-fact">
          <span>Opening hours</span>
          <strong>{storeConfig.shortHours}</strong>
        </div>
        <div class="contact-hero-fact">
          <span>Visit our store</span>
          <strong>{storeConfig.shortAddress}</strong>
        </div>
        <a class="contact-explore-button" href={storeConfig.mapsUrl} target="_blank" rel="noopener noreferrer">Visit Store &amp; Buy (Directions) <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>

  <section class="section container contact-layout">
    <div class="contact-details-panel">
      <p class="eyebrow">Store details</p><h2>Come by<br /><em>and say hello.</em></h2>
      <dl class="contact-list">
        <div><dt>Address</dt><dd>{storeConfig.address}.</dd></div>
        <div><dt>Phone</dt><dd><a href={storeConfig.phoneHref}>{storeConfig.phoneDisplay}</a></dd></div>
        <div><dt>WhatsApp</dt><dd><a href={storeConfig.whatsappUrl} target="_blank" rel="noopener noreferrer">{storeConfig.phoneDisplay}</a></dd></div>
        <div><dt>Email</dt><dd><a data-email-contact href={storeConfig.emailHref}>Send an email</a></dd></div>
        <div><dt>Opening hours</dt><dd>{storeConfig.shortHours}</dd></div>
      </dl>
      <div class="contact-actions">
        <a class="contact-call-button" href={storeConfig.mapsUrl} target="_blank" rel="noopener noreferrer">Get Store Directions ↗</a>
        <a class="contact-whatsapp-button" href={storeConfig.phoneHref}>Call Store</a>
        <a class="contact-whatsapp-button" href={storeConfig.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
      </div>
    </div>

    <div class="directions-panel" id="directions">
      <p class="eyebrow">Find the shop</p><h2>Paddy Field Rd,<br /><em>Chinnaiyan Colony, Perambur.</em></h2>
      <p>{storeConfig.address}.</p>
      <StoreLocationMap client:visible />
      <a class="text-link" href={storeConfig.mapsUrl} target="_blank" rel="noopener noreferrer">Open directions in Google Maps ↗</a>
    </div>
  </section>

  <section class="section container contact-enquiry-section" aria-labelledby="contact-form-title">
    <div class="contact-form-card">
      <div class="contact-form-intro">
        <p class="eyebrow">Direct Store Enquiry</p>
        <h2 id="contact-form-title">Prepare a message for our counter team</h2>
        <p>Check product availability or ask about pack sizes before visiting. Validating your details here prepares an instant WhatsApp or Email message — we never claim a message was sent unless you send it from your app.</p>
      </div>

      <form id="contact-enquiry-form" class="contact-enquiry-form" novalidate data-thank-you-url={base + "thank-you/"}>
        <div class="contact-form-grid">
          <div class="contact-field">
            <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="80" required aria-describedby="contact-name-error" placeholder="e.g. Karthik Subramanian" />
            <p id="contact-name-error" class="contact-field-error" role="alert" hidden></p>
          </div>

          <div class="contact-field">
            <label for="contact-phone">Phone number <span aria-hidden="true">*</span></label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" required aria-describedby="contact-phone-error" placeholder="e.g. +91 98400 00000" />
            <p id="contact-phone-error" class="contact-field-error" role="alert" hidden></p>
          </div>

          <div class="contact-field contact-field--full">
            <label for="contact-email">Email address (optional, required only if sending by email)</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="120" aria-describedby="contact-email-error" placeholder="you@example.com" />
            <p id="contact-email-error" class="contact-field-error" role="alert" hidden></p>
          </div>

          <div class="contact-field contact-field--full">
            <label for="contact-message">What would you like to ask about? <span aria-hidden="true">*</span></label>
            <textarea id="contact-message" name="message" rows="4" maxlength="500" required aria-describedby="contact-message-error" placeholder="e.g. Looking for 2 kg Thinai (foxtail millet) and cold-pressed gingelly oil today."></textarea>
            <p id="contact-message-error" class="contact-field-error" role="alert" hidden></p>
          </div>
        </div>

        <div class="contact-form-actions">
          <button type="submit" id="contact-submit-btn" class="button">Prepare Store Enquiry →</button>
        </div>

        <div id="contact-form-feedback" class="contact-form-feedback" role="status" aria-live="polite" hidden>
          <strong id="contact-feedback-heading">Your enquiry message is ready</strong>
          <p id="contact-feedback-summary"></p>
          <div class="contact-dispatch-links">
            <a id="contact-dispatch-whatsapp" class="button" href={storeConfig.whatsappUrl} target="_blank" rel="noopener noreferrer">Send via WhatsApp ↗</a>
            <a id="contact-dispatch-email" class="button-whatsapp" href={storeConfig.emailHref}>Send via Email</a>
            <a id="contact-dispatch-confirm" class="text-link" href={base + "thank-you/"} hidden>Continue to confirmation page →</a>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="section container youtube-promo" aria-label="Follow Eshwar Home Products">
    <div class="social-profile-grid">
      <a class="social-profile-card" href={storeConfig.socials.youtube.url} target="_blank" rel="noopener noreferrer">
        <span><span class="eyebrow">Official YouTube</span><strong>{storeConfig.socials.youtube.handle}</strong></span>
        <span class="social-profile-action">Visit channel ↗</span>
      </a>
      <a class="social-profile-card" href={storeConfig.socials.instagram.url} target="_blank" rel="noopener noreferrer">
        <span><span class="eyebrow">Official Instagram</span><strong>{storeConfig.socials.instagram.handle}</strong></span>
        <span class="social-profile-action">Visit profile ↗</span>
      </a>
      {storeConfig.socials.facebook.url && (
        <a class="social-profile-card" href={storeConfig.socials.facebook.url} target="_blank" rel="noopener noreferrer">
          <span><span class="eyebrow">Official Facebook</span><strong>{storeConfig.socials.facebook.handle || "Eshwar Home Products"}</strong></span>
          <span class="social-profile-action">Visit page ↗</span>
        </a>
      )}
    </div>
  </section>
</SiteLayout>

<script>
  import { isValidEmail, isValidPhoneNumber } from "../utils/validation.mjs";

  const form = document.getElementById("contact-enquiry-form") as HTMLFormElement | null;
  if (form) {
    const nameInput = document.getElementById("contact-name") as HTMLInputElement;
    const phoneInput = document.getElementById("contact-phone") as HTMLInputElement;
    const emailInput = document.getElementById("contact-email") as HTMLInputElement;
    const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement;
    const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement;
    const feedback = document.getElementById("contact-form-feedback");
    const feedbackSummary = document.getElementById("contact-feedback-summary");
    const dispatchWa = document.getElementById("contact-dispatch-whatsapp") as HTMLAnchorElement;
    const dispatchEmail = document.getElementById("contact-dispatch-email") as HTMLAnchorElement;
    const dispatchConfirm = document.getElementById("contact-dispatch-confirm") as HTMLAnchorElement;

    let locked = false;

    const setFieldError = (input: HTMLElement, errorId: string, msg: string) => {
      const errEl = document.getElementById(errorId);
      if (msg) {
        input.setAttribute("aria-invalid", "true");
        if (errEl) {
          errEl.textContent = msg;
          errEl.hidden = false;
        }
      } else {
        input.removeAttribute("aria-invalid");
        if (errEl) {
          errEl.textContent = "";
          errEl.hidden = true;
        }
      }
    };

    [
      [nameInput, "contact-name-error"],
      [phoneInput, "contact-phone-error"],
      [emailInput, "contact-email-error"],
      [messageInput, "contact-message-error"],
    ].forEach(([field, errId]) => {
      (field as HTMLElement).addEventListener("input", () => {
        setFieldError(field as HTMLElement, errId as string, "");
        if (locked) {
          locked = false;
          submitBtn.disabled = false;
          submitBtn.textContent = "Prepare Store Enquiry →";
        }
      });
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (locked) return;

      const nameVal = nameInput.value.trim();
      const phoneVal = phoneInput.value.trim();
      const emailVal = emailInput.value.trim();
      const messageVal = messageInput.value.trim();

      let firstInvalid: HTMLElement | null = null;

      if (!nameVal) {
        setFieldError(nameInput, "contact-name-error", "Please enter your name.");
        firstInvalid = firstInvalid ?? nameInput;
      } else {
        setFieldError(nameInput, "contact-name-error", "");
      }

      if (!phoneVal) {
        setFieldError(phoneInput, "contact-phone-error", "Please enter your phone number.");
        firstInvalid = firstInvalid ?? phoneInput;
      } else if (!isValidPhoneNumber(phoneVal)) {
        setFieldError(phoneInput, "contact-phone-error", "Enter a valid 10-digit phone number (with or without +91).");
        firstInvalid = firstInvalid ?? phoneInput;
      } else {
        setFieldError(phoneInput, "contact-phone-error", "");
      }

      if (emailVal && !isValidEmail(emailVal)) {
        setFieldError(emailInput, "contact-email-error", "Please enter a valid email address or leave this field empty.");
        firstInvalid = firstInvalid ?? emailInput;
      } else {
        setFieldError(emailInput, "contact-email-error", "");
      }

      if (messageVal.length < 8) {
        setFieldError(messageInput, "contact-message-error", "Please enter at least 8 characters describing what you would like to ask.");
        firstInvalid = firstInvalid ?? messageInput;
      } else {
        setFieldError(messageInput, "contact-message-error", "");
      }

      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      locked = true;
      submitBtn.disabled = true;
      submitBtn.textContent = "Enquiry Ready Below";

      const formattedBody =
        `Hello Eshwar Home Products,\n\nName: ${nameVal}\nPhone: ${phoneVal}` +
        (emailVal ? `\nEmail: ${emailVal}` : "") +
        `\nEnquiry: ${messageVal}`;

      const storeEmail = [105,110,102,111,46,101,115,104,119,97,114,104,111,109,101,112,114,111,100,117,99,116,115,64,103,109,97,105,108,46,99,111,109]
        .map((c) => String.fromCharCode(c))
        .join("");

      dispatchWa.href = `https://wa.me/919941209953?text=${encodeURIComponent(formattedBody)}`;
      dispatchEmail.href = `mailto:${storeEmail}?subject=${encodeURIComponent(`Store Enquiry from ${nameVal}`)}&body=${encodeURIComponent(formattedBody)}`;

      if (feedbackSummary) {
        feedbackSummary.textContent = `Prepared for ${nameVal} (${phoneVal}). Choose WhatsApp or Email below to send your enquiry to the Perambur store.`;
      }
      if (feedback) feedback.hidden = false;
      dispatchConfirm.hidden = true;

      const revealConfirm = () => {
        dispatchConfirm.hidden = false;
      };
      dispatchWa.addEventListener("click", revealConfirm, { once: true });
      dispatchEmail.addEventListener("click", revealConfirm, { once: true });
      dispatchWa.focus();
    });
  }
</script>

<style>
  .social-profile-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .social-profile-card {
    display: flex;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 16px 20px;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-main);
    text-decoration: none;
    transition: border-color .18s var(--ease-out), transform .18s var(--ease-out);
  }
  .social-profile-card strong {
    display: block;
    color: var(--text-main);
    font-size: .95rem;
    overflow-wrap: anywhere;
  }
  .social-profile-card .eyebrow {
    display: block;
    margin-bottom: 4px;
    color: var(--accent-brass);
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: none;
  }
  .social-profile-action {
    flex: 0 0 auto;
    color: var(--accent-green);
    font-size: .875rem;
    font-weight: 600;
  }
  .social-profile-card:hover {
    border-color: var(--accent-green);
    transform: translateY(-2px);
  }
  @media (max-width: 600px) {
    .social-profile-grid { grid-template-columns: 1fr; }
  }
  .contact-hero-grid {
    width: min(1200px, calc(100% - (2 * clamp(16px, 4vw, 32px))));
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }
  .contact-hero-copy { max-width: 620px; }
  .contact-hero-card {
    position: relative;
    padding: 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    text-align: left;
  }
  .contact-hero-rating {
    margin: 0 0 20px;
    color: var(--text-main);
    font-size: .9375rem;
    font-weight: 600;
    line-height: 1.55;
  }
  .contact-hero-rating span {
    display: block;
    margin-bottom: 4px;
    color: var(--accent-brass);
    font-size: 1.1rem;
  }
  .contact-hero-fact {
    display: grid;
    gap: 6px;
    padding: 14px 0;
    border-top: 1px solid var(--border-light);
  }
  .contact-hero-fact span {
    color: var(--text-muted);
    font-size: .8125rem;
    font-weight: 600;
  }
  .contact-hero-fact strong {
    color: var(--text-main);
    font-size: .9375rem;
    line-height: 1.6;
  }
  .contact-explore-button,
  .contact-call-button,
  .contact-whatsapp-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: .88rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background-color .18s var(--ease-out), border-color .18s var(--ease-out), transform .18s var(--ease-out);
  }
  .contact-explore-button {
    width: 100%;
    margin-top: 16px;
    background: var(--accent-green);
    border-color: var(--accent-green);
    color: #FFFFFF;
  }
  .contact-explore-button:hover {
    background: var(--accent-green-hover);
    border-color: var(--accent-green-hover);
    color: #FFFFFF;
    transform: translateY(-1px);
  }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .contact-call-button {
    background: var(--accent-green);
    border-color: var(--accent-green);
    color: #FFFFFF;
  }
  .contact-call-button:hover {
    background: var(--accent-green-hover);
    border-color: var(--accent-green-hover);
    color: #FFFFFF;
    transform: translateY(-1px);
  }
  .contact-whatsapp-button {
    background: var(--bg-card);
    border-color: var(--border-light);
    color: var(--text-main);
  }
  .contact-whatsapp-button:hover {
    background: var(--bg-subtle);
    border-color: var(--accent-green);
    color: var(--text-main);
    transform: translateY(-1px);
  }
  .contact-layout,
  .contact-enquiry-section,
  .youtube-promo {
    width: min(1200px, calc(100% - (2 * clamp(16px, 4vw, 32px))));
    margin-inline: auto;
  }
  .directions-panel {
    padding: 28px;
  }
  .contact-form-card {
    padding: clamp(22px, 4vw, 36px);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    background: var(--bg-card);
  }
  .contact-form-intro h2 {
    margin: 8px 0 10px;
    font-size: clamp(1.65rem, 3vw, 2.2rem);
    font-weight: 500;
  }
  .contact-form-intro p:not(.eyebrow) {
    max-width: 68ch;
    margin: 0 0 22px;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .contact-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .contact-field--full {
    grid-column: 1 / -1;
  }
  .contact-field label {
    color: var(--text-main);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .contact-field input,
  .contact-field textarea {
    width: 100%;
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    background: var(--bg-page);
    color: var(--text-main);
    font: inherit;
  }
  .contact-field textarea {
    resize: vertical;
  }
  .contact-field input[aria-invalid="true"],
  .contact-field textarea[aria-invalid="true"] {
    border-color: #9B2C20;
  }
  .contact-field-error {
    margin: 0;
    color: #9B2C20;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .contact-form-actions {
    margin-top: 18px;
  }
  .contact-form-feedback {
    margin-top: 20px;
    padding: 18px;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    background: var(--bg-subtle);
  }
  .contact-form-feedback strong {
    display: block;
    margin-bottom: 6px;
    color: var(--accent-green);
    font-size: 1rem;
  }
  .contact-form-feedback p {
    margin: 0 0 14px;
    color: var(--text-main);
    font-size: 0.9375rem;
  }
  .contact-dispatch-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 760px) {
    .contact-hero { padding: 28px 0 34px; }
    .contact-hero-grid { grid-template-columns: 1fr; gap: 22px; }
    .contact-hero-card { max-width: 520px; padding: 20px; }
    .contact-layout,
    .contact-enquiry-section,
    .youtube-promo { width: calc(100% - 32px); }
    .contact-list a { display: inline-flex; min-height: 44px; align-items: center; }
    .directions-panel { padding: 20px; }
    .contact-form-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .contact-actions,
    .contact-dispatch-links { display: grid; grid-template-columns: 1fr; }
    .contact-call-button,
    .contact-whatsapp-button,
    .contact-form-actions .button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .social-profile-card,
    .contact-explore-button,
    .contact-call-button,
    .contact-whatsapp-button { transition: none; }
  }
</style>