---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/mobile-responsive.css";
const base = import.meta.env.BASE_URL;
const reviewsUrl = "https://www.google.com/search?q=Eshwar+Home+Products+Perambur+reviews";
---
<SiteLayout title="Profile | Eshwar Home Products" description="Find the Eshwar Home Products story, customer review links and store location in Perambur, Chennai." current="profile">
  <section class="profile-page">
    <div class="profile-shell">
      <p class="profile-eyebrow">ESH​WAR HOME PRODUCTS · PERAMBUR</p>
      <h1>Your store profile</h1>
      <p class="profile-intro">A quick place to learn about our store, find customer reviews and reach us.</p>
      <div class="profile-links">
        <a class="profile-card profile-about" href={base + "about/"}>
          <span class="profile-card-kicker">Our story</span>
          <span class="profile-card-title">About Us</span>
          <span class="profile-card-copy">How Eshwar Home Products began and what guides our store.</span>
          <span class="profile-card-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="profile-card profile-reviews" href={reviewsUrl} target="_blank" rel="noopener noreferrer">
          <span class="profile-card-kicker">Google Search</span>
          <span class="profile-card-title">Reviews</span>
          <span class="profile-card-copy">Find customer feedback about Eshwar Home Products on Google.</span>
          <span class="profile-card-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
      <a class="profile-map-card" href={base + "contact/"} aria-label="Open Contact Us for store location and directions">
        <span class="profile-map-art" aria-hidden="true">
          <span class="map-road map-road-one"></span><span class="map-road map-road-two"></span><span class="map-road map-road-three"></span>
          <span class="map-block map-block-one"></span><span class="map-block map-block-two"></span><span class="map-block map-block-three"></span>
          <span class="map-pin"><span></span></span>
          <span class="map-label">PERAMBUR</span>
        </span>
        <span class="profile-map-copy">
          <span class="profile-card-kicker">Find our store</span>
          <span class="profile-card-title">A tiny map</span>
          <span class="profile-card-copy">119/1, Paddy Field Road, Chinnaiyan Colony, Perambur, Chennai 600011.</span>
          <span class="profile-map-cta">Open Contact Us ↗</span>
        </span>
      </a>
    </div>
  </section>
</SiteLayout>
<style>
  .profile-page{min-height:70vh;padding:clamp(36px,7vw,76px) 20px 52px;background:#F5EDE3;color:#3B2112}
  .profile-shell{width:min(100%,820px);margin:0 auto}
  .profile-eyebrow,.profile-card-kicker{display:block;color:#75553E;font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .profile-page h1{margin:10px 0 8px;color:#3B2112;font-family:Georgia,serif;font-size:clamp(2.1rem,7vw,3.8rem);line-height:1.05;letter-spacing:-.035em}
  .profile-intro{max-width:540px;margin:0;color:#5E4635;font-size:1rem;line-height:1.65}
  .profile-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:30px}
  .profile-card,.profile-map-card{position:relative;display:flex;min-width:0;flex-direction:column;gap:9px;padding:22px;border:1px solid #D7C6B4;background:#FBF7F1;color:#3B2112;text-decoration:none}
  .profile-card{min-height:180px}
  .profile-card-title{font-family:Georgia,serif;font-size:1.65rem;font-weight:700;line-height:1.15}
  .profile-card-copy{color:#5E4635;font-size:.92rem;line-height:1.55}
  .profile-card-arrow{position:absolute;right:18px;top:17px;color:#8A5A20;font-size:1.1rem}
  .profile-map-card{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:20px;margin-top:14px;padding:14px}
  .profile-map-art{position:relative;display:block;min-height:170px;overflow:hidden;background-color:#E8E0D4;background-image:linear-gradient(30deg,transparent 46%,#D0C2AF 47%,#D0C2AF 51%,transparent 52%),linear-gradient(112deg,transparent 42%,#D0C2AF 43%,#D0C2AF 47%,transparent 48%),linear-gradient(0deg,transparent 48%,#D8CBB9 49%,#D8CBB9 53%,transparent 54%)}
  .map-road{position:absolute;display:block;background:#F8F3EB;border:1px solid #D2C2AE}
  .map-road-one{left:-8%;top:45%;width:120%;height:18px;transform:rotate(-16deg)}
  .map-road-two{left:43%;top:-20%;width:16px;height:150%;transform:rotate(17deg)}
  .map-road-three{left:8%;top:18%;width:85%;height:12px;transform:rotate(38deg)}
  .map-block{position:absolute;display:block;background:#D5DDC8;border:1px solid #BEC9B0}
  .map-block-one{left:8%;top:8%;width:25%;height:22%}
  .map-block-two{right:8%;top:12%;width:23%;height:27%}
  .map-block-three{left:10%;bottom:8%;width:25%;height:20%}
  .map-pin{position:absolute;left:57%;top:36%;display:grid;width:28px;height:28px;place-items:center;border:3px solid #F5EDE3;border-radius:50% 50% 50% 0;background:#8A3B24;transform:rotate(-45deg);box-shadow:0 0 0 1px #8A3B24}
  .map-pin span{width:8px;height:8px;border-radius:50%;background:#F5EDE3}
  .map-label{position:absolute;right:9px;bottom:8px;padding:4px 6px;background:#3B2112;color:#F5EDE3;font-size:.62rem;font-weight:700;letter-spacing:.1em}
  .profile-map-copy{display:flex;flex-direction:column;justify-content:center;gap:9px}
  .profile-map-cta{margin-top:4px;color:#75470F;font-size:.88rem;font-weight:800}
  .profile-card:focus-visible,.profile-map-card:focus-visible{outline:3px solid #8A5A20;outline-offset:3px}
  @media(max-width:560px){.profile-links{grid-template-columns:1fr}.profile-card{min-height:140px}.profile-map-card{grid-template-columns:1fr}.profile-map-art{min-height:150px}.profile-page{padding-inline:16px}}
</style>
