---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/company-profile.css";
import { siteConfig, sitePath } from "../app/config/site";
const sections = [
  { number: "01", title: "About Us", description: "What we do, the pantry ranges we offer and the values behind our neighbourhood store.", href: sitePath("profile/about/"), label: "Company overview", icon: "M4 21h16M6 21V7l6-4 6 4v14M9 10h.01M15 10h.01M9 14h.01M15 14h.01M10 21v-4h4v4" },
  { number: "02", title: "Our Story", description: "The thought that began in 2023, our family deity and the meaning behind our emblem.", href: sitePath("profile/our-story/"), label: "Our beginnings", icon: "M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5zM5 4.5v17M9 7h7M9 11h7" },
  { number: "03", title: "Ratings & Reviews", description: "Read customer feedback published after review, or share your own experience.", href: sitePath("profile/reviews/"), label: "Customer feedback", icon: "m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" },
  { number: "04", title: "Comments", description: "Send a suggestion, ask a question or leave a general message for our team.", href: sitePath("profile/comments/"), label: "Share feedback", icon: "M20 11.5a7.5 7.5 0 0 1-7.5 7.5H8l-4 2v-5.1A7.5 7.5 0 1 1 20 11.5Z M8 11h8M8 14h5" },
];
---
<SiteLayout title="Company Profile | Eshwar Home Products" description="Learn about Eshwar Home Products, our story, customer reviews and ways to share feedback with our Perambur store team." current="profile">
  <div class="company-profile profile-home">
    <section class="cp-hero"><div class="cp-hero-decoration" aria-hidden="true"></div><div class="container cp-hero-inner">
      <a class="cp-back-link cp-back-light" href={sitePath()}>← <span>Back to website</span></a>
      <div class="cp-brand-lockup"><div class="cp-logo-frame"><img src={sitePath("images/brand/eshwar-home-products-logo.png")} alt="Eshwar Home Products official Rudraksha and Trishul emblem" width="320" height="183" /></div><div><p class="cp-kicker">THE COMPANY PROFILE</p><h1>Eshwar Home Products</h1><p lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p></div></div>
      <p class="cp-hero-intro">A neighbourhood pantry shaped by devotion, traditional food and care for everyday kitchens.</p><div class="cp-hero-meta"><span>Perambur, Chennai</span><span aria-hidden="true">·</span><span>Traditional pantry essentials</span></div>
    </div></section>
    <section class="cp-section container" aria-labelledby="cp-menu-title"><div class="cp-section-heading"><p class="cp-eyebrow">EXPLORE THE PROFILE</p><h2 id="cp-menu-title">Get to know us.</h2><p>Choose a section to learn more about the store or connect with our team.</p></div><div class="cp-menu-grid">
      {sections.map((item) => <a class="cp-menu-card" href={item.href}><span class="cp-card-top"><span class="cp-number">{item.number}</span><span class="cp-card-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={item.icon}/></svg></span></span><span class="cp-card-label">{item.label}</span><h3>{item.title}</h3><p>{item.description}</p><span class="cp-card-link">Explore section <span aria-hidden="true">↗</span></span></a>)}
    </div></section>
    <section class="cp-grievance-wrap"><div class="container cp-grievance"><div><p class="cp-eyebrow">CUSTOMER SUPPORT</p><h2>Grievance & customer care</h2><p>For a concern, complaint or service-related question, contact the Eshwar Home Products team through the verified store channels below. Please include your contact details and a clear description of the issue so the team can respond.</p><p class="cp-disclosure">A named Grievance Officer and separate grievance contact have not been provided for publication.</p></div><div class="cp-contact-details"><a href={"mailto:" + siteConfig.email}><span>Email</span><strong>{siteConfig.email}</strong></a><a href={"tel:" + siteConfig.phoneLink}><span>Phone</span><strong>{siteConfig.phoneDisplay}</strong></a><a href={sitePath("contact/")}><span>Store information</span><strong>Address, hours & directions ↗</strong></a></div></div></section>
    <section class="container cp-bottom-cta"><div><p class="cp-eyebrow">WE’RE HERE TO HELP</p><h2>Looking for something for your pantry?</h2><p>Browse the catalogue or speak with the store team about product availability.</p></div><div><a class="cp-button cp-button-dark" href={sitePath("products/")}>Explore products ↗</a><a class="cp-button cp-button-outline" href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp the store ↗</a></div></section>
  </div>
</SiteLayout>
