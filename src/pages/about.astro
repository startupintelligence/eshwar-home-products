---
import SiteLayout from "../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Our story | Eshwar Home Products" description="Meet Eshwar Home Products, a neighbourhood traditional foods store on Nelvayal Road in Perambur, Chennai." current="about">
  <div class="reading-progress" aria-hidden="true"></div>
  <section class="page-heading"><div class="container">
    <p class="eyebrow">Our story · Perambur</p>
    <h1>A neighbourhood store<br /><em>for everyday kitchens.</em></h1>
    <p>Traditional foods and pantry essentials, brought together in one familiar place on Nelvayal Road.</p>
  </div></section>
  <section class="section container about-content">
    <div class="about-aside"><span>ESH</span><p>ESHWAR HOME PRODUCTS<br />PERAMBUR · CHENNAI</p></div>
    <div class="prose">
      <p class="eyebrow">What matters to us</p>
      <h2>Useful ingredients.<br /><em>A local place to find them.</em></h2>
      <p>Eshwar Home Products is a neighbourhood food store in Perambur, Chennai. The range brings together traditional rice varieties, millets, millet-based foods, cooking oils and other pantry essentials.</p>
      <p>We know that people often visit with a particular ingredient or variety in mind. If you are looking for something specific, call us before you travel. Our team can help you check what is currently available.</p>
      <a class="button button-dark" href={base + "contact/"}>Visit the store <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="visit-note"><div class="container visit-note-inner">
    <p class="eyebrow">In Perambur, Chennai</p>
    <h2>Find us on<br /><em>Nelvayal Road.</em></h2>
    <p>Door No. 119/1, Nelvayal Road, Perambur, Chennai – 600011</p>
    <a class="text-link" href={base + "contact/"}>Contact and directions ↗</a>
  </div></section>
</SiteLayout>
