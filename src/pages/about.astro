---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/story-theme2.css";

const base = import.meta.env.BASE_URL;
const mapsUrl = "https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu&g_ep=EgoyMDI2MTExNS4wIKXMDSoASAFQAw%3D%3D";
const whatsappUrl = "https://wa.me/919941209953";
const pantryRanges = ["Traditional rice varieties", "Millets & millet flours", "Flakes, vermicelli & pasta", "Cold-pressed oils", "Ghee & dairy essentials", "Honey, pulses & more"];
---
<SiteLayout title="Our Story | Eshwar Home Products, Perambur" description="Discover the story behind Eshwar Home Products, named in devotion to the family deity Eshwaran, and serving everyday kitchens in Perambur, Chennai." current="about">
  <div class="ehp-about-page">
    <section class="ehp-about-hero" aria-labelledby="about-title">
      <div class="container ehp-about-hero-inner">
        <div class="ehp-about-hero-copy">
          <p class="ehp-about-tamil" lang="ta">ஈஸ்வர் ஹோம் புராடக்ட்ஸ்</p>
          <p class="ehp-about-eyebrow">Our Story <span aria-hidden="true">·</span> Perambur, Chennai</p>
          <h1 id="about-title">Named after Eshwaran.<br /><em>Built for everyday kitchens in Perambur.</em></h1>
          <p class="ehp-about-intro">A neighbourhood pantry shaped by devotion, familiar foods and the simple value of helping people find what they need.</p>
          <a class="ehp-about-rating reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer" aria-label="5.0 star Google Maps rating">5.0 <span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span> Google Maps rating</a>
        </div>
        <aside class="ehp-about-hero-proof" aria-label="Neighbourhood store details">
          <a class="ehp-about-hero-proof-rating reveal-item" href={mapsUrl} target="_blank" rel="noopener noreferrer"><strong>5.0 <span class="five-stars-reveal" role="img" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map((i) => <span class="star-item" aria-hidden="true">★</span>)}</span></strong> Rated Neighbourhood Store on Google Maps</a>
          <p>119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai 600011</p>
          <p>Mon–Sat: 9:00 AM – 9:00 PM · Sun: Closed</p>
        </aside>
      </div>
    </section>

    <section class="ehp-name-story" aria-labelledby="name-story-title">
      <div class="container ehp-name-story-grid">
        <div class="ehp-name-mark"><img class="ehp-story-logo" src={base + "images/brand/eshwar-home-products-logo.png"} alt="Official Eshwar Home Products emblem with a Rudraksha bead, golden Trishuls, Damrus and lemons" width="320" height="183" loading="lazy" decoding="async" /></div>
        <div class="ehp-about-prose">
          <p class="ehp-about-eyebrow">The Story Behind Our Name</p>
          <h2 id="name-story-title">A name held with <em>devotion.</em></h2>
          <p>Eshwar Home Products is named with devotion after our family deity, Eshwaran (Lord Shiva). It is a meaningful part of the store’s identity, not just a name on the signboard.</p>
          <p>That devotion is reflected in the official Rudraksha and Trishul emblem. It also reminds us of the values we want our neighbourhood store to stand for: honesty, gratitude and care in the everyday foods people bring home.</p>
          <p>Our aim is simple: make familiar pantry essentials easier to find, and make every visit feel welcoming and straightforward.</p>
        </div>
      </div>
    </section>

    <section class="ehp-about-pantry" aria-labelledby="about-pantry-title">
      <div class="container">
        <p class="ehp-about-eyebrow">Explore the Pantry</p>
        <h2 id="about-pantry-title">Six ranges to <em>explore.</em></h2>
        <div class="ehp-about-ranges">
          {pantryRanges.map((range, index) => <a class="ehp-about-range-link" href={whatsappUrl + "?text=" + encodeURIComponent("Hello Eshwar Home Products, I would like to enquire about " + range + ".")} target="_blank" rel="noopener noreferrer">
            <span>{String(index + 1).padStart(2, "0")}</span><strong>{range}</strong><span>WhatsApp enquiry ↗</span>
          </a>)}
        </div>
      </div>
    </section>

    <section class="ehp-commitments" aria-labelledby="commitments-title">
      <div class="container">
        <div class="ehp-commitments-heading">
          <p class="ehp-about-eyebrow">What You Can Expect</p>
          <h2 id="commitments-title">Everyday essentials.<br /><em>Considered service.</em></h2>
        </div>
        <div class="ehp-commitment-grid">
          <article class="ehp-commitment">
            <span class="ehp-commitment-number">01</span>
            <h3>Honest Pantry Guidance</h3>
            <p>Helping Perambur families choose the traditional rice, millet (<em>Siruthaniyam</em>) or cold-pressed oils that suits their everyday cooking needs.</p>
          </article>
          <article class="ehp-commitment">
            <span class="ehp-commitment-number">02</span>
            <h3>All Essentials Under One Roof</h3>
            <p>Bringing together whole grains, millet flours, cold-pressed oils, ghee, honey, nuts and pantry essentials in one accessible neighbourhood stop.</p>
          </article>
          <article class="ehp-commitment">
            <span class="ehp-commitment-number">03</span>
            <h3>Convenient Neighbourhood Hours</h3>
            <p>Visit us Monday to Saturday, 9:00 AM–9:00 PM, and Sunday: Closed, at Door No. 119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="ehp-visit-cta" aria-labelledby="visit-cta-title">
      <div class="container ehp-visit-cta-inner">
        <div>
          <p class="ehp-about-eyebrow">Visit & Enquire</p>
          <h2 id="visit-cta-title">A familiar place for your <em>everyday pantry.</em></h2>
          <p>Looking for a particular variety or pack size? Speak with the store team before you visit.</p>
          <p class="ehp-address">Door No. 119/1, Paddy Field Rd, Chinnaiyan Colony, Perambur, Chennai, Tamil Nadu 600011, India.</p>
        </div>
        <div class="ehp-visit-actions">
          <a class="ehp-action ehp-action-primary" href={base + "products/"}>Explore the Pantry <span aria-hidden="true">↗</span></a>
          <a class="ehp-action ehp-action-secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Chat on WhatsApp <span aria-hidden="true">↗</span></a>
          <a class="ehp-action ehp-action-outline" href={mapsUrl} target="_blank" rel="noopener noreferrer">Get Directions <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
