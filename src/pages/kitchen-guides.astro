---
import SiteLayout from "../layouts/SiteLayout.astro";
import { storeConfig } from "../data/store";

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? new URL("https://startupintelligence.github.io");
const pageUrl = new URL(base + "kitchen-guides/", siteOrigin).toString();

const guides = [
  {
    number: "01",
    eyebrow: "Tamil · English reference",
    title: "A simple guide to Tamil millet names",
    description: "Match familiar names such as Thinai, Varagu and Kuthiraivali with their English grain names and common kitchen uses.",
    href: base + "perambur-millet-store/#millet-reference",
    action: "Open the millet reference"
  },
  {
    number: "02",
    eyebrow: "Breakfast · Tiffin · Meals",
    title: "Millets in everyday South Indian cooking",
    description: "Explore meal ideas such as upma, pongal, dosa and other familiar ways grains and millet flours are used at home.",
    href: base + "products/#grains",
    action: "Explore rice & millets"
  },
  {
    number: "03",
    eyebrow: "Kitchen essentials · Chekku",
    title: "A guide to traditional cooking oils",
    description: "Get familiar with gingelly, groundnut and coconut oils, and the role of ghee in everyday kitchen routines.",
    href: base + "products/#oils",
    action: "Explore oils & ghee"
  },
  {
    number: "04",
    eyebrow: "Tea-time · Tiffin · Pantry",
    title: "Millet snacks and quick pantry ideas",
    description: "Browse millet flakes, sevai, pasta, cookies and other pantry categories as options to ask about for tea-time and tiffin.",
    href: base + "products/#pantry",
    action: "Explore snacks & pantry"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Kitchen Guides | Eshwar Home Products",
  url: pageUrl,
  description: "Practical Tamil kitchen references and pantry guides from Eshwar Home Products in Perambur, Chennai.",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: guides.map((guide, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: guide.title,
      url: new URL(guide.href, siteOrigin).toString()
    }))
  }
};
---
<SiteLayout
  title="Kitchen Guides & Tamil Pantry Notes | Eshwar Home Products"
  description="Practical Tamil kitchen references, millet name guides and pantry-use notes from Eshwar Home Products in Perambur, Chennai."
  current="kitchen-guides"
  canonicalUrl={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="kitchen-guides-hero" aria-labelledby="kitchen-guides-title">
    <div class="container kitchen-guides-hero-grid">
      <div class="kitchen-guides-copy">
        <nav class="kitchen-guides-breadcrumbs" aria-label="Breadcrumb">
          <a href={base}>Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Kitchen Guides</span>
        </nav>
        <p class="eyebrow">Kitchen notes · Eshwar Home Products · Perambur</p>
        <h1 id="kitchen-guides-title">Small guides for<br />the <em>everyday</em><br /><em>Tamil kitchen.</em></h1>
        <p class="kitchen-guides-intro">Helpful references for grains, pantry staples and familiar South Indian cooking. Start with a name, a meal or an ingredient, then explore the store’s pantry guide.</p>
      </div>

      <aside class="kitchen-guides-store-card" aria-label="Eshwar Home Products store details">
        <p class="eyebrow">Your neighbourhood pantry</p>
        <h2>Eshwar Home Products</h2>
        <address>{storeConfig.shortAddress}</address>
        <p class="kitchen-guides-hours">{storeConfig.shortHours}</p>
        <a class="kitchen-guides-pantry-button" href={base + "products/"}>Explore the Pantry <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>

  <section class="container kitchen-guides-list" aria-labelledby="kitchen-guides-list-title">
    <div class="kitchen-guides-list-heading">
      <div>
        <p class="eyebrow">Browse the guide shelf</p>
        <h2 id="kitchen-guides-list-title">Practical notes, close to home.</h2>
      </div>
      <a class="kitchen-guides-browse-link" href={base + "products/"}>Browse the pantry ↗</a>
    </div>

    <div class="kitchen-guides-grid">
      {guides.map((guide) => (
        <button class="kitchen-guide-card" type="button" data-ehp-dialog="guide" data-ehp-title={guide.title} data-ehp-description={guide.description} data-ehp-href={guide.href} data-ehp-action={guide.action} data-ehp-items={JSON.stringify(guide.number === "01" ? ["Millets", "Rice"] : guide.number === "02" ? ["Rice", "Millets"] : guide.number === "03" ? ["Cold-Pressed Oil", "Ghee"] : ["Millets", "Sathumaavu"])} aria-haspopup="dialog">
          <span class="eyebrow">{guide.number} · {guide.eyebrow}</span><h3>{guide.title}</h3><p>{guide.description}</p>
          <span class="kitchen-guide-card-action">{guide.action} <span aria-hidden="true">↗</span></span>
        </button>
      ))}
    </div>

    <p class="kitchen-guides-note">These guides explain names and common kitchen uses. They are not medical advice or a live inventory. For current product details, varieties and pack sizes, contact the Perambur store directly.</p>
  </section>
</SiteLayout>

<style>
  .kitchen-guides-hero {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-light);
  }

  .kitchen-guides-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr);
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
    padding-block: clamp(44px, 6vw, 76px);
  }

  .kitchen-guides-copy { min-width: 0; }

  .kitchen-guides-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    color: var(--text-muted);
    font-size: .82rem;
  }

  .kitchen-guides-breadcrumbs a {
    color: var(--text-muted);
    text-underline-offset: 3px;
  }

  .kitchen-guides-copy > .eyebrow,
  .kitchen-guides-store-card > .eyebrow,
  .kitchen-guides-list-heading .eyebrow {
    margin: 0 0 10px;
    color: var(--accent-brass);
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: none;
  }

  .kitchen-guides-copy h1 {
    max-width: 680px;
    margin: 0;
    color: var(--text-main);
    font-family: var(--serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .kitchen-guides-copy h1 em {
    font-weight: 400;
    color: var(--accent-brass);
  }

  .kitchen-guides-intro {
    max-width: 570px;
    margin: 18px 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .kitchen-guides-store-card {
    width: 100%;
    padding: 28px;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    background: var(--bg-card);
  }

  .kitchen-guides-store-card h2 {
    margin: 0 0 12px;
    color: var(--text-main);
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .kitchen-guides-store-card address,
  .kitchen-guides-hours {
    margin: 0;
    color: var(--text-muted);
    font-size: .88rem;
    font-style: normal;
    line-height: 1.65;
  }

  .kitchen-guides-hours { margin-top: 8px; }

  .kitchen-guides-pantry-button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    padding: 0 20px;
    border: 1px solid var(--accent-green);
    border-radius: 8px;
    background: var(--accent-green);
    color: #FFFFFF;
    font-size: .88rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color .18s var(--ease-out), transform .18s var(--ease-out);
  }

  .kitchen-guides-pantry-button:hover {
    border-color: var(--accent-green-hover);
    background: var(--accent-green-hover);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .kitchen-guides-list {
    padding-block: clamp(44px, 5vw, 72px);
  }

  .kitchen-guides-list-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .kitchen-guides-list-heading h2 {
    margin: 0;
    color: var(--text-main);
    font-family: var(--serif);
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -.025em;
  }

  .kitchen-guides-browse-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--accent-green);
    font-size: .88rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  .kitchen-guides-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .kitchen-guide-card {
    display: flex;
    min-width: 0;
    min-height: 210px;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(20px, 2.4vw, 28px);
    border: 1px solid var(--border-light);
    border-radius: 12px;
    background: var(--bg-card);
    color: var(--text-main);
    font-family: var(--sans);
    text-align: left;
    cursor: pointer;
    transition: transform .18s var(--ease-out), border-color .18s var(--ease-out), box-shadow .18s var(--ease-out);
  }

  .kitchen-guide-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-green);
    box-shadow: 0 12px 28px rgba(24, 56, 40, 0.08);
  }

  .kitchen-guide-card:focus-visible {
    outline: 2px solid var(--accent-green);
    outline-offset: 3px;
  }

  .kitchen-guide-card > .eyebrow {
    margin: 0 0 10px;
    color: var(--accent-brass);
    font-size: .8125rem;
    font-weight: 600;
    letter-spacing: .02em;
  }

  .kitchen-guide-card h3 {
    margin: 0;
    color: var(--text-main);
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
  }

  .kitchen-guide-card > p {
    margin: 10px 0 18px;
    color: var(--text-muted);
    font-size: .9375rem;
    line-height: 1.65;
  }

  .kitchen-guide-card-action {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    color: var(--accent-green);
    font-size: .875rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(24, 56, 40, 0.35);
    text-underline-offset: 4px;
  }

  .kitchen-guides-note {
    margin: 24px 0 0;
    padding: 16px 20px;
    border: 1px solid var(--border-light);
    border-radius: 10px;
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: .875rem;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .kitchen-guides-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      padding-block: 34px 38px;
    }

    .kitchen-guides-breadcrumbs { margin-bottom: 16px; }
    .kitchen-guides-copy h1 { font-size: clamp(2.2rem, 10vw, 3.2rem); }
    .kitchen-guides-store-card { max-width: 520px; padding: 22px; }
    .kitchen-guides-list { padding-block: 36px 48px; }
    .kitchen-guides-list-heading { align-items: flex-start; flex-direction: column; gap: 8px; }
    .kitchen-guides-grid { grid-template-columns: minmax(0, 1fr); }
    .kitchen-guide-card { min-height: 176px; padding: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .kitchen-guide-card,
    .kitchen-guides-pantry-button { transition: none; }
    .kitchen-guide-card:hover { transform: none; }
  }
</style>