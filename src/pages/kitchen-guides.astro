---
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? new URL("https://startupintelligence.github.io");
const pageUrl = new URL(base + "kitchen-guides/", siteOrigin).toString();

const guides = [
  {
    number: "01",
    eyebrow: "Tamil · English reference",
    title: "A simple guide to Tamil millet names",
    description: "Match familiar names such as Thinai, Varagu and Kuthiraivali with their English grain names and common kitchen uses.",
    href: base + "perambur-millet-store/#millet-reference",
    action: "Open the millet reference"
  },
  {
    number: "02",
    eyebrow: "Breakfast · Tiffin · Meals",
    title: "Millets in everyday South Indian cooking",
    description: "Explore meal ideas such as upma, pongal, dosa and other familiar ways grains and millet flours are used at home.",
    href: base + "products/#grains",
    action: "Explore rice & millets"
  },
  {
    number: "03",
    eyebrow: "Kitchen essentials · Chekku",
    title: "A guide to traditional cooking oils",
    description: "Get familiar with gingelly, groundnut and coconut oils, and the role of ghee in everyday kitchen routines.",
    href: base + "products/#oils",
    action: "Explore oils & ghee"
  },
  {
    number: "04",
    eyebrow: "Tea-time · Tiffin · Pantry",
    title: "Millet snacks and quick pantry ideas",
    description: "Browse millet flakes, sevai, pasta, cookies and other pantry categories as options to ask about for tea-time and tiffin.",
    href: base + "products/#pantry",
    action: "Explore snacks & pantry"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Kitchen Guides | Eshwar Home Products",
  url: pageUrl,
  description: "Practical Tamil kitchen references and pantry guides from Eshwar Home Products in Perambur, Chennai.",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: guides.map((guide, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: guide.title,
      url: new URL(guide.href, siteOrigin).toString()
    }))
  }
};
---

<SiteLayout
  title="Kitchen Guides & Tamil Pantry Notes | Eshwar Home Products"
  description="Practical Tamil kitchen references, millet name guides and pantry-use notes from Eshwar Home Products in Perambur, Chennai."
  current="blog"
  canonicalUrl={pageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="guide-hero guide-hero-balanced" aria-labelledby="kitchen-guides-title">
    <div class="container guide-hero-layout">
      <div class="guide-hero-copy">
        <nav class="guide-breadcrumb" aria-label="Breadcrumb">
          <a href={base}>Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Kitchen Guides</span>
        </nav>
        <p class="eyebrow">Kitchen notes · Eshwar Home Products · Perambur</p>
        <h1 id="kitchen-guides-title">Small guides for the <em>everyday Tamil kitchen.</em></h1>
        <p class="guide-hero-intro">Helpful references for grains, pantry staples and familiar South Indian cooking. Start with a name, a meal or an ingredient, then explore the store's pantry guide.</p>
      </div>

      <aside class="guide-reference-card" aria-label="Eshwar Home Products store information">
        <p class="guide-reference-kicker">Your neighbourhood pantry</p>
        <h2>Eshwar Home Products</h2>
        <p class="guide-reference-address">119/1, Paddy Field Road, Perambur, Chennai 600 011</p>
        <p class="guide-reference-hours">Mon–Sat: 9:00 AM – 9:00 PM · Sun: Closed</p>
        <a class="guide-reference-button" href={base + "products/"}>Explore the Pantry <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  <section class="container guide-list" aria-labelledby="guide-list-title">
    <div class="guide-list-heading">
      <div>
        <p class="eyebrow">Browse the guide shelf</p>
        <h2 id="guide-list-title">Practical notes, close to home.</h2>
      </div>
      <a class="text-link" href={base + "products/"}>Browse the pantry ↗</a>
    </div>

    <div class="guide-grid">
      {guides.map((guide) => (
        <a class="guide-card guide-card-tappable" href={guide.href} aria-label={guide.title}>
          <span class="eyebrow">{guide.number} · {guide.eyebrow}</span>
          <h3>{guide.title}</h3>
          <p>{guide.description}</p>
          <span class="guide-card-link">{guide.action} ↗</span>
        </a>
      ))}
    </div>

    <p class="guide-note">These guides explain names and common kitchen uses. They are not medical advice or a live inventory. For current product details, varieties and pack sizes, contact the Perambur store directly.</p>
  </section>
</SiteLayout>

<style>
  .guide-hero-balanced {
    padding-block: clamp(42px, 6vw, 72px);
  }

  .guide-hero-layout {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }

  .guide-hero-copy {
    min-width: 0;
  }

  .guide-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  .guide-breadcrumb a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-light);
    text-underline-offset: 4px;
  }

  .guide-breadcrumb [aria-current="page"] {
    color: var(--text-main);
    font-weight: 650;
  }

  .guide-hero-copy h1 {
    max-width: 760px;
    margin: 12px 0 18px;
    font-size: clamp(2.55rem, 5.2vw, 4.7rem);
  }

  .guide-hero-copy h1 em {
    color: var(--earth-dark);
  }

  .guide-hero-intro {
    max-width: 650px;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.85;
  }

  .guide-reference-card {
    min-width: 0;
    padding: clamp(22px, 3vw, 30px);
    border: 1px solid #E2D6C5;
    border-top: 3px solid #D99B26;
    background: #FFFDF9;
  }

  .guide-reference-kicker {
    margin: 0 0 12px;
    color: #7A4B16;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .guide-reference-card h2 {
    margin: 0 0 14px;
    color: #2A1508;
    font: 400 clamp(1.45rem, 2.2vw, 1.9rem)/1.2 var(--serif);
  }

  .guide-reference-address,
  .guide-reference-hours {
    margin: 0;
    color: #4A3525;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .guide-reference-hours {
    margin-top: 9px;
  }

  .guide-reference-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 22px;
    padding: 0 20px;
    background: #D99B26;
    color: #2A1508;
    font-size: 0.78rem;
    font-weight: 750;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .guide-reference-button:hover {
    background: #C88B1E;
    transform: translateY(-2px);
  }

  .guide-reference-button:focus-visible,
  .guide-breadcrumb a:focus-visible,
  .guide-card-tappable:focus-visible {
    outline: 3px solid #D99B26;
    outline-offset: 4px;
  }

  .guide-card-tappable {
    display: block;
    min-height: 238px;
    padding: 26px;
    border-right: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    color: inherit;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .guide-card-tappable h3 {
    margin: 14px 0 9px;
    color: var(--text-main);
  }

  .guide-card-tappable p {
    color: var(--text-muted);
  }

  .guide-card-tappable .guide-card-link {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    margin-top: 12px;
    padding-top: 0;
    color: #7A4B16;
  }

  .guide-card-tappable:hover {
    z-index: 1;
    border-color: #D99B26;
    background: #FFFDF9;
    transform: translateY(-3px);
  }

  @media (max-width: 760px) {
    .guide-hero-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .guide-breadcrumb {
      margin-bottom: 22px;
    }

    .guide-reference-card {
      max-width: 560px;
    }

    .guide-card-tappable {
      min-height: 0;
      padding: 22px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-reference-button,
    .guide-card-tappable {
      transition: none;
    }

    .guide-reference-button:hover,
    .guide-card-tappable:hover {
      transform: none;
    }
  }
</style>
