---
import SiteLayout from "../../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? new URL("https://startupintelligence.github.io");
const pageUrl = new URL(base + "blog/", siteOrigin).toString();
const guides = [
  { number: "01", eyebrow: "Tamil · English reference", title: "A simple guide to Tamil millet names", description: "Match familiar names such as Thinai, Varagu and Kuthiraivali with their English grain names and common kitchen uses.", href: base + "perambur-millet-store/#millet-reference", action: "Open the millet reference" },
  { number: "02", eyebrow: "Breakfast · Tiffin · Meals", title: "Millets in everyday South Indian cooking", description: "Explore meal ideas such as upma, pongal, dosa and other familiar ways grains and millet flours are used at home.", href: base + "products/#grains", action: "Explore rice & millets" },
  { number: "03", eyebrow: "Kitchen essentials · Chekku", title: "A guide to traditional cooking oils", description: "Get familiar with gingelly, groundnut and coconut oils, and the role of ghee in everyday kitchen routines.", href: base + "products/#oils", action: "Explore oils & ghee" },
  { number: "04", eyebrow: "Tea-time · Tiffin · Pantry", title: "Millet snacks and quick pantry ideas", description: "Browse millet flakes, sevai, pasta, cookies and other pantry categories as options to ask about for tea-time and tiffin.", href: base + "products/#pantry", action: "Explore snacks & pantry" }
];
const schema = { "@context": "https://schema.org", "@type": "CollectionPage", "name": "Kitchen Guides | Eshwar Home Products", "url": pageUrl, "description": "Practical Tamil kitchen references and pantry guides from Eshwar Home Products in Perambur, Chennai.", "mainEntity": { "@type": "ItemList", "itemListElement": guides.map((guide, index) => ({ "@type": "ListItem", "position": index + 1, "name": guide.title, "url": new URL(guide.href.replace(base, base), siteOrigin).toString() })) } };
---
<SiteLayout title="Kitchen Guides & Tamil Pantry Notes | Eshwar Home Products" description="Practical Tamil kitchen references, millet name guides and pantry-use notes from Eshwar Home Products in Perambur, Chennai." current="blog" canonicalUrl={pageUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="guide-hero"><div class="container">
    <p class="eyebrow">Kitchen notes · Eshwar Home Products · Perambur</p>
    <h1>Small guides for the<br /><em>everyday Tamil kitchen.</em></h1>
    <p>Helpful references for grains, pantry staples and familiar South Indian cooking. Start with a name, a meal or an ingredient, then explore the store's pantry guide.</p>
  </div></section>
  <section class="container guide-list">
    <div class="guide-list-heading"><div><p class="eyebrow">Browse the guide shelf</p><h2>Practical notes, close to home.</h2></div><a class="text-link" href={base + "products/"}>Browse the pantry ↗</a></div>
    <div class="guide-grid">
      {guides.map((guide) => <a class="guide-card" href={guide.href}><span class="eyebrow">{guide.number} · {guide.eyebrow}</span><h3>{guide.title}</h3><p>{guide.description}</p><span class="guide-card-link">{guide.action} ↗</span></a>)}
    </div>
    <p class="guide-note">These guides explain names and common kitchen uses. They are not medical advice or a live inventory. For current product details, varieties and pack sizes, contact the Perambur store directly.</p>
  </section>
</SiteLayout>
