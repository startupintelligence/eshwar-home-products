---
import SiteLayout from "../layouts/SiteLayout.astro";
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Page not found | Eshwar Home Products" description="The page you requested could not be found.">
  <section class="page-heading"><div class="container">
    <p class="eyebrow">404 · Page not found</p>
    <h1>This page<br /><em>isn’t on our shelves.</em></h1>
    <p>The address may have changed. Head back to the home page or browse the pantry.</p>
    <div class="hero-actions"><a class="button button-dark" href={base}>Back to home</a><a class="text-link" href={base + "products/"}>Browse the pantry ↗</a></div>
  </div></section>
</SiteLayout>
