---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FloatingActionCards from "../components/FloatingActionCards.astro";
import "../styles/global.css";
import "../styles/theme-2.css";
import "../styles/shared-editorial.css";
import "../styles/brand-system.css";
interface Props { title:string; description:string; current?:"home"|"about"|"products"|"contact"|"blog"|"kitchen-guides"; includeStoreSchema?:boolean; canonicalUrl?:string; noindex?:boolean; preloadHomeHero?:boolean; }
const { title, description, current="home", includeStoreSchema=true, canonicalUrl, noindex=false, preloadHomeHero=false } = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site ?? "https://startupintelligence.github.io").toString();
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site ?? "https://startupintelligence.github.io").toString();
const ogImage = new URL("images/og-eshwar-home-products.png", siteUrl).toString();
const storeSchema = { "@context":"https://schema.org", "@type":"GroceryStore", "@id":siteUrl+"#store", name:"Eshwar Home Products", alternateName:"ஈஸ்வர் ஹோம் புராடக்ட்ஸ்", url:siteUrl, logo:new URL("images/brand/eshwar-home-products-logo.png", siteUrl).toString(), telephone:"+91 99412 09953", address:{ "@type":"PostalAddress", streetAddress:"119/1, Paddy Field Road, Chinnaiyan Colony, Perambur", addressLocality:"Chennai", addressRegion:"Tamil Nadu", postalCode:"600011", addressCountry:"IN" }, openingHours:["Mo-Sa 09:00-21:00"], description:"Mon–Sat: 9:00 AM – 9:00 PM · Sunday: Closed", areaServed:"Perambur, Chennai", sameAs:["https://www.youtube.com/@EHP_PeramburOfficial","https://www.instagram.com/eshwar_home_products/"] };
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#183828" />
<meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" /><meta property="og:site_name" content="Eshwar Home Products" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:locale" content="en_IN" /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:secure_url" content={ogImage} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Eshwar Home Products, Perambur, Chennai" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/png" href={new URL("images/brand/eshwar-home-products-logo.png", siteUrl).toString()} /><link rel="apple-touch-icon" href={new URL("images/brand/eshwar-home-products-logo.png", siteUrl).toString()} /><link rel="canonical" href={canonical} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Noto+Sans+Tamil:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
{preloadHomeHero && <link rel="preload" as="image" href={new URL("images/business/EHP_Shop_Front_View-1280.webp", siteUrl).toString()} imagesrcset={`${new URL("images/business/EHP_Shop_Front_View-480.webp", siteUrl).toString()} 480w, ${new URL("images/business/EHP_Shop_Front_View-768.webp", siteUrl).toString()} 768w, ${new URL("images/business/EHP_Shop_Front_View-1280.webp", siteUrl).toString()} 1280w`} imagesizes="(max-width: 900px) 100vw, 50vw" fetchpriority="high" />}<title>{title}</title>
<script src="https://analytics.ahrefs.com/analytics.js" data-key="T8+LOj2/EakoZK7/pjg3rg" async></script>
{import.meta.env.PUBLIC_GA4_ID && <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />}
{includeStoreSchema && <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />}
</head>
<body><a class="skip-link" href="#main-content">Skip to content</a><SiteHeader current={current} /><main id="main-content"><slot /></main><SiteFooter /><FloatingActionCards />
<a
  class="whatsapp-fab"
  href="https://wa.me/919941209953?text=Hello%20Eshwar%20Home%20Products%2C%20I%20would%20like%20to%20enquire%20about%20products."
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp with Eshwar Home Products"
  title="Chat on WhatsApp"
>
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.08c-.24.68-1.42 1.3-1.97 1.38-.52.08-1.18.11-1.91-.12-.44-.14-1.01-.33-1.73-.64-3.05-1.32-5.04-4.38-5.19-4.58-.15-.2-1.24-1.65-1.24-3.15s.78-2.24 1.06-2.55c.28-.3.61-.38.81-.38.2 0 .4 0 .58.01.19.01.44-.07.69.53.26.62.88 2.14.96 2.3.08.16.13.35.03.55-.1.2-.15.33-.3.5-.15.17-.32.39-.45.52-.15.15-.31.31-.13.62.18.3.79 1.31 1.7 2.12 1.17 1.04 2.16 1.36 2.46 1.52.3.15.48.13.66-.08.18-.2.76-.88.96-1.19.2-.3.4-.25.68-.15.28.1 1.77.83 2.08.99.3.15.51.23.58.36.08.13.08.76-.16 1.44Z" />
  </svg>
</a>
<nav class="mobile-action-bar" aria-label="Quick store actions">
  <a class="mobile-action-call" href="tel:+919941209953">Call Store</a>
  <button class="mobile-action-whatsapp" type="button" data-ehp-dialog="enquiry" aria-haspopup="dialog">WhatsApp Enquiry ↗</button>
</nav>
<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lowMemoryDevice = 'deviceMemory' in navigator && navigator.deviceMemory <= 4;
    if (reduceMotion || lowMemoryDevice || !('IntersectionObserver' in window)) return;
    const items = document.querySelectorAll('.reveal-item');
    if (!items.length) return;
    document.documentElement.classList.add('has-reveal');
    const observer = new IntersectionObserver((entries, activeObserver) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          activeObserver.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -36px 0px', threshold: 0.08 });
    items.forEach((item) => observer.observe(item));
  })();
  (() => {
    const whatsappFab = document.querySelector('.whatsapp-fab');
    const siteFooter = document.querySelector('.site-footer');
    if (!whatsappFab || !siteFooter || !('IntersectionObserver' in window)) return;
    const footerObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry) return;
      const hideFab = entry.isIntersecting;
      whatsappFab.classList.toggle('is-footer-visible', hideFab);
      whatsappFab.setAttribute('aria-hidden', String(hideFab));
      if (hideFab) {
        whatsappFab.setAttribute('tabindex', '-1');
      } else {
        whatsappFab.removeAttribute('tabindex');
      }
    }, { threshold: 0.05 });
    footerObserver.observe(siteFooter);
  })();
</script>
<script>
  const emailAddress = [105,110,102,111,46,101,115,104,119,97,114,104,111,109,101,112,114,111,100,117,99,116,115,64,103,109,97,105,108,46,99,111,109].map((code) => String.fromCharCode(code)).join('');
  document.querySelectorAll('[data-email-contact]').forEach((node) => {
    node.setAttribute('href', `mailto:${emailAddress}`);
    node.textContent = emailAddress;
  });
  const measurementId = import.meta.env.PUBLIC_GA4_ID?.trim();
  if (measurementId) {
    const analyticsWindow = window as Window & { dataLayer?: IArguments[]; gtag?: (...args: unknown[]) => void };
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.gtag = function () { analyticsWindow.dataLayer?.push(arguments); };
    analyticsWindow.gtag("js", new Date());
    analyticsWindow.gtag("config", measurementId, { anonymize_ip: true });
    const analyticsScript = document.createElement("script");
    analyticsScript.async = true;
    analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    document.head.appendChild(analyticsScript);
  }
</script>
</body>
</html>
