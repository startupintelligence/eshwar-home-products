---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FloatingActionCards from "../components/FloatingActionCards.astro";
import "../styles/global.css";
import "../styles/theme-2.css";
import "../styles/shared-editorial.css";
import "../styles/brand-system.css";
interface Props { title:string; description:string; current?:"home"|"about"|"products"|"contact"|"blog"|"kitchen-guides"; includeStoreSchema?:boolean; canonicalUrl?:string; noindex?:boolean; preloadHomeHero?:boolean; }
const { title, description, current="home", includeStoreSchema=true, canonicalUrl, noindex=false, preloadHomeHero=false } = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site ?? "https://startupintelligence.github.io").toString();
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site ?? "https://startupintelligence.github.io").toString();
const ogImage = new URL("images/og-eshwar-home-products.png", siteUrl).toString();
const entityId = siteUrl + "#organization";
const storeId = siteUrl + "#store";
const addressId = siteUrl + "#address";
const logoUrl = new URL("images/brand/eshwar-home-products-logo.png", siteUrl).toString();
const mapsUrl = "https://www.google.com/maps/place/Eshwar+Home+Products/@13.1118547,80.2468127,17z/data=!3m1!4b1!4m6!3m5!1s0x3a526569af8122ad:0xe485caf4b8adf074!8m2!3d13.1118495!4d80.2493876!16s%2Fg%2F11v4j6lc03?entry=ttu";
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization", "@id": entityId,
      name: "Eshwar Home Products", alternateName: "ஈஸ்வர் ஹோம் புராடக்ட்ஸ்",
      url: siteUrl, logo: { "@type": "ImageObject", url: logoUrl },
      description: "A neighbourhood food and pantry store in Perambur, Chennai, Tamil Nadu, India.",
      telephone: "+91 99412 09953", email: "info.eshwarhomeproducts@gmail.com",
      sameAs: ["https://www.youtube.com/@EHP_PeramburOfficial", "https://www.instagram.com/eshwar_home_products/"],
      subOrganization: { "@id": storeId }
    },
    {
      "@type": "WebSite", "@id": siteUrl + "#website",
      url: siteUrl, name: "Eshwar Home Products", inLanguage: "en-IN",
      publisher: { "@id": entityId }, about: { "@id": storeId }
    },
    {
      "@type": ["GroceryStore", "LocalBusiness"], "@id": storeId,
      name: "Eshwar Home Products", alternateName: "ஈஸ்வர் ஹோம் புராடக்ட்ஸ்",
      url: siteUrl, mainEntityOfPage: { "@id": siteUrl + "#website" },
      parentOrganization: { "@id": entityId },
      logo: logoUrl, image: logoUrl, telephone: "+91 99412 09953",
      email: "info.eshwarhomeproducts@gmail.com",
      address: { "@id": addressId },
      openingHours: ["Mo-Sa 09:00-21:00"],
      openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], opens: "09:00", closes: "21:00" }],
      areaServed: { "@type": "City", name: "Chennai" },
      hasMap: mapsUrl,
      geo: { "@type": "GeoCoordinates", latitude: 13.1118495, longitude: 80.2493876 },
      sameAs: [mapsUrl, "https://www.youtube.com/@EHP_PeramburOfficial", "https://www.instagram.com/eshwar_home_products/"],
      knowsAbout: ["Traditional rice varieties", "Millets and millet flours", "Cold-pressed gingelly, groundnut and coconut oils", "Ghee and dairy essentials", "Honey, pulses, dry fruits and nuts", "Sathumaavu", "Millet snacks and pantry essentials"],
      hasOfferCatalog: { "@id": siteUrl + "#pantry-catalog" }
    },
    {
      "@type": "PostalAddress", "@id": addressId,
      streetAddress: "119/1, Paddy Field Road, Chinnaiyan Colony, Perambur",
      addressLocality: "Chennai", addressRegion: "Tamil Nadu",
      postalCode: "600011", addressCountry: "IN"
    },
    {
      "@type": "OfferCatalog", "@id": siteUrl + "#pantry-catalog",
      name: "Eshwar Home Products pantry categories",
      itemListElement: [
        { "@type": "OfferCatalog", name: "Rice & millets", description: "Traditional rice varieties, millet grains and millet flours." },
        { "@type": "OfferCatalog", name: "Oils, ghee & dairy", description: "Cold-pressed gingelly, groundnut and coconut oils, ghee and dairy essentials." },
        { "@type": "OfferCatalog", name: "Pantry essentials", description: "Honey, pulses, dry fruits, nuts, Sathumaavu, millet snacks and other pantry selections." }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#432818" />
<meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" /><meta property="og:site_name" content="Eshwar Home Products" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:locale" content="en_IN" /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:secure_url" content={ogImage} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Eshwar Home Products, Perambur, Chennai" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/png" href={new URL("images/brand/eshwar-home-products-logo.png", siteUrl).toString()} /><link rel="apple-touch-icon" href={new URL("images/brand/eshwar-home-products-logo.png", siteUrl).toString()} /><link rel="canonical" href={canonical} />{preloadHomeHero && <link rel="preload" as="image" href={new URL("images/business/EHP_Shop_Front_View-1280.webp", siteUrl).toString()} imagesrcset={`${new URL("images/business/EHP_Shop_Front_View-480.webp", siteUrl).toString()} 480w, ${new URL("images/business/EHP_Shop_Front_View-768.webp", siteUrl).toString()} 768w, ${new URL("images/business/EHP_Shop_Front_View-1280.webp", siteUrl).toString()} 1280w`} imagesizes="(max-width: 900px) 100vw, 50vw" fetchpriority="high" />}<title>{title}</title>
<script src="https://analytics.ahrefs.com/analytics.js" data-key="T8+LOj2/EakoZK7/pjg3rg" async></script>
{import.meta.env.PUBLIC_GA4_ID && <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />}
{includeStoreSchema && <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />}
</head>
<body><div class="reading-progress" aria-hidden="true"></div><a class="skip-link" href="#main-content">Skip to content</a><SiteHeader current={current} /><main id="main-content"><slot /></main><SiteFooter /><FloatingActionCards />
<nav class="mobile-action-bar" aria-label="Quick store actions">
  <a class="mobile-action-call" href="tel:+919941209953">Call Store</a>
  <button class="mobile-action-whatsapp" type="button" data-ehp-dialog="enquiry" aria-haspopup="dialog">WhatsApp Enquiry ↗</button>
</nav>
<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lowMemoryDevice = 'deviceMemory' in navigator && navigator.deviceMemory <= 4;
    if (reduceMotion || lowMemoryDevice || !('IntersectionObserver' in window)) return;
    const items = document.querySelectorAll('.reveal-item');
    if (!items.length) return;
    document.documentElement.classList.add('has-reveal');
    const observer = new IntersectionObserver((entries, activeObserver) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          activeObserver.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -36px 0px', threshold: 0.08 });
    items.forEach((item) => observer.observe(item));
  })();
</script>
<script>
  const emailAddress = [105,110,102,111,46,101,115,104,119,97,114,104,111,109,101,112,114,111,100,117,99,116,115,64,103,109,97,105,108,46,99,111,109].map((code) => String.fromCharCode(code)).join('');
  document.querySelectorAll('[data-email-contact]').forEach((node) => {
    node.setAttribute('href', `mailto:${emailAddress}`);
    node.textContent = emailAddress;
  });
  const measurementId = import.meta.env.PUBLIC_GA4_ID?.trim();
  if (measurementId) {
    const analyticsWindow = window as Window & { dataLayer?: IArguments[]; gtag?: (...args: unknown[]) => void };
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.gtag = function () { analyticsWindow.dataLayer?.push(arguments); };
    analyticsWindow.gtag("js", new Date());
    analyticsWindow.gtag("config", measurementId, { anonymize_ip: true });
    const analyticsScript = document.createElement("script");
    analyticsScript.async = true;
    analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    document.head.appendChild(analyticsScript);
  }
</script>
</body>
</html>
