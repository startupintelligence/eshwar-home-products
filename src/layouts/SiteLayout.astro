---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FloatingActionCards from "../components/FloatingActionCards.astro";
import FloatingContactButton from "../components/FloatingContactButton.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { storeConfig } from "../data/store";
import "../styles/brand-system.css";
import "../styles/mobile-responsive.css";
import "../styles/legal-pages.css";
import plusJakartaPreloadHref from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  current?: "home" | "about" | "products" | "contact" | "blog" | "kitchen-guides";
  includeStoreSchema?: boolean;
  canonicalUrl?: string;
  noindex?: boolean;
  preloadHomeHero?: boolean;
}

const {
  title,
  description,
  current = "home",
  includeStoreSchema = true,
  canonicalUrl,
  noindex = false,
  preloadHomeHero = false,
} = Astro.props;

const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site ?? "https://startupintelligence.github.io").toString();
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site ?? "https://startupintelligence.github.io").toString();
const ogImage = new URL("images/og-eshwar-home-products.png", siteUrl).toString();
const favicon32 = new URL("favicon/favicon-32.png", siteUrl).toString();
const appleTouchIcon = new URL("icons/apple-touch-icon-180.png", siteUrl).toString();
const schemaLogo = new URL("icons/icon-512.png", siteUrl).toString();
const googleFontsHref = "https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;1,400&family=Noto+Sans+Tamil:wght@500;600;700&display=swap";

const sameAs = [
  storeConfig.socials.youtube.url,
  storeConfig.socials.instagram.url,
  ...(storeConfig.socials.facebook.url ? [storeConfig.socials.facebook.url] : []),
];

const storeSchema = {
  "@context": "https://schema.org",
  "@type": "GroceryStore",
  "@id": siteUrl + "#store",
  name: storeConfig.name,
  alternateName: storeConfig.tamilName,
  url: siteUrl,
  logo: schemaLogo,
  telephone: storeConfig.phoneDisplay,
  address: {
    "@type": "PostalAddress",
    streetAddress: "119/1, Paddy Field Road, Chinnaiyan Colony, Perambur",
    addressLocality: "Chennai",
    addressRegion: "Tamil Nadu",
    postalCode: "600011",
    addressCountry: "IN",
  },
  openingHours: ["Mo-Sa 09:00-21:00"],
  description: storeConfig.hours,
  areaServed: "Perambur, Chennai",
  sameAs,
};
---
<!doctype html>
<html lang="en-IN">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#183828" />
<meta name="description" content={description} />{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" /><meta property="og:site_name" content={storeConfig.name} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:locale" content="en_IN" /><meta property="og:url" content={canonical} /><meta property="og:image" content={ogImage} /><meta property="og:image:secure_url" content={ogImage} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Eshwar Home Products, Perambur, Chennai" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
<link rel="icon" type="image/png" sizes="32x32" href={favicon32} /><link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} /><link rel="canonical" href={canonical} />
<link rel="preload" as="font" type="font/woff2" href={plusJakartaPreloadHref} crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={googleFontsHref} media="print" onload="this.removeAttribute('media')" />
<noscript><link rel="stylesheet" href={googleFontsHref} /></noscript>
{preloadHomeHero && (
  <link
    rel="preload"
    as="image"
    media="(min-width: 861px)"
    href={new URL("images/business/EHP_Shop_Front_View-1280.webp", siteUrl).toString()}
    imagesrcset={`${new URL("images/business/EHP_Shop_Front_View-480.webp", siteUrl).toString()} 480w, ${new URL("images/business/EHP_Shop_Front_View-768.webp", siteUrl).toString()} 768w, ${new URL("images/business/EHP_Shop_Front_View-1280.webp", siteUrl).toString()} 1280w`}
    imagesizes="(max-width: 1200px) 48vw, 576px"
  />
)}
<title>{title}</title>
{includeStoreSchema && <script type="application/ld+json" set:html={JSON.stringify(storeSchema)} />}
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<SiteHeader current={current} />
<main id="main-content"><slot /></main>
<SiteFooter />
<CookieConsent />
<FloatingActionCards />
<FloatingContactButton />
<nav class="mobile-action-bar" aria-label="Quick store actions">
  <a class="mobile-action-directions" href={storeConfig.mapsUrl} target="_blank" rel="noopener noreferrer">Store Directions ↗</a>
  <button class="mobile-action-whatsapp" type="button" data-ehp-dialog="enquiry" aria-haspopup="dialog">WhatsApp ↗</button>
</nav>
<script is:inline>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lowMemoryDevice = 'deviceMemory' in navigator && navigator.deviceMemory <= 4;
    if (reduceMotion || lowMemoryDevice || !('IntersectionObserver' in window)) return;
    const items = document.querySelectorAll('.reveal-item');
    if (!items.length) return;
    document.documentElement.classList.add('has-reveal');
    const observer = new IntersectionObserver((entries, activeObserver) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          activeObserver.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -36px 0px', threshold: 0.08 });
    items.forEach((item) => observer.observe(item));
  })();
</script>
<script>
  const emailAddress = [105,110,102,111,46,101,115,104,119,97,114,104,111,109,101,112,114,111,100,117,99,116,115,64,103,109,97,105,108,46,99,111,109].map((code) => String.fromCharCode(code)).join('');
  document.querySelectorAll('[data-email-contact]').forEach((node) => {
    node.setAttribute('href', `mailto:${emailAddress}`);
    node.textContent = emailAddress;
  });
  const measurementId = import.meta.env.PUBLIC_GA4_ID?.trim();
  let analyticsLoaded = false;
  const loadAnalyticsIfAllowed = () => {
    if (!measurementId || analyticsLoaded) return;
    let consent = null;
    try { consent = JSON.parse(window.localStorage.getItem('ehp-consent-v1') || 'null'); } catch { return; }
    if (consent?.analytics !== true) return;
    analyticsLoaded = true;
    const analyticsWindow = window as Window & { dataLayer?: IArguments[]; gtag?: (...args: unknown[]) => void };
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
    analyticsWindow.gtag = function () { analyticsWindow.dataLayer?.push(arguments); };
    analyticsWindow.gtag('js', new Date());
    analyticsWindow.gtag('config', measurementId, { anonymize_ip: true });
    const analyticsScript = document.createElement('script');
    analyticsScript.async = true;
    analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
    document.head.appendChild(analyticsScript);
  };
  loadAnalyticsIfAllowed();
  window.addEventListener('ehp:consent-updated', loadAnalyticsIfAllowed);
</script>
</body>
</html>
